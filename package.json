{
  "name": "ihateaudio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/sync-ffmpeg-core.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-ffmpeg-core.mjs",
    "build": "node scripts/check-registry.mjs && astro check && tsc -p worker && astro build && node scripts/check-csp.mjs",
    "build:fast": "node scripts/check-registry.mjs && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "astro check",
    "seo": "node scripts/seo-audit.mjs",
    "icons": "node scripts/generate-tool-icons.mjs && node scripts/normalize-tool-icons.mjs",
    "appicons": "node scripts/generate-app-icons.mjs",
    "shots": "node scripts/generate-pwa-screenshots.mjs",
    "verify": "node scripts/verify-tools.mjs",
    "check:worker": "tsc -p worker",
    "assets": "node scripts/generate-app-icons.mjs && astro build && node scripts/generate-og-images.mjs",
    "deploy": "npm run build && wrangler deploy",
    "dev:worker": "npm run build && wrangler dev",
    "csp": "node scripts/check-csp.mjs",
    "ffmpeg:upload": "node scripts/upload-ffmpeg-core.mjs",
    "registry": "node scripts/check-registry.mjs",
    "verify:ai": "node scripts/verify-ai.mjs",
    "models:upload": "node scripts/upload-models.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^4.2.0",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "astro": "^7.1.3",
    "onnxruntime-web": "^1.27.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@ffmpeg/core": "^0.12.10",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
