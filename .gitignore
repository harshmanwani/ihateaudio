node_modules/
dist/
.astro/
.DS_Store
*.log

# Regenerated from node_modules by scripts/sync-ffmpeg-core.mjs (31 MB), now
# under a version subdirectory. Served from R2 in production, see worker/.
public/ffmpeg/

# Regenerated from node_modules by scripts/sync-onnx-runtime.mjs (13 MB). Unlike
# the ffmpeg core this is under Cloudflare's 25 MiB asset cap, so it ships with
# the site rather than from R2.
public/ort/

# Playwright
test-results/
playwright-report/

# Generated from src/assets/logo.svg by scripts/generate-app-icons.mjs at build.
public/splash/

# Local overrides only. .env.production is committed on purpose: the ids in it
# are public, and a build has to be reproducible from a clean clone.
.env
.env.local
.env.*.local

# Local copies of the AI models for dev and verification. Served from R2 in
# production, see worker/ and scripts/upload-models.mjs.
public/models/

# Verification fixtures for the AI tools: a controlled mix of a known
# instrumental plus known speech, so separation quality can be measured rather
# than eyeballed. Regenerate with scripts/make-ai-fixtures.sh if lost.
tests/fixtures/
