---
import ToolPage from '../layouts/ToolPage.astro';
import ToolShell from '../components/ToolShell.astro';
import { getTool } from '../data/tools';

const tool = getTool('noise-remover');

const steps = [
  'Drop the recording in. There is no model to download for this one — the network is small enough to ship with the site, so it starts working straight away.',
  'Press Clean. The whole file is processed faster than real time, so even a long interview is done in seconds rather than minutes.',
  'Compare before and after with the amount slider. Full strength is not always best: on a recording where the room is part of the atmosphere, leaving a little of the original in sounds more natural.',
  'Download when it sounds right. If this is going on to a transcriber, run it through cleaned — speech recognition is noticeably more accurate once the hiss is gone.',
];

const faq = [
  {
    q: 'What kind of noise does this remove?',
    a: 'Steady background noise: air conditioning, computer fans, traffic hum through a window, tape hiss, the general roar of a room. It is very good at anything continuous and unchanging. It is much less good at sudden noises — a door slamming, a cough, a chair scraping — because those look like part of the speech to a model trained to separate voice from steady background.',
  },
  {
    q: 'Why is there nothing to download here when the other AI tools need 40 or 64 MB?',
    a: 'Because this network is tiny. RNNoise is about 150 KB, which is smaller than most photographs, and it ships with the site like any other asset. It manages that by being narrow: it does one job, on speech, at one sample rate, and it was designed in an era when running a neural network on a phone meant making it small enough to fit. The separation models are large because they are doing something far harder.',
  },
  {
    q: 'It made the voice sound thin or underwater.',
    a: 'Turn the amount down. The model decides, band by band and moment by moment, how much of what it hears is voice, and where it is uncertain it attenuates. On a recording where the noise and the voice overlap heavily it removes some of the voice with the noise, and the result is that hollow, processed quality. Mixing back 20 or 30 per cent of the original usually restores the body without bringing the noise back.',
  },
  {
    q: 'Can it remove music from behind speech?',
    a: 'Not well — that is a different problem. This is trained to tell voice from steady noise, and music is neither steady nor noise. If there is music under the dialogue, the vocal remover does a far better job, because separating a voice from an arrangement is exactly what it was built for.',
  },
  {
    q: 'Does it work on singing?',
    a: 'Less well than on speech. RNNoise was trained on speech, so it has learned what a talking voice looks like, and sustained sung notes sometimes get treated as tonal noise and attenuated. For music, use the separation tools instead.',
  },
  {
    q: 'Why does the file come back at a different quality?',
    a: 'It should not, but there is a small unavoidable round trip: the network runs at 48 kHz, so a 44.1 kHz recording is resampled up, processed, and resampled back. Both conversions use the browser’s own resampler with a proper filter, so the loss is far below anything audible, but it is not literally bit-identical in the passages where nothing was removed.',
  },
];
---

<ToolPage slug={tool.slug} steps={steps} faq={faq}>
  <ToolShell tool={tool} action="Download cleaned audio">
    <div class="controls">
      <div class="controls__head">
        <span class="controls__title">Cleanup</span>
        <span class="hint">
          A neural denoiser, running on your machine. Nothing to download first.
        </span>
      </div>

      <div class="field">
        <label class="label" for="nr-amount">
          Strength
          <span class="label__value" data-out="amount">100%</span>
        </label>
        <div class="slider-row">
          <input
            class="slider"
            id="nr-amount"
            data-control="amount"
            type="range"
            min="0"
            max="100"
            step="5"
            value="100"
          />
          <input
            class="num"
            data-control="amount-num"
            type="number"
            min="0"
            max="100"
            step="5"
            value="100"
            aria-label="Cleanup strength as a percentage"
          />
        </div>
        <p class="hint">
          Full strength removes the most noise. Backing off blends the original
          back in, which sounds more natural when the room is part of the recording.
        </p>
      </div>

      <div class="note note--info controls__full" data-report hidden>
        <div class="note__body" data-report-text></div>
      </div>
    </div>
  </ToolShell>

  <Fragment slot="about">
    <h2>How a 150 KB network does this</h2>
    <p>
      Most noise reduction works by subtraction: measure the noise during a silent
      passage, then subtract that profile from the whole recording. It works, and
      its failure mode is famous — the musical-noise artefact, a shimmering of
      little tones where the subtraction left uneven residue behind.
    </p>
    <p>
      RNNoise does something different. It splits the signal into a couple of dozen
      frequency bands and, for every 10-millisecond frame, asks a small recurrent
      network how much of each band is voice. The answer is a gain per band, and the
      gains are applied smoothly. Because the network carries state from one frame to
      the next, it knows whether it is in the middle of a word or in a gap, which is
      the information a static noise profile does not have.
    </p>
    <p>
      It is small because it only ever had to output those couple of dozen gains
      rather than reconstruct a waveform, and because it was built to run on modest
      hardware in real time. That constraint is why it can ship inside a web page
      instead of behind a download.
    </p>

    <h2>Where it helps most</h2>
    <p>
      Interviews and voice notes recorded in ordinary rooms are the best case. So is
      anything you intend to transcribe: speech recognition degrades quickly with
      background noise, and cleaning first measurably improves the transcript.
    </p>
    <p>
      It also pairs well with the silence remover. Cleaning first and then removing
      silence gives a better result than the other way round, because the silence
      detector is looking for passages below a level threshold, and it is far easier
      to pick those out once the noise floor has come down.
    </p>

    <h2>When to leave it alone</h2>
    <p>
      Anything where the background is content. Ambience recorded deliberately, a
      live room you wanted the sound of, a field recording — this will strip exactly
      the thing you went there for.
    </p>
    <p>
      Music, as above: it was trained on speech and will treat sustained notes with
      suspicion. And anything you may need as evidence, where the recording should
      stay as it was captured rather than as it sounded best.
    </p>
  </Fragment>
</ToolPage>

<script>
  import { createTool } from '../lib/tool';
  import { denoise, reductionDb } from '../lib/ai/denoise';

  const tool = createTool({
    suffix: 'cleaned',
    defaultFormat: 'wav',

    onReady(_ctx, runtime) {
      const root = runtime.root;
      const slider = root.querySelector<HTMLInputElement>('[data-control="amount"]');
      const num = root.querySelector<HTMLInputElement>('[data-control="amount-num"]');
      const out = root.querySelector<HTMLElement>('[data-out="amount"]');

      const paint = (): void => {
        if (!slider) return;
        const min = Number(slider.min);
        const max = Number(slider.max);
        const span = max - min || 1;
        slider.style.setProperty('--pct', `${((Number(slider.value) - min) / span) * 100}%`);
        if (out) out.textContent = `${slider.value}%`;
      };

      slider?.addEventListener('input', () => {
        if (num) num.value = slider.value;
        paint();
      });
      num?.addEventListener('input', () => {
        if (slider) slider.value = num.value;
        paint();
      });

      paint();
    },

    async process(ctx) {
      const runtime = tool;
      const amount = (runtime?.value('amount', 100) ?? 100) / 100;

      const cleaned = await denoise(ctx.buffer, {
        amount,
        signal: ctx.signal,
        onProgress: (ratio) => ctx.progress(ratio),
      });

      // A number is more use than a tick: it says whether anything was actually
      // there to remove, which is the question people have when a recording still
      // sounds noisy afterwards.
      const removed = reductionDb(ctx.buffer, cleaned);
      const report = runtime?.root.querySelector<HTMLElement>('[data-report]');
      const text = runtime?.root.querySelector<HTMLElement>('[data-report-text]');
      if (text) {
        text.textContent =
          removed < 0.3
            ? 'Almost nothing was removed, which usually means the recording was already ' +
              'clean — or that the noise is not the steady kind this handles.'
            : `The result is about ${removed.toFixed(1)} dB quieter overall, which is the ` +
              'noise that came out. Listen before downloading: if the voice sounds thin, ' +
              'lower the strength.';
      }
      if (report) report.hidden = false;

      return cleaned;
    },
  });
</script>
