{
  // The Worker gets its own type environment on purpose.
  //
  // @cloudflare/workers-types redefines Request, Response, Headers and friends
  // for the Workers runtime. Pulling those into the root tsconfig would apply
  // them to all the client code too, where the DOM versions are the correct
  // ones, and the two disagree in ways that produce dozens of false errors.
  //
  // Checked by `npm run check:worker`, and by wrangler on deploy.
  "extends": "../tsconfig.json",
  "include": ["./**/*.ts"],
  // The root config excludes this directory, and extends inherits that, which
  // would leave no inputs at all.
  "exclude": [],
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "noEmit": true
  }
}
