---
/**
 * The DOM skeleton every tool renders. Element hooks are data attributes that
 * the shared runtime in src/lib/tool.ts binds to, which is why a new tool is a
 * config plus a <slot>, not a new interface.
 */
import Icon from './Icon.astro';
import StemPanel from './StemPanel.astro';
import { PRIVACY_LINE } from '../consts';
import { relatedTools, type Tool } from '../data/tools';

interface Props {
  tool: Tool;
  /** Show draggable selection handles over the waveform. */
  selection?: boolean;
  /** Render the draggable cut-marker layer over the waveform. */
  markers?: boolean;
  /** Hide the waveform for tools that only report numbers. */
  stage?: boolean;
  /** Show the format/quality export bar. */
  exportBar?: boolean;
  /** Label on the primary action. */
  action?: string;
  /** Copy in the empty dropzone. */
  dropTitle?: string;
  dropHint?: string;
  multiple?: boolean;
  video?: boolean;
  /** Renders a container for multi-file output (splitters). */
  results?: boolean;
}

const {
  tool,
  selection = false,
  markers = false,
  stage = true,
  exportBar = true,
  action = 'Download',
  dropTitle,
  dropHint,
  multiple = false,
  video = false,
  results = false,
} = Astro.props;

const chain = relatedTools(tool.slug).slice(0, 3);

const defaultDropTitle = multiple
  ? 'Drop your audio files here'
  : video
    ? 'Drop a video or audio file here'
    : 'Drop an audio file here';

const formats = video
  ? 'MP4 · MOV · MKV · WEBM · MP3 · WAV and more'
  : 'MP3 · WAV · M4A · AAC · OGG · FLAC and more';
---

<!-- data-cat on the root, so every control inside can reach the family hue. -->
<div class="tool" data-tool data-slug={tool.slug} data-cat={tool.category}>
  <!--
    Empty state: the stage itself, waiting.

    The drop target is the same dark window the waveform will draw into — a
    centerline marks where the audio will appear, and the strip along the
    bottom sits exactly where the transport will be. Dropping a file fills the
    window it lands on; nothing about the page rearranges.
  -->
  <div
    class="drop"
    data-drop
    data-armed="false"
    role="button"
    tabindex="0"
    aria-label={defaultDropTitle}
  >
    <div class="drop__body">
      <span class="drop__line" aria-hidden="true"></span>
      <div class="drop__center">
        <div class="drop__title">{dropTitle ?? defaultDropTitle}</div>
        <p class="drop__hint">
          {dropHint ?? 'or paste one from your clipboard'}
        </p>
        <button type="button" class="drop__btn" data-browse>
          Choose file{multiple ? 's' : ''}
        </button>
      </div>
      <span class="drop__line" aria-hidden="true"></span>
    </div>
    <div class="drop__meta">
      <span class="drop__formats">{formats}</span>
      <span class="drop__privacy">
        <Icon name="shield-check" size={14} />
        {PRIVACY_LINE}
      </span>
    </div>
    <input type="file" data-file-input tabindex="-1" aria-hidden="true" />
  </div>

  <!-- Status: progress and notices render here, next to the file they concern. -->
  <div data-status aria-live="polite"></div>

  {/*
    Failures do not render here, they come to the user.

    Same reasoning as the install card: a corner card, not a band in the flow.
    The status region sits directly under the dropzone, and by the time anything
    can fail there is a waveform, a control panel and an export bar between it
    and the button that was actually pressed — so the message landed thousands of
    pixels above the only person who needed to read it. Fixed also means the tool
    does not jump downwards at the exact moment something went wrong.
  */}
  <div class="alert" data-alert role="alert" hidden>
    <span class="alert__mark" aria-hidden="true">
      <Icon name="warning-circle" weight="fill" size={20} />
    </span>
    <div class="alert__body">
      <p class="alert__title" data-alert-title></p>
      <p class="alert__fix" data-alert-fix></p>
    </div>
    <button type="button" class="alert__close" data-alert-close aria-label="Dismiss">
      <Icon name="x" size={15} />
    </button>
  </div>

  <div class="tool" data-workspace hidden>
    <div class="filebar">
      <Icon name="file-audio" size={22} class="filebar__icon" />
      <div class="filebar__text">
        <div class="filebar__name" data-filename></div>
        <div class="filebar__meta" data-filemeta></div>
      </div>
      {
        /*
          Multi-file tools need a way back to the file picker.

          The drop zone is hidden once the workspace opens, so on a joiner the
          only route to a fourth track was to clear everything and re-pick all
          four. This adds to what is loaded rather than replacing it, which is
          why it is a separate control from Clear rather than a second use of
          the same one.
        */
        multiple && (
          <button type="button" class="btn btn--ghost btn--sm" data-add-files>
            <Icon name="plus" size={16} />
            <span aria-hidden="true">Add files</span>
            <span class="visually-hidden">Add more files to the ones already loaded</span>
          </button>
        )
      }
      <button type="button" class="btn btn--ghost btn--sm" data-reset>
        <Icon name="x" size={16} />
        <span class="visually-hidden">Remove file and start over</span>
        <span aria-hidden="true">Clear</span>
      </button>
      <input
        type="file"
        data-add-input
        tabindex="-1"
        aria-hidden="true"
        hidden
        multiple={multiple}
      />
    </div>

    {
      stage && (
        <div class="stage" data-stage>
          {/*
            The ruler is also the pan handle. Dragging the waveform itself is
            already spoken for by selection and marker gestures, so the scale
            strip is where "move along the file" lives — the same division a
            DAW makes, and it means no gesture has two meanings.
          */}
          <div
            class="stage__ruler"
            data-ruler-track
            role="button"
            tabindex="-1"
            aria-hidden="true"
          >
            <canvas data-ruler />
          </div>

          <div class="stage__canvas-wrap" data-canvas-wrap>
            <canvas data-canvas aria-label="Audio waveform" role="img" />

            {selection && (
              <>
                <div class="stage__mask" data-mask="left" />
                <div class="stage__mask" data-mask="right" />
                <div
                  class="stage__handle"
                  data-handle="start"
                  role="slider"
                  tabindex="0"
                  aria-label="Selection start"
                  aria-valuemin="0"
                  aria-valuenow="0"
                  hidden
                >
                  <span class="stage__handle-tip" data-tip>0:00.00</span>
                </div>
                <div
                  class="stage__handle"
                  data-handle="end"
                  role="slider"
                  tabindex="0"
                  aria-label="Selection end"
                  aria-valuemin="0"
                  aria-valuenow="0"
                  hidden
                >
                  <span class="stage__handle-tip" data-tip>0:00.00</span>
                </div>
              </>
            )}

            {markers && (
              <div
                class="stage__markers"
                data-markers
                aria-label="Cut points"
                role="group"
              />
            )}

            <div class="stage__playhead" data-playhead />
          </div>

          {/*
            The overview only appears once you are zoomed in, because at 1x it
            would be a second copy of the waveform directly under the first.
          */}
          <div class="stage__map" data-map hidden>
            <canvas data-minimap aria-hidden="true" />
          </div>

          <div class="transport">
            <button
              type="button"
              class="transport__btn"
              data-play
              aria-label="Play"
              aria-pressed="false"
            >
              <span data-icon-play style="display:flex">
                <Icon name="play" size={18} weight="fill" />
              </span>
              <span data-icon-pause style="display:none">
                <Icon name="pause" size={18} weight="fill" />
              </span>
            </button>

            <button
              type="button"
              class="transport__btn"
              data-skip-start
              aria-label="Jump to start"
            >
              <Icon name="skip-back" size={16} weight="fill" />
            </button>

            <button
              type="button"
              class="transport__btn"
              data-skip-end
              aria-label="Jump to end"
            >
              <Icon name="skip-forward" size={16} weight="fill" />
            </button>

            <button
              type="button"
              class="transport__btn"
              data-loop
              aria-label="Loop playback"
              aria-pressed="false"
            >
              <Icon name="repeat" size={16} />
            </button>

            <div class="transport__time tnum" data-time>0:00.00 <span>/ 0:00.00</span></div>
            <div class="transport__spacer" />

            <p class="transport__keys" aria-hidden="true">
              <kbd>Space</kbd> play
              <span>·</span>
              <kbd>⌥</kbd>scroll zoom
              {markers && (
                <>
                  <span>·</span>
                  double-click to cut
                </>
              )}
            </p>

            <div class="zoomer" role="group" aria-label="Zoom">
              <button
                type="button"
                class="transport__btn"
                data-zoom-out
                aria-label="Zoom out"
                title="Zoom out (-)"
              >
                <Icon name="magnifying-glass-minus" size={16} />
              </button>

              {/* The readout is the fit button: the number tells you where you
                  are and clicking it puts you back. */}
              <button
                type="button"
                class="zoomer__level tnum"
                data-zoom-fit
                title="Fit the whole file (0)"
              >
                1&#215;
              </button>

              <button
                type="button"
                class="transport__btn"
                data-zoom-in
                aria-label="Zoom in"
                title="Zoom in (+)"
              >
                <Icon name="magnifying-glass-plus" size={16} />
              </button>

              {selection && (
                <button
                  type="button"
                  class="transport__btn"
                  data-zoom-selection
                  aria-label="Zoom to the selection"
                  title="Zoom to the selection (S)"
                >
                  <Icon name="crop" size={16} />
                </button>
              )}
            </div>
          </div>
        </div>
      )
    }

    <slot />

    {/*
      Where a processed result lands. The main transport above always plays the
      source; anything a tool renders — a live preview, a cleaned recording, an
      extracted vocal — mounts here as its own player, the same shape as the
      splitter's mixer. Swapping the original out from under the play button
      looked like the file itself had changed, and made "compare" impossible.
    */}
    <StemPanel purpose="result" />

    {results && <div class="results" data-results />}

    {
      exportBar && (
        <div class="export">
          <div class="field export__field" data-format-field>
            <label class="label" for="format-select">
              Format
            </label>
            <select class="select" id="format-select" data-format />
          </div>

          <div class="field export__field" data-quality-field>
            <label class="label" for="quality-select">
              Quality
            </label>
            <select class="select" id="quality-select" data-quality />
          </div>

          <div class="export__spacer" />
          <div class="export__size tnum" data-size />

          <button type="button" class="btn btn--solid btn--lg" data-download>
            <Icon name="download-simple" size={18} />
            {action}
          </button>
        </div>
      )
    }

    {
      chain.length > 0 && (
        <div class="chain" data-chain hidden>
          <span class="chain__label">Saved. Keep going?</span>
          <div class="chain__links">
            {chain.map((next) => (
              <a
                class="btn btn--quiet btn--sm"
                href={`/${next.slug}`}
                data-chain-link
                data-cat={next.category}
              >
                <span class="chain__icon" aria-hidden="true">
                  <Icon name={next.icon} weight="duotone" size={16} />
                </span>
                {next.name}
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</div>

<div class="drop-overlay" aria-hidden="true">Drop the file anywhere</div>

<script>
  // The "Choose files" button sits inside the dropzone, whose own click
  // handler ignores buttons — so it needs to open the picker itself.
  document.querySelectorAll<HTMLElement>('[data-browse]').forEach((button) => {
    button.addEventListener('click', (event) => {
      event.stopPropagation();
      const root = button.closest('[data-tool]');
      root?.querySelector<HTMLInputElement>('[data-file-input]')?.click();
    });
  });
</script>
