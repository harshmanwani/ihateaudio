---
/**
 * The mark, inlined from the same SVG the favicon and app icons are built from,
 * so there is exactly one place the logo is drawn.
 */
import logo from '../assets/logo.svg?raw';

interface Props {
  size?: number;
  class?: string;
}

const { size = 26, class: className } = Astro.props;

const svg = logo
  .replace('<svg', `<svg width="${size}" height="${size}"`)
  .replace('role="img"', 'aria-hidden="true" focusable="false"');
---

<span class:list={['logo', className]} set:html={svg} />

<style>
  .logo {
    display: flex;
    flex: none;
  }

  .logo :global(svg) {
    display: block;
    border-radius: 7px;
  }
</style>
