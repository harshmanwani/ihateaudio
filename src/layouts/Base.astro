---
import { SITE, ANALYTICS } from '../consts';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import splashLinks from '../assets/splash-links.html?raw';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/app.css';
import '../styles/tool.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/audio-trimmer". Root is "/". */
  path: string;
  /** JSON-LD objects appended to the page. */
  schema?: unknown[];
  noindex?: boolean;
}

const { title, description, path, schema = [], noindex = false } = Astro.props;

const canonical = new URL(path, SITE.url).href;

/**
 * Each page gets its own social card from /og, named after its slug, with the
 * shared card as a fallback. A link to the ringtone maker should look like the
 * ringtone maker; one identical image across 44 pages wastes the most visible
 * surface a shared link has.
 */
const ogSlug = path === '/' ? 'home' : path.replace(/^\//, '').replace(/\/$/, '');
const ogImage = new URL(`/og/${ogSlug}.png`, SITE.url).href;

/**
 * Emitted on every page.
 *
 * Organization gives search engines and assistants one canonical entity to
 * attach facts to. WebSite carries the SearchAction, which is what lets a
 * results page offer a search box straight into our own search.
 */
const siteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    url: SITE.url,
    logo: new URL('/icon-512.png', SITE.url).href,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    url: SITE.url,
    publisher: { '@id': `${SITE.url}/#organization` },
    inLanguage: SITE.locale,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${SITE.url}/?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
];
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      ANALYTICS.googleVerification && (
        <meta
          name="google-site-verification"
          content={ANALYTICS.googleVerification}
        />
      )
    }

    <!--
      The font is the only render-blocking asset on the page, so it is
      preloaded. Everything else is inlined or deferred.
    -->
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Installed on iOS, these are what make it open as an app rather than a
         Safari window with the chrome hidden. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ihateaudio" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="ihateaudio" />

    <!--
      Launch images, generated with the icons by scripts/generate-app-icons.mjs.
      iOS matches these on exact pixel size with no fallback, so the list is
      built from the same table the images are, never typed by hand.
    -->
    <Fragment set:html={splashLinks} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Points assistants and agents at the plain-language brief. -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM brief" />
    <link
      rel="alternate"
      type="application/json"
      href="/tools.json"
      title="Machine-readable tool index"
    />

    <Analytics />

    {
      [...siteSchema, ...schema].map((item) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(item)}
        />
      ))
    }
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to the tool</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <InstallPrompt />

    <script>
      // Registers the offline cache. Because every tool runs client-side, the
      // whole site genuinely works with no connection once it has been visited.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {
            /* Offline support is a bonus; the site works fine without it. */
          });
        });
      }
    </script>
  </body>
</html>
