---
import ToolPage from '../layouts/ToolPage.astro';
import ToolShell from '../components/ToolShell.astro';
import RunAction from '../components/RunAction.astro';
import { getTool } from '../data/tools';

const tool = getTool('tempo-changer');

const steps = [
  'Drop the track you want to work on onto the page. It is decoded locally, so a rehearsal recording or an unreleased mix never leaves your machine.',
  'Set the tempo as a percentage of the original. 100% is untouched, 75% is three quarters of the original speed, 120% is a fifth faster.',
  'If you know the tempo of the recording, type it into the BPM box. The tool then tells you the beats per minute you will actually be playing at.',
  'Click Preview the tempo to render it. The result appears as its own player below the controls; time-stretching is too expensive to redo on every drag, so it runs when you ask for it.',
  'Download the result, or loop a section first with the trimmer if you only need one difficult bar.',
];

const faq = [
  {
    q: 'Will the key change if I slow the track down?',
    a: 'No. That is the entire reason to use this rather than a speed control. The audio is rebuilt from overlapping windows placed at new intervals, so every note keeps the frequency it was recorded at. A song in E flat is still in E flat at 70%, which is what makes it usable as a practice tool.',
  },
  {
    q: 'What percentage should I practise at?',
    a: 'The usual advice is the fastest tempo at which you can play the passage cleanly, which for most people starts somewhere between 60% and 75%. Move up in steps of about 5% once a pass is clean twice in a row. Jumping straight from 60% to full speed tends to reintroduce the same mistakes, because the muscle timing was learned at the slow tempo rather than adapted from it.',
  },
  {
    q: 'How slow can I go before it sounds strange?',
    a: 'Down to about 70% most material holds together well. Between 50% and 70% you begin to hear a faint smearing on cymbals and consonants, because the algorithm is repeating more windows than it is playing. Below 50% the effect becomes obvious on anything with sharp attacks, although a solo instrument or a clean vocal survives further than a dense full mix.',
  },
  {
    q: 'Does 200% mean twice as fast?',
    a: 'Yes. Percentage here is a straightforward multiplier on the playback rate: 200% halves the running time, 50% doubles it. A three minute song at 80% runs three minutes and forty-five seconds, because the length scales by one divided by the percentage rather than by the percentage itself.',
  },
  {
    q: 'Can I use this to match two tracks for a mix?',
    a: 'Yes, and this is where the BPM box earns its place. Detect or look up both tempos, divide the target by the source, and enter that as the percentage, 128 into 124 is 96.9%. Beat-matching still needs the downbeats aligned afterwards, which is a job for the trimmer, but the tempo will hold across the whole track rather than drifting.',
  },
  {
    q: 'Why does the result sometimes sound slightly flangy?',
    a: 'Time-stretching works by overlapping copies of the signal, and when two overlapping copies are almost but not exactly in phase they interfere in a way that sweeps across the spectrum. The alignment search removes most of this by hunting for the offset where the waveforms match best, but it cannot remove all of it on material with lots of simultaneous pitches. Smaller tempo changes leave less to interfere.',
  },
  {
    q: 'Is this the same as the speed changer with pitch preservation on?',
    a: 'It is the same engine, expressed differently. The speed changer thinks in multipliers and offers both coupled and uncoupled modes; this page is percentage-first, always pitch-preserving, and adds the BPM readout that musicians actually want. Use whichever set of numbers matches how you are thinking about the problem.',
  },
];
---

<ToolPage slug={tool.slug} steps={steps} faq={faq}>
  <ToolShell tool={tool} action="Download">
    <div class="controls">
      <div class="controls__head">
        <span class="controls__title">Tempo</span>
        <span class="hint">The pitch is held throughout. Only the timing moves.</span>
      </div>

      {/*
        What the percentage costs, and where it starts to cost quality.

        Holding the pitch is not free the way resampling is: the audio is cut
        into windows and relaid at a new spacing, so the further from 100% you
        go, the more material has to be repeated or dropped, and eventually that
        is audible as a flutter on sustained notes. Where "eventually" falls
        depends on the material, which is why there are two bands rather than one
        — speech tolerates far more than a dense mix with sharp transients.
      */}
      <div class="stretch controls__full" data-stretch-panel>
        <canvas class="stretch__canvas" data-stretch aria-hidden="true"></canvas>
      </div>

      <div class="field controls__full">
        <label class="label" for="tempo">
          Tempo
          <span class="label__value tnum" data-out="tempo">100%</span>
        </label>
        <div class="slider-row">
          <input
            class="slider"
            id="tempo"
            data-control="tempo"
            type="range"
            min="50"
            max="200"
            step="1"
            value="100"
          />
          <input
            class="num"
            data-control="tempo-num"
            type="number"
            min="50"
            max="200"
            step="1"
            value="100"
            aria-label="Tempo as a percentage of the original"
          />
        </div>
      </div>

      <div class="field controls__full">
        <span class="label" id="tempo-presets">Presets</span>
        <div class="seg" role="group" aria-labelledby="tempo-presets">
          <button type="button" class="seg__btn" data-preset="50" aria-label="50 percent" aria-pressed="false">50</button>
          <button type="button" class="seg__btn" data-preset="75" aria-label="75 percent" aria-pressed="false">75</button>
          <button type="button" class="seg__btn" data-preset="90" aria-label="90 percent" aria-pressed="false">90</button>
          <button type="button" class="seg__btn" data-preset="100" aria-label="100 percent, the original" aria-pressed="true">100</button>
          <button type="button" class="seg__btn" data-preset="125" aria-label="125 percent" aria-pressed="false">125</button>
        </div>
      </div>

      <div class="field">
        <label class="label" for="bpm">Original BPM (optional)</label>
        <input
          class="input tnum"
          id="bpm"
          data-control="bpm"
          type="number"
          min="20"
          max="300"
          step="0.1"
          inputmode="decimal"
          placeholder="e.g. 120"
        />
        <span class="hint" data-out="bpm">
          Enter the source tempo to see what you will be playing at.
        </span>
      </div>

      <div class="field">
        <span class="label">
          New length
          <span class="label__value tnum" data-out="length">·</span>
        </span>
        <span class="hint" data-out="length-hint">Load a file to see the new running time.</span>
      </div>

      <RunAction
        mode="preview"
        label="Preview the tempo"
        busy="Stretching"
        hint="Time-stretching is heavy, so it runs when you ask rather than on every drag. Downloading works either way."
        done="Rendered. The stretched version has its own player below; the original stays above."
      />
    </div>
  </ToolShell>

  <Fragment slot="about">
    <h2>Why practising along with a recording needs this</h2>
    <p>
      Learning a part by ear from a record is a good way to learn, right up until
      the passage is faster than your hands. The obvious fix, slow the recording
      down. Used to mean slowing the tape, which drops the pitch with it. A solo
      slowed to three quarters speed on tape arrives roughly five semitones flat.
      Now your fingering no longer matches what you are hearing, your ear is
      being trained on the wrong intervals, and you cannot play along on a tuned
      instrument at all.
    </p>
    <p>
      Pitch-preserving stretching removes that problem completely. The recording
      stays in its original key at any tempo, so you can put the metronome away,
      play along at 65%, and step up as the passage settles. Everything you learn
      at the slow tempo transfers directly, because the notes were never in a
      different place.
    </p>
    <p>
      The same property matters outside practice rooms. A cue that has to fit a
      picture edit can be nudged a few percent without anyone hearing that the
      key moved. Two takes recorded on different days at slightly different
      tempos can be pulled into agreement. A sample can be made to sit on a grid
      without being transposed off the chord it belongs to.
    </p>

    <h2>How the stretch is done</h2>
    <p>
      The technique is overlap-add with a similarity search, usually called
      WSOLA. The audio is cut into windows of about 46 milliseconds, each faded
      in and out with a raised-cosine shape. To slow the recording down, those
      windows are written to the output further apart than they were read; to
      speed it up, closer together. Because each window still contains real
      waveform at its real frequency, nothing is transposed.
    </p>
    <p>
      The difficulty is the joins. Two windows dropped next to each other at
      arbitrary phase will cancel or reinforce in ways that sound like a comb
      filter sweeping past. So before writing each window the algorithm looks at
      a small range of nearby read positions and picks the one whose waveform
      best continues what has already been written. That search is why a stretch
      takes a second or two rather than being instant, and it is the difference
      between a usable practice tool and something that sounds like a broken CD.
    </p>

    <h2>Where the limits are</h2>
    <p>
      Stretching is interpolation, and interpolation invents nothing. At moderate
      ratios (say 75% to 130%) there is very little to invent and the output is
      close to transparent. Push further and the algorithm has to repeat or drop
      an increasing share of the material. On sustained sounds that is harmless.
      On transients it is not: a snare hit stretched across two windows arrives
      twice, faintly, and reads as softness rather than as a doubled hit.
    </p>
    <p>
      If you need a very large change and the pitch does not matter, use the
      speed changer instead. A plain resample is artefact-free at any ratio. If
      you need the pitch moved and the timing held, that is the pitch shifter.
      This page is for the case in the middle, where the timing is the thing that
      has to change and the key must not.
    </p>
  </Fragment>
</ToolPage>

<style>
  .stretch {
    padding: var(--s4);
    border-radius: var(--r-md);
    background: var(--stage-2, var(--surface));
  }

  .stretch__canvas {
    width: 100%;
    height: 168px;
    display: block;
  }

  @media (max-width: 560px) {
    .stretch__canvas {
      height: 152px;
    }
  }
</style>

<script>
  import { createTool } from '../lib/tool';
  import { changeTempo } from '../lib/audio/stretch';
  import { clamp, duration, pct } from '../lib/format';
  import { panelColors, panelContext } from '../lib/canvas';

  let source: AudioBuffer | null = null;
  let wired = false;

  /**
   * Where overlap-add stretching stays transparent.
   *
   * Not a property of the implementation so much as of the material: speech is
   * mostly one voice with forgiving transients, a dense mix is many sources with
   * sharp ones, and the same window-repeating artefact is inaudible in the first
   * and obvious in the second. These are the ranges the page's own guidance
   * gives, drawn rather than described.
   */
  const BANDS = [
    { from: 60, to: 180, label: 'speech holds up', weight: 0.14 },
    { from: 75, to: 140, label: 'safe for dense music', weight: 0.3 },
  ];

  function drawStretch(
    panel: HTMLElement,
    canvas: HTMLCanvasElement,
    percent: number,
    seconds: number
  ): void {
    const cssWidth = canvas.clientWidth;
    const cssHeight = canvas.clientHeight;
    if (cssWidth < 1 || cssHeight < 1) return;

    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const width = Math.round(cssWidth * dpr);
    const height = Math.round(cssHeight * dpr);
    if (canvas.width !== width || canvas.height !== height) {
      canvas.width = width;
      canvas.height = height;
    }

    const context = panelContext(canvas);
    if (!context) return;
    context.clearRect(0, 0, width, height);

    const { ink, hue } = panelColors(panel);

    const padL = 56 * dpr;
    const padR = 14 * dpr;
    const plotW = width - padL - padR;

    context.font = `${10 * dpr}px system-ui, sans-serif`;
    context.textBaseline = 'middle';

    // ---- Length, both on one axis. ----
    const after = seconds / (percent / 100);
    const longest = Math.max(seconds, after) || 1;
    const barH = 20 * dpr;
    const barGap = 8 * dpr;
    const barsTop = 12 * dpr;

    const bar = (index: number, title: string, value: number, accent: string): void => {
      const y = barsTop + index * (barH + barGap);
      context.textAlign = 'right';
      context.fillStyle = `color-mix(in oklch, ${ink} 55%, transparent)`;
      context.fillText(title, padL - 10 * dpr, y + barH / 2);

      context.fillStyle = `color-mix(in oklch, ${ink} 6%, transparent)`;
      context.fillRect(padL, y, plotW, barH);

      const w = Math.max(2 * dpr, (value / longest) * plotW);
      context.fillStyle = accent;
      context.beginPath();
      context.roundRect(padL, y, w, barH, 3 * dpr);
      context.fill();

      const inside = w > 66 * dpr;
      context.textAlign = inside ? 'right' : 'left';
      context.fillStyle = inside
        ? `color-mix(in oklch, ${ink} 92%, transparent)`
        : `color-mix(in oklch, ${ink} 70%, transparent)`;
      context.fillText(duration(value), padL + w + (inside ? -8 : 8) * dpr, y + barH / 2);
    };

    bar(0, 'Now', seconds, `color-mix(in oklch, ${ink} 26%, transparent)`);
    bar(1, 'After', after, `color-mix(in oklch, ${hue} 70%, transparent)`);

    // ---- How far the stretch is being pushed. ----
    const rulerY = barsTop + barH * 2 + barGap + 44 * dpr;
    if (rulerY + 26 * dpr > height) return;

    const x = (value: number) => padL + ((clamp(value, 50, 200) - 50) / 150) * plotW;

    context.textAlign = 'right';
    context.fillStyle = `color-mix(in oklch, ${ink} 55%, transparent)`;
    context.fillText('Stretch', padL - 10 * dpr, rulerY - 4 * dpr);
    context.fillStyle = `color-mix(in oklch, ${ink} 40%, transparent)`;
    context.fillText('quality', padL - 10 * dpr, rulerY + 10 * dpr);

    context.fillStyle = `color-mix(in oklch, ${ink} 7%, transparent)`;
    context.fillRect(padL, rulerY - 9 * dpr, plotW, 18 * dpr);

    for (const band of BANDS) {
      context.fillStyle = `color-mix(in oklch, ${hue} ${Math.round(band.weight * 100)}%, transparent)`;
      context.fillRect(x(band.from), rulerY - 9 * dpr, x(band.to) - x(band.from), 18 * dpr);
    }

    context.textAlign = 'center';
    context.font = `${10 * dpr}px system-ui, sans-serif`;
    context.fillStyle = `color-mix(in oklch, ${ink} 46%, transparent)`;
    context.fillText(BANDS[1]!.label, (x(75) + x(140)) / 2, rulerY - 20 * dpr);
    context.fillStyle = `color-mix(in oklch, ${ink} 34%, transparent)`;
    context.fillText(BANDS[0]!.label, (x(140) + x(180)) / 2, rulerY + 21 * dpr);

    for (const tick of [50, 75, 100, 125, 150, 175, 200]) {
      context.strokeStyle = `color-mix(in oklch, ${ink} ${tick === 100 ? 34 : 14}%, transparent)`;
      context.lineWidth = dpr;
      context.beginPath();
      context.moveTo(x(tick), rulerY - 9 * dpr);
      context.lineTo(x(tick), rulerY + 9 * dpr);
      context.stroke();
      context.fillStyle = `color-mix(in oklch, ${ink} 38%, transparent)`;
      context.fillText(`${tick}%`, x(tick), rulerY + 34 * dpr);
    }

    context.fillStyle = hue;
    context.beginPath();
    context.arc(x(percent), rulerY, 6 * dpr, 0, Math.PI * 2);
    context.fill();

    const pushed = percent < 75 || percent > 140;
    context.font = `600 ${11 * dpr}px system-ui, sans-serif`;
    context.fillStyle = ink;
    const right = x(percent) > padL + plotW * 0.6;
    context.textAlign = right ? 'right' : 'left';
    context.fillText(
      percent === 100 ? 'unchanged' : pushed ? 'listen for flutter here' : 'clean stretch',
      x(percent) + (right ? -12 : 12) * dpr,
      rulerY - 22 * dpr
    );
  }

  function percentOf(): number {
    return clamp(tool?.value('tempo', 100) ?? 100, 50, 200);
  }

  const tool = createTool({
    suffix: 'tempo',
    defaultFormat: 'mp3',
    previewLabel: 'Stretched',

    onReady(ctx, runtime) {
      source = ctx.buffer;

      const root = runtime.root;
      const range = root.querySelector<HTMLInputElement>('[data-control="tempo"]');
      const num = root.querySelector<HTMLInputElement>('[data-control="tempo-num"]');
      const bpm = root.querySelector<HTMLInputElement>('[data-control="bpm"]');
      const tempoOut = root.querySelector<HTMLElement>('[data-out="tempo"]');
      const bpmOut = root.querySelector<HTMLElement>('[data-out="bpm"]');
      const length = root.querySelector<HTMLElement>('[data-out="length"]');
      const lengthHint = root.querySelector<HTMLElement>('[data-out="length-hint"]');
      const presets = root.querySelectorAll<HTMLButtonElement>('[data-preset]');
      const stretchPanel = root.querySelector<HTMLElement>('[data-stretch-panel]');
      const stretchCanvas = root.querySelector<HTMLCanvasElement>('[data-stretch]');
      if (!range) return;

      const paint = (): void => {
        const percent = percentOf();
        const multiplier = percent / 100;
        if (stretchPanel && stretchCanvas) {
          drawStretch(stretchPanel, stretchCanvas, percent, source?.duration ?? 0);
        }
        range.style.setProperty('--pct', `${pct(percent, 50, 200)}%`);
        if (tempoOut) tempoOut.textContent = `${percent}%`;
        if (length) length.textContent = duration((source?.duration ?? 0) / multiplier);
        if (lengthHint) {
          lengthHint.textContent =
            percent === 100
              ? `Unchanged, ${duration(source?.duration ?? 0)}.`
              : `Was ${duration(source?.duration ?? 0)}.`;
        }
        if (bpmOut) {
          const original = Number(bpm?.value);
          bpmOut.textContent =
            bpm && bpm.value.trim() !== '' && Number.isFinite(original) && original > 0
              ? `${original} BPM becomes ${(original * multiplier).toFixed(1)} BPM.`
              : 'Enter the source tempo to see what you will be playing at.';
        }
        presets.forEach((preset) => {
          preset.setAttribute('aria-pressed', String(Number(preset.dataset.preset) === percent));
        });
      };

      // Rendering, its progress, its failures and the stale state all belong to
      // the run panel now, which shares one implementation with process() below
      // instead of a second copy of the render here.
      const invalidate = (): void => paint();

      // The canvas has no width until the workspace is on screen. Runs on every
      // ready, since a second file changes the lengths the bars are drawn from.
      requestAnimationFrame(paint);

      if (wired) {
        paint();
        return;
      }
      wired = true;

      if (stretchPanel) new ResizeObserver(paint).observe(stretchPanel);

      range.addEventListener('input', () => {
        if (num) num.value = range.value;
        invalidate();
      });

      num?.addEventListener('input', () => {
        const typed = Number(num.value);
        if (num.value.trim() === '' || !Number.isFinite(typed)) return;
        range.value = String(Math.round(clamp(typed, 50, 200)));
        invalidate();
      });

      num?.addEventListener('change', () => {
        if (num) num.value = range.value;
        paint();
      });

      // The BPM box only feeds the readout, so it never invalidates the audition.
      bpm?.addEventListener('input', paint);

      presets.forEach((preset) => {
        preset.addEventListener('click', () => {
          range.value = preset.dataset.preset ?? '100';
          if (num) num.value = range.value;
          invalidate();
        });
      });


      paint();
    },


    async process(ctx) {
      const percent = percentOf();
      if (percent === 100) return ctx.buffer;

      ctx.progress(0.05);
      await new Promise((resolve) => setTimeout(resolve, 0));
      return { buffer: changeTempo(ctx.buffer, percent / 100), suffix: `${percent}pct` };
    },
  });
</script>
