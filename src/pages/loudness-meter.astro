---
import ToolPage from '../layouts/ToolPage.astro';
import ToolShell from '../components/ToolShell.astro';
import { getTool } from '../data/tools';

const tool = getTool('loudness-meter');

const steps = [
  'Drop the file onto the page. Measurement starts by itself once the audio has decoded, and takes a second or two for a full track.',
  'Read the integrated loudness first. That single LUFS figure is what every streaming platform compares against its own target, and it is the number that decides whether your file gets turned down.',
  'Check the true peak. If it sits above -1 dBTP the file may clip once it is encoded to MP3 or AAC, even though it never clipped in your editor.',
  'Compare the table against the platform you are publishing to, then use the audio normalizer to move the file to that target while holding the peak below its ceiling.',
];

const faq = [
  {
    q: 'What is LUFS, and why not just use dB?',
    a: 'LUFS is loudness weighted for how human hearing works, averaged over the whole programme, with silence gated out so pauses do not drag the reading down. A plain dB peak reading tells you the height of the tallest sample, which correlates poorly with how loud something sounds. Two files can share a 0 dBFS peak and differ by 12 LUFS.',
  },
  {
    q: 'Why does my DAW report a slightly different number?',
    a: 'Almost always gating or a different measurement window. This meter implements ITU-R BS.1770-4 with both gates (the absolute gate at -70 LUFS and the relative gate 10 LU below the ungated mean) which is what Spotify, YouTube and the podcast hosts use. A meter without the relative gate reads lower on material with quiet passages. Differences under about 0.3 LU are normal and inconsequential.',
  },
  {
    q: 'The true peak is higher than the sample peak. Is that a bug?',
    a: 'No, and it is the whole reason true peak exists. Digital audio stores discrete samples, but playback reconstructs a continuous curve through them, and that curve can rise above every sample it passes through. This meter oversamples four times to estimate the reconstructed peak. A file reading 0.0 dBFS sample peak and +0.8 dBTP true peak will clip on some hardware.',
  },
  {
    q: 'What is loudness range and what should mine be?',
    a: 'Loudness range, in LU, is the spread between the quiet and loud parts of the programme, measured as the 10th to 95th percentile of three-second blocks. There is no correct value, only wrong ones for a context: a modern pop master sits around 3–6 LU, a podcast around 5–8, orchestral recordings above 15. A podcast with an 18 LU range is unlistenable in a car.',
  },
  {
    q: 'Is louder better?',
    a: 'Not since normalization became the default. If you master four decibels above the target, the platform turns the file down four decibels on playback, and all you have done is squash the dynamics for no gain in perceived loudness. The one thing worth avoiding is landing far below the target on YouTube, which turns loud files down but never turns quiet ones up.',
  },
  {
    q: 'Does it measure the whole file or just part of it?',
    a: 'The whole file, which is what integrated loudness means. Blocks quieter than the gates are excluded from the average, so a long silence at the start or a fade-out at the end does not skew the result. Loudness range and both peak figures are also taken across the entire file.',
  },
  {
    q: 'My file reads as silent or shows no number.',
    a: 'That happens when every 400 ms block falls below the -70 LUFS absolute gate. The file is either genuinely silent or so quiet it is indistinguishable from silence. Check the waveform above the readout. If it looks flat, the recording failed rather than the measurement.',
  },
];

interface Target {
  id: string;
  name: string;
  lufs: number;
  kind: string;
}

/** Published platform targets. Kept in the same order as /loudness-targets. */
const targets: Target[] = [
  { id: 'spotify', name: 'Spotify', lufs: -14, kind: 'Music' },
  { id: 'apple-music', name: 'Apple Music', lufs: -16, kind: 'Music' },
  { id: 'youtube', name: 'YouTube', lufs: -14, kind: 'Music & video' },
  { id: 'amazon', name: 'Amazon Music', lufs: -14, kind: 'Music' },
  { id: 'tidal', name: 'Tidal', lufs: -14, kind: 'Music' },
  { id: 'apple-podcasts', name: 'Apple Podcasts', lufs: -16, kind: 'Podcast (stereo)' },
  { id: 'spotify-podcasts', name: 'Spotify Podcasts', lufs: -14, kind: 'Podcast' },
  { id: 'ebu', name: 'EBU R128 broadcast', lufs: -23, kind: 'Broadcast' },
];

const stats = [
  {
    id: 'integrated',
    label: 'Integrated loudness',
    unit: 'LUFS',
    note: 'Gated average across the whole file',
  },
  {
    id: 'range',
    label: 'Loudness range',
    unit: 'LU',
    note: 'Spread between quiet and loud passages',
  },
  {
    id: 'truepeak',
    label: 'True peak',
    unit: 'dBTP',
    note: 'Reconstructed peak, 4x oversampled',
  },
  {
    id: 'peak',
    label: 'Sample peak',
    unit: 'dBFS',
    note: 'Tallest single sample in the file',
  },
];
---

<ToolPage slug={tool.slug} steps={steps} faq={faq}>
  <ToolShell tool={tool} exportBar={false}>
    <div class="card">
      <div
        style="display:grid; gap:var(--s5); grid-template-columns:repeat(auto-fit, minmax(160px, 1fr))"
      >
        {
          stats.map((stat) => (
            <div>
              <div class="hint">{stat.label}</div>
              <div
                class="tnum"
                data-stat={stat.id}
                style="font-size:var(--t-h1); font-weight:700; line-height:1.2"
                aria-live="polite"
              >·</div>
              <div class="hint">
                {stat.unit} · {stat.note}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    {/*
      Loudness over time, against the targets.
      The four numbers above are the answer, but they cannot show *where* the
      answer came from: whether a track sits at -14 all the way through or
      averages there by alternating between -8 and -22. This plots the same
      400 ms gating blocks the integrated figure is computed from, with the
      platform targets drawn across them, so the gap you have to close is a
      distance on screen rather than arithmetic.
    */}
    <div class="meter" data-meter-panel hidden>
      <div class="meter__head">
        <span class="meter__title">Loudness over time</span>
        <span class="meter__key">
          <span class="meter__swatch meter__swatch--curve"></span>Momentary
          <span class="meter__swatch meter__swatch--int"></span>Integrated
        </span>
      </div>
      <canvas class="meter__canvas" data-meter aria-hidden="true"></canvas>
      <p class="meter__caption" data-meter-caption></p>
    </div>

    <div class="note note--warn" data-peak-note hidden>
      <div class="note__body">
        <div class="note__title">True peak is above -1 dBTP</div>
        <div data-peak-body></div>
      </div>
    </div>

    <div class="tablewrap">
      <table class="datatable">
        <thead>
          <tr>
            <th scope="col">Platform</th>
            <th scope="col">Target</th>
            <th scope="col">Difference</th>
            <th scope="col" style="white-space:normal; min-width:22rem">What happens to your file</th>
          </tr>
        </thead>
        <tbody>
          {
            targets.map((target) => (
              <tr>
                <th scope="row" style="font-weight:600">
                  {target.name}
                </th>
                <td>
                  {target.lufs} LUFS
                </td>
                <td class="tnum" data-delta={target.id}>·</td>
                <td style="white-space:normal" data-verdict={target.id}>
                  Waiting for a measurement
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="note note--info">
      <div class="note__body">
        To move the file onto any of these targets while keeping the true peak
        under its ceiling, use the <a href="/audio-normalizer">audio normalizer</a>.
        It applies the same BS.1770 measurement in reverse. The full reference,
        including peak ceilings and what each service does with files that miss,
        is on the <a href="/loudness-targets">loudness targets</a> page.
      </div>
    </div>
  </ToolShell>

  <Fragment slot="about">
    <h2>What integrated loudness actually measures</h2>
    <p>
      Peak meters answer a question nobody asks. Knowing that the tallest sample
      in a file reached -0.1 dBFS tells you almost nothing about how loud the
      file sounds, because loudness is a function of energy over time and of
      which frequencies carry that energy. A bass-heavy track and a bright one
      can share a peak and be four decibels apart to the ear.
    </p>
    <p>
      ITU-R BS.1770 fixes this in three stages. First it applies K-weighting. A high shelf that approximates the effect of a human head in a sound
      field, followed by a high-pass that discards rumble which contributes
      nothing to perceived loudness. Then it measures mean square energy in
      400-millisecond blocks that overlap by 75 per cent. Finally it gates:
      blocks below -70 LUFS are dropped as silence, and blocks more than 10 LU
      below the average of what remains are dropped as well.
    </p>
    <p>
      That second gate is the part people miss when they write their own meter.
      Without it, a track with long quiet verses reads far lower than it sounds,
      and normalizing to the ungated figure makes the loud sections
      uncomfortably loud. The gated result is what Spotify, YouTube, Apple and
      every podcast host compute, which is why it is what this page reports.
    </p>

    <h2>Two peaks, and the gap between them</h2>
    <p>
      Sample peak is the largest absolute value stored in the file. True peak is
      an estimate of the largest value the signal reaches after a converter
      reconstructs the continuous waveform running through those samples, and
      that curve can overshoot every sample it passes through. Four times
      oversampling, used here, catches most of the difference.
    </p>
    <p>
      The gap matters because it is where unexplained distortion comes from. A
      master that shows exactly 0.0 dBFS in an editor can measure +0.9 dBTP,
      clip on a phone's DAC, and clip harder once an MP3 or AAC encoder has
      moved the waveform around. Lossy encoding does not preserve peaks; it
      preserves what things sound like, and the decoded output routinely
      overshoots the input by half a decibel or more. Every platform target
      therefore specifies a ceiling below zero, usually -1 dBTP, and that
      ceiling is insurance rather than pedantry.
    </p>

    <h2>Reading the comparison table</h2>
    <p>
      The difference column is your measured loudness minus the platform target.
      A positive number means the file is louder than the platform wants, and
      playback normalization will turn it down by that amount. Nothing is
      damaged when this happens. But if you compressed heavily to reach that
      level, you gave up dynamic range and received nothing in exchange.
    </p>
    <p>
      A negative number means the file is quieter than the target. What happens
      next depends on the service. Spotify will lift quiet tracks, but only for
      listeners on the "Loud" setting; YouTube never lifts anything, so
      undershooting there costs you real loudness against everything else on the
      platform. Within roughly half a decibel either way, there is nothing to
      fix and no audible difference to gain.
    </p>
  </Fragment>
</ToolPage>

<style>
  .meter {
    display: grid;
    gap: var(--s3);
    padding: var(--s4);
    border-radius: var(--r-md);
    background: var(--stage-2, var(--surface));
  }

  .meter__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s3);
    flex-wrap: wrap;
  }

  .meter__title {
    font-size: var(--t-ui);
    font-weight: 600;
    color: var(--stage-ink, var(--ink));
  }

  .meter__key {
    display: flex;
    align-items: center;
    gap: var(--s2);
    font-size: 11px;
    color: var(--stage-ink-2, var(--ink-2));
  }

  .meter__swatch {
    width: 14px;
    height: 3px;
    border-radius: var(--r-full);
    display: inline-block;
  }

  .meter__swatch--curve {
    background: var(--cat-vivid, var(--brand));
  }

  .meter__swatch--int {
    background: var(--stage-ink, #fff);
  }

  .meter__canvas {
    width: 100%;
    height: 220px;
    display: block;
  }

  .meter__caption {
    margin: 0;
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--stage-ink-2, var(--ink-2));
  }

  @media (max-width: 560px) {
    .meter__canvas {
      height: 170px;
    }
  }
</style>

<script>
  import { createTool } from '../lib/tool';
  import { measureLoudness } from '../lib/audio/analysis';

  interface Target {
    id: string;
    lufs: number;
  }

  const TARGETS: Target[] = [
    { id: 'spotify', lufs: -14 },
    { id: 'apple-music', lufs: -16 },
    { id: 'youtube', lufs: -14 },
    { id: 'amazon', lufs: -14 },
    { id: 'tidal', lufs: -14 },
    { id: 'apple-podcasts', lufs: -16 },
    { id: 'spotify-podcasts', lufs: -14 },
    { id: 'ebu', lufs: -23 },
  ];

  /** One decimal, always signed, so a column of them lines up and reads fast. */
  function signed(value: number): string {
    if (!Number.isFinite(value)) return ', ';
    const rounded = Math.abs(value) < 0.05 ? 0 : value;
    return `${rounded > 0 ? '+' : rounded < 0 ? '−' : ''}${Math.abs(rounded).toFixed(1)}`;
  }

  function verdictFor(delta: number): string {
    if (!Number.isFinite(delta)) return 'Nothing measurable in this file.';
    if (Math.abs(delta) <= 0.5) return 'On target. Nothing to change.';
    if (delta > 0) {
      return `${delta.toFixed(1)} LU too loud. Playback normalization will turn it down by that much.`;
    }
    return `${Math.abs(delta).toFixed(1)} LU quieter than the target. Some services lift it, some do not.`;
  }

  /** The lines worth drawing: the distinct platform targets, not all eight. */
  const MARKS = [
    { lufs: -14, label: 'Spotify, YouTube' },
    { lufs: -16, label: 'Apple, podcasts' },
    { lufs: -23, label: 'EBU R128' },
  ];

  function drawMeter(
    panel: HTMLElement,
    canvas: HTMLCanvasElement,
    momentary: number[],
    step: number,
    integrated: number
  ): void {
    const cssWidth = canvas.clientWidth;
    const cssHeight = canvas.clientHeight;
    if (cssWidth < 1 || cssHeight < 1) return;

    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const width = Math.round(cssWidth * dpr);
    const height = Math.round(cssHeight * dpr);
    if (canvas.width !== width || canvas.height !== height) {
      canvas.width = width;
      canvas.height = height;
    }

    const context = canvas.getContext('2d');
    if (!context) return;
    context.clearRect(0, 0, width, height);

    const styles = getComputedStyle(panel);
    const ink = styles.getPropertyValue('--stage-ink').trim() || '#fff';
    const hue = styles.getPropertyValue('--cat-vivid').trim() || '#3aa76d';

    const padL = 42 * dpr;
    const padR = 96 * dpr;
    const padY = 14 * dpr;
    const plotW = width - padL - padR;
    const plotH = height - padY * 2;

    /**
     * Range chosen from the material, clamped to something sane.
     *
     * A fixed -60..0 axis wastes most of its height on a region nothing occupies,
     * and flattens the very variation the graph exists to show. The floor tracks
     * the quietest block that is actually above the gate.
     */
    const audible = momentary.filter((v) => Number.isFinite(v) && v > -70);
    const lowest = audible.length ? Math.min(...audible) : -40;
    const top = 0;
    const floor = Math.max(-60, Math.min(-20, Math.floor((lowest - 3) / 6) * 6));

    const y = (lufs: number): number =>
      padY + plotH - ((Math.max(floor, Math.min(top, lufs)) - floor) / (top - floor)) * plotH;
    const x = (index: number): number =>
      padL + (momentary.length <= 1 ? 0 : (index / (momentary.length - 1)) * plotW);

    context.font = `${10 * dpr}px system-ui, sans-serif`;
    context.lineWidth = dpr;

    // Scale down the left.
    for (let lufs = top; lufs >= floor; lufs -= 6) {
      context.strokeStyle = `color-mix(in oklch, ${ink} 8%, transparent)`;
      context.beginPath();
      context.moveTo(padL, y(lufs));
      context.lineTo(padL + plotW, y(lufs));
      context.stroke();
      context.fillStyle = `color-mix(in oklch, ${ink} 45%, transparent)`;
      context.textAlign = 'right';
      context.fillText(String(lufs), padL - 6 * dpr, y(lufs) + 3.5 * dpr);
    }

    // Momentary loudness, filled down to the floor. Gaps where a block is below
    // the gate are real and are left as gaps rather than joined through.
    context.beginPath();
    let open = false;
    for (let i = 0; i < momentary.length; i += 1) {
      const value = momentary[i]!;
      if (!Number.isFinite(value) || value <= -70) {
        open = false;
        continue;
      }
      if (!open) {
        context.moveTo(x(i), y(value));
        open = true;
      } else {
        context.lineTo(x(i), y(value));
      }
    }
    context.strokeStyle = hue;
    context.lineWidth = 1.5 * dpr;
    context.lineJoin = 'round';
    context.stroke();

    // The targets, labelled in the right margin so they never sit on the curve.
    for (const mark of MARKS) {
      if (mark.lufs < floor) continue;
      context.setLineDash([5 * dpr, 4 * dpr]);
      context.strokeStyle = `color-mix(in oklch, ${ink} 30%, transparent)`;
      context.lineWidth = dpr;
      context.beginPath();
      context.moveTo(padL, y(mark.lufs));
      context.lineTo(padL + plotW, y(mark.lufs));
      context.stroke();
      context.setLineDash([]);
      context.fillStyle = `color-mix(in oklch, ${ink} 55%, transparent)`;
      context.textAlign = 'left';
      context.fillText(mark.label, padL + plotW + 7 * dpr, y(mark.lufs) + 3.5 * dpr);
    }

    // Integrated: the number everything else on the page is about.
    if (Number.isFinite(integrated) && integrated >= floor) {
      context.strokeStyle = ink;
      context.lineWidth = 2 * dpr;
      context.beginPath();
      context.moveTo(padL, y(integrated));
      context.lineTo(padL + plotW, y(integrated));
      context.stroke();
    }

    // Time along the bottom.
    const seconds = momentary.length * step;
    context.fillStyle = `color-mix(in oklch, ${ink} 45%, transparent)`;
    context.textAlign = 'left';
    context.fillText('0:00', padL, height - 2 * dpr);
    context.textAlign = 'right';
    const mins = Math.floor(seconds / 60);
    const secs = Math.round(seconds % 60);
    context.fillText(`${mins}:${String(secs).padStart(2, '0')}`, padL + plotW, height - 2 * dpr);
  }

  createTool({
    suffix: 'measured',
    stage: true,

    onReady(ctx, runtime) {
      const root = runtime.root;

      const statEl = (id: string): HTMLElement | null =>
        root.querySelector<HTMLElement>(`[data-stat="${id}"]`);

      const setStat = (id: string, value: number, digits = 1): void => {
        const el = statEl(id);
        if (!el) return;
        el.textContent = Number.isFinite(value) ? value.toFixed(digits) : '−∞';
      };

      for (const id of ['integrated', 'range', 'truepeak', 'peak']) {
        const el = statEl(id);
        if (el) el.textContent = '···';
      }

      // measureLoudness runs two biquads over every sample and blocks the main
      // thread, so let the "measuring" state paint before it starts.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          const result = measureLoudness(ctx.buffer);

          setStat('integrated', result.integrated);
          setStat('range', result.range);
          setStat('truepeak', result.truePeak);
          setStat('peak', result.peak);

          const peakNote = root.querySelector<HTMLElement>('[data-peak-note]');
          const peakBody = root.querySelector<HTMLElement>('[data-peak-body]');
          const overCeiling = Number.isFinite(result.truePeak) && result.truePeak > -1;
          if (peakNote) peakNote.hidden = !overCeiling;
          if (peakBody && overCeiling) {
            peakBody.textContent =
              `The reconstructed waveform reaches ${result.truePeak.toFixed(1)} dBTP, ` +
              'which is above the -1 dBTP ceiling every streaming platform asks for. ' +
              'It may survive as a WAV and still clip once encoded to MP3 or AAC. ' +
              'Normalizing with a peak ceiling fixes it.';
          }

          const panel = root.querySelector<HTMLElement>('[data-meter-panel]');
          const canvas = root.querySelector<HTMLCanvasElement>('[data-meter]');
          const caption = root.querySelector<HTMLElement>('[data-meter-caption]');
          if (panel && canvas && result.momentary.length > 1) {
            panel.hidden = false;
            const paint = (): void =>
              drawMeter(panel, canvas, result.momentary, result.momentaryStep, result.integrated);
            requestAnimationFrame(paint);
            new ResizeObserver(paint).observe(panel);

            if (caption) {
              // Loudness range says how much the level moves; saying what that
              // means for the listener is more use than the number alone.
              caption.textContent =
                result.range < 4
                  ? `The level barely moves (${result.range.toFixed(1)} LU range), so the integrated figure describes the whole file. That is typical of a mastered or heavily compressed track.`
                  : result.range > 12
                    ? `The level swings a lot (${result.range.toFixed(1)} LU range). The integrated figure is an average of quite different passages, so normalizing to a target will still leave loud and quiet sections far apart.`
                    : `A ${result.range.toFixed(1)} LU range: some movement between passages, which is normal for music that has not been squashed flat.`;
            }
          }

          for (const target of TARGETS) {
            const delta = result.integrated - target.lufs;
            const deltaCell = root.querySelector<HTMLElement>(`[data-delta="${target.id}"]`);
            const verdictCell = root.querySelector<HTMLElement>(
              `[data-verdict="${target.id}"]`
            );
            if (deltaCell) {
              deltaCell.textContent = Number.isFinite(delta) ? `${signed(delta)} LU` : ', ';
            }
            if (verdictCell) verdictCell.textContent = verdictFor(delta);
          }
        });
      });
    },

    // No export button on this page; the runtime still requires a process.
    process(ctx) {
      return ctx.buffer;
    },
  });
</script>
