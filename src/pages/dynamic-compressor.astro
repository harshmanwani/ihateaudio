---
import ToolPage from '../layouts/ToolPage.astro';
import ToolShell from '../components/ToolShell.astro';
import { getTool } from '../data/tools';

const tool = getTool('dynamic-compressor');

const steps = [
  'Drop the recording onto the page. The transport plays the compressed result, so every change you make is audible immediately against the file you started with.',
  'Start from a preset. Voice and podcast suits anything spoken; gentle is the least destructive place to begin on music.',
  'Move the threshold until the loud moments are being caught and the quiet ones are left alone, then set the ratio to decide how firmly they are held down.',
  'Shape the character with attack and release: a slower attack keeps the punch of consonants and transients, a longer release stops the level pumping between words.',
  'Raise the makeup gain to bring the whole file back up to a usable level, then choose a format and download.',
];

const faq = [
  {
    q: 'What does the threshold actually set?',
    a: 'The level at which the compressor starts working. Anything below it passes through completely untouched; anything above it gets turned down according to the ratio. Lowering the threshold means more of the recording is being processed, which is why very low thresholds on quiet material sound squashed rather than controlled.',
  },
  {
    q: 'What ratio should I use?',
    a: 'For speech, 3:1 to 5:1 evens out a delivery without drawing attention to itself. Around 2:1 is barely audible and useful for gentle glue on music. Above about 10:1 the compressor is functioning as a limiter. Nothing gets past the threshold by much at all, which is right for peak control and wrong for tone.',
  },
  {
    q: 'Why does a fast attack make things sound dull?',
    a: 'Because the first few milliseconds of a sound carry most of its identity. Clamping down in 1 ms removes the transient of every consonant, drum hit and pick attack, so the result sounds soft and distant. Setting the attack to 15–30 ms lets the transient through and compresses only the body behind it, which keeps the punch.',
  },
  {
    q: 'My voice sounds like it is breathing between words. What is that?',
    a: 'That is pumping, and it is a release time set too short. The compressor recovers fully during each pause, so the room noise underneath the voice audibly swells and drops with every syllable. Take the release up towards 200–300 ms and the movement becomes too slow to hear as an effect.',
  },
  {
    q: 'Is this the same as normalizing?',
    a: 'No, and the two solve opposite problems. Normalizing applies one fixed gain to the entire file and leaves the dynamics exactly as they were. Compression continuously changes the gain based on what the signal is doing, which is what reduces the distance between the loud and quiet parts. Compress first if you need it, then normalize.',
  },
  {
    q: 'What does the knee do?',
    a: 'It controls how abruptly the ratio comes into effect around the threshold. A hard knee of 0 dB means the compressor is entirely off one decibel below and fully engaged one decibel above, which is audible on material that hovers near the line. A soft knee of 10 dB or more eases the ratio in gradually and suits voice and acoustic sources.',
  },
  {
    q: 'Should I compress before or after removing silence?',
    a: 'Remove the silence first. A silence remover works from a level threshold, and compression raises the quiet parts (including room tone) which can lift background noise above that threshold and stop the gaps from being detected at all. Cut first, compress second, set the final level last.',
  },
];
---

<ToolPage slug={tool.slug} steps={steps} faq={faq}>
  <ToolShell tool={tool} action="Download">
    <div class="controls">
      <div class="controls__head">
        <span class="controls__title">Compressor</span>
        <span class="hint">The curve is what your settings actually do to a level.</span>
      </div>

      {/*
        The transfer curve: input level across, output level up.
        A compressor is a function from one level to another, and every control
        on this page is a parameter of that one function — which is impossible to
        see when they are six separate numbers. Drawn, the threshold is the place
        the line bends, the ratio is how far it flattens, and the knee is how
        sharp the corner is. The dot is where this particular recording sits, so
        the reduction figure is about your file rather than about compression.
      */}
      <div class="curve controls__full" data-curve-panel>
        <canvas class="curve__canvas" data-curve aria-hidden="true"></canvas>
        <dl class="curve__facts">
          <div class="curve__fact">
            <dt>Your material</dt>
            <dd class="tnum" data-fact-level>—</dd>
          </div>
          <div class="curve__fact">
            <dt>Gain reduction</dt>
            <dd class="tnum" data-fact-gr>—</dd>
          </div>
          <div class="curve__fact">
            <dt>Out, after makeup</dt>
            <dd class="tnum" data-fact-out>—</dd>
          </div>
          <div class="curve__fact">
            <dt>Export peak</dt>
            <dd class="tnum" data-fact-peak>—</dd>
          </div>
          <p class="curve__note" data-fact-note></p>
        </dl>
      </div>

      <div class="field controls__full">
        <label class="label" for="dc-preset">Preset</label>
        <select class="select" id="dc-preset" data-control="preset">
          <option value="voice" selected>Voice / podcast</option>
          <option value="music">Music</option>
          <option value="gentle">Gentle</option>
          <option value="heavy">Heavy</option>
          <option value="custom">Custom</option>
        </select>
      </div>

      <div class="field">
        <label class="label" for="dc-threshold">
          Threshold <span class="label__value" data-out="threshold">−20 dB</span>
        </label>
        <div class="slider-row">
          <input
            class="slider"
            id="dc-threshold"
            data-control="threshold"
            type="range"
            min="-60"
            max="0"
            step="1"
            value="-20"
          />
          <input
            class="num"
            data-control="threshold-num"
            type="number"
            min="-60"
            max="0"
            step="1"
            value="-20"
            aria-label="Threshold in decibels"
          />
        </div>
        <span class="hint">
          Where the compressor starts working. Louder than this gets turned down; quieter than
          this passes through untouched.
        </span>
      </div>

      <div class="field">
        <label class="label" for="dc-ratio">
          Ratio <span class="label__value" data-out="ratio">4.0:1</span>
        </label>
        <div class="slider-row">
          <input
            class="slider"
            id="dc-ratio"
            data-control="ratio"
            type="range"
            min="1"
            max="20"
            step="0.5"
            value="4"
          />
          <input
            class="num"
            data-control="ratio-num"
            type="number"
            min="1"
            max="20"
            step="0.5"
            value="4"
            aria-label="Compression ratio"
          />
        </div>
        <span class="hint">
          How firmly it is held. At 4:1, four decibels above the threshold come out as one.
          Past 10:1 you have a limiter.
        </span>
      </div>

      <div class="field">
        <label class="label" for="dc-attack">
          Attack <span class="label__value" data-out="attack">5 ms</span>
        </label>
        <div class="slider-row">
          <input
            class="slider"
            id="dc-attack"
            data-control="attack"
            type="range"
            min="0"
            max="200"
            step="1"
            value="5"
          />
          <input
            class="num"
            data-control="attack-num"
            type="number"
            min="0"
            max="200"
            step="1"
            value="5"
            aria-label="Attack time in milliseconds"
          />
        </div>
        <span class="hint">
          How long it waits before clamping down. Fast removes the bite of consonants and
          drum hits; 15–30 ms leaves the punch intact.
        </span>
      </div>

      <div class="field">
        <label class="label" for="dc-release">
          Release <span class="label__value" data-out="release">120 ms</span>
        </label>
        <div class="slider-row">
          <input
            class="slider"
            id="dc-release"
            data-control="release"
            type="range"
            min="10"
            max="1000"
            step="10"
            value="120"
          />
          <input
            class="num"
            data-control="release-num"
            type="number"
            min="10"
            max="1000"
            step="10"
            value="120"
            aria-label="Release time in milliseconds"
          />
        </div>
        <span class="hint">
          How long it takes to let go again. Too short and the noise floor breathes between
          words; too long and one loud moment ducks everything after it.
        </span>
      </div>

      <div class="field">
        <label class="label" for="dc-knee">
          Knee <span class="label__value" data-out="knee">6 dB</span>
        </label>
        <div class="slider-row">
          <input
            class="slider"
            id="dc-knee"
            data-control="knee"
            type="range"
            min="0"
            max="40"
            step="1"
            value="6"
          />
          <input
            class="num"
            data-control="knee-num"
            type="number"
            min="0"
            max="40"
            step="1"
            value="6"
            aria-label="Knee width in decibels"
          />
        </div>
        <span class="hint">
          How gradually the ratio comes in around the threshold. 0 dB switches abruptly;
          10 dB and up eases in and suits voices.
        </span>
      </div>

      <div class="field">
        <label class="label" for="dc-makeup">
          Makeup gain <span class="label__value" data-out="makeup">+5.5 dB</span>
        </label>
        <div class="slider-row">
          <input
            class="slider"
            id="dc-makeup"
            data-control="makeup"
            type="range"
            min="0"
            max="24"
            step="0.5"
            value="5.5"
          />
          <input
            class="num"
            data-control="makeup-num"
            type="number"
            min="0"
            max="24"
            step="0.5"
            value="5.5"
            aria-label="Makeup gain in decibels"
          />
        </div>
        <span class="hint">
          Compression lowers the peaks, so this puts the level back. About two thirds of the
          gain reduction keeps the file as loud as it was; all of it can clip a loud file.
        </span>
      </div>
    </div>
  </ToolShell>

  <Fragment slot="about">
    <h2>What a compressor is actually doing</h2>
    <p>
      A compressor is an automatic volume control with a rule. It watches the level of the
      signal, and whenever that level rises above the <strong>threshold</strong> it turns the
      signal down. Not all the way down, only by the fraction set by the
      <strong>ratio</strong>. At 4:1, four decibels of input above the threshold come out as
      one. Below the threshold nothing happens at all, so quiet passages are passed through
      exactly as they arrived.
    </p>
    <p>
      The consequence is that the distance between the loudest and quietest parts of the
      recording shrinks. That is the entire point. A file where someone leans into the
      microphone and then drifts away is unusable not because it is too loud or too quiet but
      because it is both, in the same file. Pull the peaks down, then use
      <strong>makeup gain</strong> to lift the whole thing back up, and the quiet parts finish
      louder than they started while the loud parts land roughly where they were.
    </p>

    <h2>Attack and release, the two people get wrong</h2>
    <p>
      Attack is how long the compressor waits before clamping down once the signal crosses the
      threshold. Release is how long it takes to let go afterwards. Both are measured in
      milliseconds, and both change the character of a recording far more than the ratio does.
    </p>
    <p>
      A very fast attack of one to three milliseconds catches the initial transient of every
      consonant, drum hit and pick stroke. That transient is where most of the perceived
      clarity lives, which is why heavily compressed material sounds soft and far away.
      Setting the attack to 15–30 ms lets the transient escape and compresses only the body of
      the sound behind it, which controls the level while keeping the punch.
    </p>
    <p>
      Release is where the audible artefacts come from. Too short, and the compressor fully
      recovers during every pause, so the room noise under the voice swells and drops with
      each syllable. The effect usually described as pumping or breathing. Too long, and it
      never recovers, so a single loud moment holds everything after it down for seconds. For
      speech, 100–250 ms is a dependable range. For music, a release roughly in step with the
      tempo stops the compressor fighting the groove.
    </p>

    <h2>When not to compress</h2>
    <p>
      If the only problem is that a file is quiet from end to end, compression is the wrong
      tool: that is a gain or loudness-normalization job and it costs you nothing in dynamics.
      If a recording is dynamic on purpose. A classical performance, a sound effect, anything
      where the contrast is the content. Compressing it removes the thing that made it work.
      And if you are delivering to a streaming platform, they normalize loudness at playback,
      so compressing harder to be louder does not make you louder. It makes you flatter, at
      the same volume as everybody else.
    </p>
  </Fragment>
</ToolPage>

<style>
  .curve {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--s4);
    padding: var(--s4);
    border-radius: var(--r-md);
    background: var(--stage-2, var(--surface));
  }

  /* Square on purpose: input and output share one scale, and a stretched box
     would make a 1:1 line look like something other than 45 degrees. */
  .curve__canvas {
    width: 300px;
    height: 300px;
    max-width: 100%;
    flex: none;
    display: block;
  }

  .curve__facts {
    flex: 1 1 12rem;
    display: grid;
    align-content: start;
    gap: var(--s3);
    margin: 0;
  }

  .curve__fact {
    display: grid;
    gap: 2px;
  }

  .curve__fact dt {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--stage-ink-2, var(--ink-2));
  }

  .curve__fact dd {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--stage-ink, var(--ink));
    font-variant-numeric: tabular-nums;
  }

  .curve__note {
    margin: 0;
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--stage-ink-2, var(--ink-2));
  }

  @media (max-width: 560px) {
    .curve__canvas {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
    }
  }
</style>

<script>
  import { createTool } from '../lib/tool';
  import { applyCompressor, compressorCurve } from '../lib/audio/effects';
  import { peakDb } from '../lib/audio/analysis';
  import { db } from '../lib/format';
  import { panelColors, panelContext } from '../lib/canvas';

  interface Params {
    threshold: number;
    ratio: number;
    attack: number;
    release: number;
    knee: number;
    makeup: number;
  }

  /** Axis range, in dB. Below -60 nothing useful is happening. */
  const FLOOR = -60;

  /**
   * Where the clip warning starts, in dBFS sample peak. A decibel under full
   * scale is room for an MP3 or AAC encoder, which can put peaks back above
   * where they sat in the render. It is also the cap the presets' makeup was
   * tuned to, so none of them sets it off on a full-level song.
   */
  const CEILING = -1;

  /**
   * The compressor's transfer function, in dB, makeup included.
   *
   * This is the curve the Web Audio DynamicsCompressorNode runs, taken from the
   * same module that renders the file rather than redrawn from the textbook:
   * below the threshold the signal passes through, from the threshold up to
   * threshold + knee it bends over, and above that the excess is divided by the
   * ratio. The knee sits above the threshold, not centred on it, because that
   * is where the node puts it. applyCompressor cancels the node's own hidden
   * makeup gain, so the makeup slider is the only lift, and the drawing is a
   * description of what will actually happen rather than an illustration of
   * the idea.
   */
  function transfer(p: Params): (input: number) => number {
    const curve = compressorCurve(p.threshold, p.knee, p.ratio);
    return (input) => curve(input) + p.makeup;
  }

  /** Every setting but makeup, which is a plain gain after the compressor. */
  function sameCompression(a: Params, b: Params): boolean {
    return (
      a.threshold === b.threshold &&
      a.ratio === b.ratio &&
      a.attack === b.attack &&
      a.release === b.release &&
      a.knee === b.knee
    );
  }

  /**
   * Where this recording actually sits, as a dB level on the curve's own scale.
   *
   * The node's detector follows the largest absolute sample across all
   * channels, so this is a sample peak too: the 95th percentile of the peaks of
   * 50 ms windows. It was the RMS of the first channel, which sits 3 dB under
   * the peak of a sine and 6–12 dB under it on a mastered song, so the dot
   * landed low on the curve and the readout understated the reduction: 3.3 dB
   * for a -10 dBFS sine at the voice settings, where the node takes 5.4. On
   * songs and speech this now reads a median 1–3 dB more than the node takes on
   * average, since the attack lets the start of each peak through; the RMS
   * figure read 1–4 dB less. The 95th percentile rather than the loudest
   * window, because one stray transient would put the marker somewhere the
   * material almost never reaches. Silence is excluded so a long fade-in does
   * not drag the answer down.
   */
  function typicalLevel(buffer: AudioBuffer): number {
    const window = Math.max(1, Math.floor(buffer.sampleRate * 0.05));
    const channels = Array.from({ length: buffer.numberOfChannels }, (_, c) =>
      buffer.getChannelData(c)
    );
    const levels: number[] = [];
    for (let start = 0; start + window <= buffer.length; start += window) {
      let peak = 0;
      for (const channel of channels) {
        for (let i = start; i < start + window; i += 1) {
          const sample = Math.abs(channel[i]!);
          if (sample > peak) peak = sample;
        }
      }
      if (peak > 1e-5) levels.push(20 * Math.log10(peak));
    }
    if (levels.length === 0) return FLOOR;
    levels.sort((a, b) => a - b);
    return levels[Math.min(levels.length - 1, Math.floor(levels.length * 0.95))]!;
  }

  function drawCurve(canvas: HTMLCanvasElement, p: Params, level: number): void {
    const cssSize = canvas.clientWidth;
    if (cssSize < 1) return;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const size = Math.round(cssSize * dpr);
    if (canvas.width !== size || canvas.height !== size) {
      canvas.width = size;
      canvas.height = size;
    }

    const context = panelContext(canvas);
    if (!context) return;
    context.clearRect(0, 0, size, size);

    const { ink, hue } = panelColors(canvas.closest('[data-curve-panel]') ?? canvas);

    const pad = 26 * dpr;
    const plot = size - pad * 2;
    const x = (dB: number) => pad + ((dB - FLOOR) / -FLOOR) * plot;
    const y = (dB: number) => pad + plot - ((Math.max(FLOOR, Math.min(0, dB)) - FLOOR) / -FLOOR) * plot;

    // Grid every 12 dB, labelled down the left and along the bottom.
    context.lineWidth = dpr;
    context.font = `${10 * dpr}px system-ui, sans-serif`;
    context.fillStyle = `color-mix(in oklch, ${ink} 45%, transparent)`;
    for (let dB = FLOOR; dB <= 0; dB += 12) {
      context.strokeStyle = `color-mix(in oklch, ${ink} 9%, transparent)`;
      context.beginPath();
      context.moveTo(x(dB), pad);
      context.lineTo(x(dB), pad + plot);
      context.moveTo(pad, y(dB));
      context.lineTo(pad + plot, y(dB));
      context.stroke();

      context.textAlign = 'center';
      context.fillText(String(dB), x(dB), pad + plot + 15 * dpr);
      context.textAlign = 'right';
      context.fillText(String(dB), pad - 6 * dpr, y(dB) + 3.5 * dpr);
    }

    // Unity, dashed: the line the signal would follow untouched. Every bend in
    // the solid curve is readable only against it.
    context.setLineDash([4 * dpr, 4 * dpr]);
    context.strokeStyle = `color-mix(in oklch, ${ink} 28%, transparent)`;
    context.beginPath();
    context.moveTo(x(FLOOR), y(FLOOR));
    context.lineTo(x(0), y(0));
    context.stroke();
    context.setLineDash([]);

    // Threshold, marked on the input axis where the bend begins.
    context.strokeStyle = `color-mix(in oklch, ${ink} 30%, transparent)`;
    context.beginPath();
    context.moveTo(x(p.threshold), pad);
    context.lineTo(x(p.threshold), pad + plot);
    context.stroke();
    context.fillStyle = `color-mix(in oklch, ${ink} 55%, transparent)`;
    context.textAlign = 'left';
    context.fillText('threshold', x(p.threshold) + 5 * dpr, pad + 11 * dpr);

    // The curve itself.
    const curve = transfer(p);
    context.beginPath();
    for (let i = 0; i <= 240; i += 1) {
      const input = FLOOR + (i / 240) * -FLOOR;
      const point = curve(input);
      if (i === 0) context.moveTo(x(input), y(point));
      else context.lineTo(x(input), y(point));
    }
    context.strokeStyle = hue;
    context.lineWidth = 2.5 * dpr;
    context.lineJoin = 'round';
    context.stroke();

    // Where this file lands on it.
    if (level > FLOOR) {
      const out = curve(level);
      context.setLineDash([3 * dpr, 3 * dpr]);
      context.lineWidth = dpr;
      context.strokeStyle = `color-mix(in oklch, ${ink} 40%, transparent)`;
      context.beginPath();
      context.moveTo(x(level), pad + plot);
      context.lineTo(x(level), y(out));
      context.lineTo(pad, y(out));
      context.stroke();
      context.setLineDash([]);

      context.beginPath();
      context.arc(x(level), y(out), 5 * dpr, 0, Math.PI * 2);
      context.fillStyle = ink;
      context.fill();
    }
  }

  /**
   * Attack and release are in milliseconds here; the node wants seconds.
   *
   * The makeup is measured, not guessed. Each preset gets the makeup that puts
   * its own material back at the integrated loudness it came in at (the median
   * over 7 speech recordings for voice, 14 mastered songs for the rest), unless
   * that would take one of those songs above -1 dBFS sample peak or 0 dBTP, in
   * which case it stops at the last half decibel that does not. Rendered in
   * Chromium:
   *
   *   voice   5.5   speech lands at its own loudness (median +0.2 LU); no
   *                 song peaks above -3.0 dBFS
   *   music   3     loudness wants 4.6, but one song already peaks at
   *                 -1.2 dBFS here
   *   gentle  0     it takes so little off that a song's peaks come down only
   *                 to -0.8 dBFS, so there is no room for any makeup
   *   heavy   14.5  loudness wants 17.4; one song peaks at -1.6 dBFS and
   *                 -0.2 dBTP here
   *
   * These were 4, 3, 1.5 and 8 while the node still added its own 8–15 dB on
   * top. Once that was cancelled, voice left speech 1.3 LU quieter and songs
   * 4 LU quieter, heavy took 9 LU off a song, and gentle put 11 of the 14
   * songs over 0 dBFS.
   */
  const PRESETS: Record<string, Params> = {
    voice: { threshold: -20, ratio: 4, attack: 5, release: 120, knee: 6, makeup: 5.5 },
    music: { threshold: -18, ratio: 3, attack: 15, release: 250, knee: 10, makeup: 3 },
    gentle: { threshold: -12, ratio: 2, attack: 20, release: 300, knee: 12, makeup: 0 },
    heavy: { threshold: -28, ratio: 10, attack: 2, release: 80, knee: 3, makeup: 14.5 },
  };

  /**
   * Told the sample peak, in dBFS, of every render (preview or export) with
   * the file and settings it came from. onReady points it at the readout.
   */
  let onRendered: ((source: AudioBuffer, p: Params, peak: number) => void) | null = null;

  const tool = createTool({
    suffix: 'compressed',
    defaultFormat: 'mp3',

    agent: {
      name: 'set_compressor',
      description:
        'Set the compressor: pick a preset, or set the threshold in dB, the ratio, attack and release in ms, the knee width in dB and the makeup gain in dB by hand. Moving any slider switches the preset to custom. The transfer curve, the gain-reduction readout and the preview update at once; nothing is saved.',
      params: [
        {
          key: 'preset',
          control: 'preset',
          description:
            'A starting point that sets every slider: voice (speech and podcasts), music, gentle (least destructive) or heavy (limiter-like). custom leaves the sliders as they are.',
          type: 'string',
          enum: ['voice', 'music', 'gentle', 'heavy', 'custom'],
        },
        {
          key: 'thresholdDb',
          control: 'threshold',
          description:
            'Level in dB where compression starts, -60 to 0. Louder than this is turned down; quieter passes through untouched.',
          type: 'number',
          min: -60,
          max: 0,
        },
        {
          key: 'ratio',
          control: 'ratio',
          description:
            'How firmly the excess is held, 1 to 20 in steps of 0.5. At 4, four decibels over the threshold come out as one; past 10 it acts as a limiter.',
          type: 'number',
          min: 1,
          max: 20,
        },
        {
          key: 'attackMs',
          control: 'attack',
          description:
            'How long it waits before clamping down, in ms, 0 to 200. 15 to 30 keeps the punch of consonants and drum hits.',
          type: 'number',
          min: 0,
          max: 200,
        },
        {
          key: 'releaseMs',
          control: 'release',
          description:
            'How long it takes to let go again, in ms, 10 to 1000 in steps of 10. Too short breathes between words; too long ducks everything after one loud moment.',
          type: 'number',
          min: 10,
          max: 1000,
        },
        {
          key: 'kneeDb',
          control: 'knee',
          description:
            'How gradually the ratio comes in around the threshold, in dB, 0 to 40. 0 switches abruptly; 10 and up eases in and suits voices.',
          type: 'number',
          min: 0,
          max: 40,
        },
        {
          key: 'makeupDb',
          control: 'makeup',
          description:
            'Gain added after compression to put the level back, in dB, 0 to 24 in steps of 0.5. About two thirds of the gain reduction keeps the loudness where it was; all of it can clip a file that already peaks near 0 dB.',
          type: 'number',
          min: 0,
          max: 24,
        },
      ],
    },

    onReady(ctx, runtime) {
      const root = runtime.root;
      const preset = root.querySelector<HTMLSelectElement>('[data-control="preset"]');
      const setters: Record<string, (value: number) => void> = {};

      const canvas = root.querySelector<HTMLCanvasElement>('[data-curve]');
      const factLevel = root.querySelector<HTMLElement>('[data-fact-level]');
      const factGr = root.querySelector<HTMLElement>('[data-fact-gr]');
      const factOut = root.querySelector<HTMLElement>('[data-fact-out]');
      const factPeak = root.querySelector<HTMLElement>('[data-fact-peak]');
      const factNote = root.querySelector<HTMLElement>('[data-fact-note]');

      // Measured once: the file does not change while the sliders move.
      const level = typicalLevel(ctx.buffer);

      /** The last render of this file whose compression still matches the controls. */
      let measured: { params: Params; peak: number } | null = null;

      const current = (): Params => ({
        threshold: runtime.value('threshold', -20),
        ratio: runtime.value('ratio', 4),
        attack: runtime.value('attack', 5),
        release: runtime.value('release', 120),
        knee: runtime.value('knee', 6),
        makeup: runtime.value('makeup', 5.5),
      });

      const dbText = (value: number): string =>
        `${value < 0 ? '−' : ''}${Math.abs(value).toFixed(1)} dB`;

      const dbfsText = (value: number): string =>
        `${value > 0 ? '+' : value < 0 ? '−' : ''}${Math.abs(value).toFixed(1)} dBFS`;

      /**
       * The loudest sample the export will have, or null when the controls
       * have moved since the last render and no new one has landed yet.
       *
       * The clip warning used to read the curve at the material's typical
       * level, and real exports peak well above that: the attack lets the
       * start of each peak through before the gain comes down, so on songs and
       * speech the export peaked a median 2–5 dB above the estimate by preset,
       * and 8.5 dB above it for heavy on a punchy song. A file could clip with
       * no warning. The preview renders the whole file through the same
       * applyCompressor as the export, so its peak is the export's peak.
       * Makeup is a plain gain after the compressor, so the peak follows it
       * decibel for decibel and stays exact while that slider moves; any other
       * control changes what gets through, so the figure waits for the render.
       */
      const exportPeak = (p: Params): number | null =>
        measured && sameCompression(measured.params, p)
          ? measured.peak + p.makeup - measured.params.makeup
          : null;

      /**
       * Only makeup the user added is worth a warning. Without it the
       * compressor can only turn the file down, so a peak above the ceiling
       * at 0 dB makeup was already in the file (gentle leaves one song at
       * -0.8 dBFS), and the slider cannot go lower anyway.
       */
      const clipNote = (peak: number, makeup: number): string | null => {
        if (peak <= CEILING || makeup <= 0) return null;
        // The highest half-decibel step that brings the peak under the ceiling.
        const to = Math.max(0, Math.floor((makeup - (peak - CEILING)) * 2) / 2);
        const fix = `Lower the makeup gain by ${(makeup - to).toFixed(1)} dB, to ${db(to)}.`;
        return peak > 0
          ? `The export peaks at ${dbfsText(peak)}, so it will clip. ${fix}`
          : `The export peaks at ${dbfsText(peak)}, close enough to clip once it is encoded. ${fix}`;
      };

      /** Redrawn on every move; it is 240 points of arithmetic, so it is free. */
      const repaint = (): void => {
        const p = current();
        if (canvas) drawCurve(canvas, p, level);

        // Reduction is measured against unity at the same input, which is the
        // only definition that stays honest once makeup gain is in the picture.
        const out = transfer(p)(level);
        const reduction = level + p.makeup - out;
        const peak = exportPeak(p);
        const clipping = peak === null ? null : clipNote(peak, p.makeup);

        if (factLevel) factLevel.textContent = level <= FLOOR ? '—' : dbText(level);
        if (factGr) {
          factGr.textContent = level <= FLOOR ? '—' : `${reduction < 0.05 ? '0.0' : `−${reduction.toFixed(1)}`} dB`;
        }
        if (factOut) factOut.textContent = level <= FLOOR ? '—' : dbText(out);
        if (factPeak) {
          factPeak.textContent = peak === null || !Number.isFinite(peak) ? '—' : dbfsText(peak);
        }
        if (factNote) {
          factNote.textContent =
            clipping ??
            (reduction < 0.1
              ? 'The threshold is above where this recording sits, so nothing is being compressed. Lower it until the dot crosses the bend.'
              : reduction > 12
                ? 'More than 12 dB of reduction is a heavy effect rather than a correction. Expect to hear it working.'
                : 'The dot is where this recording sits on the curve, and the drop from the dashed line is what it loses.');
        }
      };

      // A render that lands after the controls have moved on describes
      // settings nobody is looking at, and one from a file replaced since
      // describes another file.
      onRendered = (source, params, peak): void => {
        if (source !== ctx.buffer || !sameCompression(params, current())) return;
        measured = { params, peak };
        repaint();
      };

      /** Slider and number input stay in step; the slider is authoritative. */
      const pair = (name: string, format: (value: number) => string): void => {
        const slider = root.querySelector<HTMLInputElement>(`[data-control="${name}"]`);
        const num = root.querySelector<HTMLInputElement>(`[data-control="${name}-num"]`);
        const out = root.querySelector<HTMLElement>(`[data-out="${name}"]`);
        if (!slider) return;

        const paint = (): void => {
          if (out) out.textContent = format(Number(slider.value));
          repaint();
        };

        // A compressor pass is a full offline render, so it waits for the
        // slider to be released rather than firing on every pixel.
        const commit = (): void => runtime.refreshPreview();

        // Moving a control by hand means the preset no longer describes it.
        const detach = (): void => {
          if (preset) preset.value = 'custom';
        };

        slider.addEventListener('input', () => {
          if (num) num.value = slider.value;
          detach();
          paint();
        });
        slider.addEventListener('change', commit);

        num?.addEventListener('input', () => {
          slider.value = num.value;
          detach();
          paint();
        });
        num?.addEventListener('change', commit);

        setters[name] = (value: number): void => {
          slider.value = String(value);
          if (num) num.value = String(value);
          paint();
        };

        paint();
      };

      pair('threshold', (value) => `${value < 0 ? '−' : ''}${Math.abs(value).toFixed(0)} dB`);
      pair('ratio', (value) => `${value.toFixed(1)}:1`);
      pair('attack', (value) => `${Math.round(value)} ms`);
      pair('release', (value) => `${Math.round(value)} ms`);
      pair('knee', (value) => `${Math.round(value)} dB`);
      pair('makeup', (value) => db(value));

      preset?.addEventListener('change', () => {
        const chosen = PRESETS[preset.value];
        if (!chosen) return;
        // Setting .value in code fires no input event, so the "custom" fallback
        // above does not trip and the select keeps the name just chosen.
        for (const [name, value] of Object.entries(chosen)) {
          setters[name]?.(value);
        }
        repaint();
        runtime.refreshPreview();
      });

      // First paint waits for layout, since the canvas has no width until the
      // workspace is on screen.
      requestAnimationFrame(repaint);
      const panel = root.querySelector<HTMLElement>('[data-curve-panel]');
      if (panel) new ResizeObserver(repaint).observe(panel);
    },

    preview(ctx) {
      return render(ctx.buffer);
    },

    process(ctx) {
      return render(ctx.buffer);
    },
  });

  async function render(buffer: AudioBuffer): Promise<AudioBuffer> {
    const p: Params = {
      threshold: tool?.value('threshold', -20) ?? -20,
      ratio: tool?.value('ratio', 4) ?? 4,
      attack: tool?.value('attack', 5) ?? 5,
      release: tool?.value('release', 120) ?? 120,
      knee: tool?.value('knee', 6) ?? 6,
      makeup: tool?.value('makeup', 5.5) ?? 5.5,
    };
    const out = await applyCompressor(buffer, {
      ...p,
      attack: p.attack / 1000,
      release: p.release / 1000,
    });
    onRendered?.(buffer, p, peakDb(out));
    return out;
  }
</script>
