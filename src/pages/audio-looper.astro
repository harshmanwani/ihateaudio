---
import ToolPage from '../layouts/ToolPage.astro';
import ToolShell from '../components/ToolShell.astro';
import { getTool } from '../data/tools';

const tool = getTool('audio-looper');

const steps = [
  'Drop the clip you want repeated. Trim it first if the start or end is ragged. A loop exposes every flaw at its edges, over and over.',
  'Set how many times it should repeat. The running total next to the heading updates as you drag, so you can aim for a length rather than guess at a count.',
  'Add a gap if the repeats should not run straight into each other. Gaps go between repeats, so the file still ends on audio rather than on silence.',
  'Choose a format and download. The repeats are copies of the same samples, so the file gets longer without getting any worse.',
];

const faq = [
  {
    q: 'Will the loop be seamless?',
    a: 'Only if your clip already is. This tool joins the end of one repeat straight onto the start of the next with nothing in between, so the join is as clean as the clip. If the clip ends mid-note or has a few frames of silence at the front, you will hear that once per repeat. Trim it to the exact loop point first, then come back.',
  },
  {
    q: 'How many repeats can I ask for before it fails?',
    a: 'The limit is memory, and it is easy to work out. Decoded audio costs roughly 21 MB per minute of 44.1 kHz stereo, and the whole result must exist in the tab at once. Thirty repeats of a four-minute track is two hours, which is around 2.5 GB. More than most browser tabs will give you. Thirty repeats of a ten-second loop is five minutes and about 105 MB, which is nothing. Short clips are where this tool lives.',
  },
  {
    q: 'Is there a gap after the final repeat?',
    a: 'No. The gap is defined as the space between repeats, so a file with five repeats and a two-second gap contains four gaps, not five. The audio ends the moment the last repeat does. If you actually want silence on the end (for a hold-music file that should pause before the player restarts it) add it with the trimmer, or set the gap and accept that the loop point is now inside the file.',
  },
  {
    q: 'Why build a long file instead of just pressing repeat in a player?',
    a: 'Because plenty of places have no repeat button. Video editors, presentation software, kiosk displays, phone systems, exhibition installations and most embedded players simply play a file once. A twenty-minute file made from a thirty-second bed solves that without any of them having to cooperate.',
  },
  {
    q: 'Does each repeat lose a bit of quality?',
    a: 'No. Every repeat is a copy of the same decoded samples, so repeat forty is identical to repeat one. Encoding happens once at the end, to the whole result, exactly as it would for any other export. Quality does not compound with repetition here, only file size does.',
  },
  {
    q: 'Can I make a file that loops forever?',
    a: 'A file has a length, so no. What you can do is make one that loops seamlessly and let the player repeat it: on a web page that is the loop attribute on an audio element, in a game engine it is a flag on the sound asset. Building a long file is the workaround for the cases where no such flag exists.',
  },
  {
    q: 'How big will the exported file be?',
    a: 'Close to linear with the repeat count. Ten repeats of a 1 MB MP3 lands near 10 MB, give or take the encoder finding the repetition slightly cheaper to describe. Gaps are nearly free in a lossy format and cost full price in WAV, where every second of silence takes exactly as many bytes as a second of music.',
  },
];
---

<ToolPage slug={tool.slug} steps={steps} faq={faq}>
  <ToolShell tool={tool} action="Download looped audio">
    <div class="controls">
      <div class="controls__head">
        <span class="controls__title">Repeats</span>
        <span class="hint" data-total>Set a count to see the resulting length.</span>
      </div>

      {/*
        The seam, magnified.

        Everything above says a loop is only as good as the clip's two edges, and
        then leaves you to find out by listening to the export. This is the same
        claim made checkable before you download: the end of the clip and the start
        of the next copy, side by side at a quarter of a second across, with the
        join marked and the two levels measured. A step at the join is a click and
        it is visible as one. Raising the gap pushes silence into the middle, which
        is the other thing people come here to try.
      */}
      <div class="seam controls__full" data-seam-panel>
        <canvas class="seam__canvas" data-seam aria-hidden="true"></canvas>
        <p class="seam__caption" data-seam-caption>Reading the loop point…</p>
      </div>

      <div class="field">
        <label class="label" for="loop-times">
          Number of repeats
          <span class="label__value" data-out="times">2</span>
        </label>
        <div class="slider-row">
          <input
            class="slider"
            id="loop-times"
            data-control="times"
            type="range"
            min="2"
            max="50"
            step="1"
            value="2"
          />
          <input
            class="num"
            data-control="times-num"
            type="number"
            min="2"
            max="50"
            step="1"
            value="2"
            aria-label="Number of repeats"
          />
        </div>
      </div>

      <div class="field">
        <label class="label" for="loop-gap">
          Gap between repeats
          <span class="label__value" data-out="gap">0.0 s</span>
        </label>
        <div class="slider-row">
          <input
            class="slider"
            id="loop-gap"
            data-control="gap"
            type="range"
            min="0"
            max="5"
            step="0.1"
            value="0"
          />
          <input
            class="num"
            data-control="gap-num"
            type="number"
            min="0"
            max="5"
            step="0.1"
            value="0"
            aria-label="Gap between repeats in seconds"
          />
        </div>
      </div>

      <div class="note note--warn controls__full" data-heavy hidden>
        <div class="note__body" data-heavy-text></div>
      </div>
    </div>
  </ToolShell>

  <Fragment slot="about">
    <h2>What makes a loop seamless</h2>
    <p>
      A loop is seamless when the end of the clip and the start of the clip are
      interchangeable. Same level, same phase, same musical position. Repetition
      does not create that property; it only reveals whether you already had it.
      Everything this tool can do is join copies together perfectly, and it does,
      so any bump you hear at the loop point was in the clip before it arrived
      here.
    </p>
    <p>
      For music, the boundary you want is almost always a bar line, and bar lengths
      are arithmetic rather than judgement. One bar of 4/4 lasts 60 ÷ BPM × 4
      seconds: exactly 2 seconds at 120 BPM, 1.875 at 128, about 1.379 at 174.
      Trim the clip to a whole number of bars at that length and the loop will sit
      right. If you do not know the tempo, the BPM detector will tell you, and the
      trimmer's timecode fields accept hundredths of a second, which is finer than
      the error you would hear.
    </p>
    <p>
      For everything else (room tone, rain, machinery, a synth pad) the rule is
      to cut where the waveform crosses zero and the content is unremarkable. A
      loop point in the middle of a bird call announces itself once a cycle; the
      same point two seconds later, in flat background, does not.
    </p>

    <h2>Where the gaps go</h2>
    <p>
      Gap length is measured between repeats, and there is deliberately no gap
      after the last one. That means five repeats with a two-second gap produce four
      gaps, and the file ends the instant the fifth repeat does. This is the
      behaviour you want almost always: a file that ends on silence looks longer
      than it is in every editor, and the trailing pause turns into an awkward hole
      when the file is dropped onto a timeline.
    </p>
    <p>
      Gaps are digital silence, not a fade, so they are only useful when the clip
      already ends cleanly. A practice loop with two seconds between passes is the
      classic use. Long enough to reset your hands, short enough to keep the tempo
      in your head. For a continuous bed, leave the gap at zero.
    </p>

    <h2>Knowing when to stop</h2>
    <p>
      The whole result is assembled in memory before anything is encoded, so length
      has a hard ceiling that depends on your device rather than on the tool. At
      roughly 21 MB per minute of 44.1 kHz stereo, half an hour of output is about
      630 MB of working memory, and browsers begin refusing allocations somewhere
      above that on most machines and much sooner on phones.
    </p>
    <p>
      Two things buy you room. A mono source halves the cost immediately, which is
      free if the clip is a voice or a mono sound effect. And a shorter source loop
      repeated more times costs exactly the same as a longer one repeated fewer
      times. It is total output length that matters, not the count. If you need
      hours of ambience, generate twenty minutes here and let whatever plays it
      repeat that.
    </p>
  </Fragment>
</ToolPage>

<style>
  .seam {
    padding: var(--s4);
    border-radius: var(--r-md);
    background: var(--stage-2, var(--surface));
    display: flex;
    flex-direction: column;
    gap: var(--s3);
  }

  .seam__canvas {
    width: 100%;
    height: 172px;
    display: block;
  }

  .seam__caption {
    margin: 0;
    font-size: var(--t-small);
    color: var(--stage-ink-2);
    max-width: var(--prose);
  }

  @media (max-width: 560px) {
    .seam__canvas {
      height: 150px;
    }
  }
</style>

<script>
  import { createTool } from '../lib/tool';
  import { loop, slice } from '../lib/audio/dsp';
  import { duration as fmtDuration, filesize } from '../lib/format';
  import { panelColors, panelContext } from '../lib/canvas';

  /** How much of each side of the join to show. */
  const SEAM_WINDOW = 0.25;
  /** The window the level match is measured over, short enough to be "the edge". */
  const EDGE_WINDOW = 0.05;

  /** Loudest sample in a range, across all channels. */
  function peakBetween(buffer: AudioBuffer, from: number, to: number): number {
    let peak = 0;
    const start = Math.max(0, Math.min(buffer.length - 1, from));
    const end = Math.max(start, Math.min(buffer.length, to));
    for (let c = 0; c < buffer.numberOfChannels; c += 1) {
      const data = buffer.getChannelData(c);
      for (let i = start; i < end; i += 1) {
        const value = Math.abs(data[i]!);
        if (value > peak) peak = value;
      }
    }
    return peak;
  }

  /** Average level in a range, across all channels. */
  function rmsBetween(buffer: AudioBuffer, from: number, to: number): number {
    const start = Math.max(0, Math.min(buffer.length - 1, from));
    const end = Math.max(start + 1, Math.min(buffer.length, to));
    let sum = 0;
    let count = 0;
    for (let c = 0; c < buffer.numberOfChannels; c += 1) {
      const data = buffer.getChannelData(c);
      for (let i = start; i < end; i += 1) sum += data[i]! * data[i]!;
      count += end - start;
    }
    return count > 0 ? Math.sqrt(sum / count) : 0;
  }

  /** Mean sample value at one instant, which is the step the join would make. */
  function sampleAt(buffer: AudioBuffer, index: number): number {
    const at = Math.max(0, Math.min(buffer.length - 1, index));
    let sum = 0;
    for (let c = 0; c < buffer.numberOfChannels; c += 1) sum += buffer.getChannelData(c)[at]!;
    return sum / buffer.numberOfChannels;
  }

  function drawSeam(
    panel: HTMLElement,
    canvas: HTMLCanvasElement,
    buffer: AudioBuffer,
    times: number,
    gap: number
  ): void {
    const cssWidth = canvas.clientWidth;
    const cssHeight = canvas.clientHeight;
    if (cssWidth < 1 || cssHeight < 1) return;

    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const width = Math.round(cssWidth * dpr);
    const height = Math.round(cssHeight * dpr);
    if (canvas.width !== width || canvas.height !== height) {
      canvas.width = width;
      canvas.height = height;
    }

    const context = panelContext(canvas);
    if (!context) return;
    context.clearRect(0, 0, width, height);

    const { ink, hue } = panelColors(panel);

    const padL = 12 * dpr;
    const padR = 12 * dpr;
    const plotW = width - padL - padR;

    context.font = `${10 * dpr}px system-ui, sans-serif`;
    context.textBaseline = 'middle';

    // ---- The run, as a strip. Thin bars, because fifty repeats is a legitimate
    // setting and the picture should survive it. ----
    const stripY = 8 * dpr;
    const stripH = 16 * dpr;
    const total = times * buffer.duration + gap * (times - 1);
    const sx = (seconds: number) => padL + (seconds / Math.max(0.001, total)) * plotW;

    for (let i = 0; i < times; i += 1) {
      const start = i * (buffer.duration + gap);
      const x0 = sx(start);
      const x1 = sx(start + buffer.duration);
      context.fillStyle = `color-mix(in oklch, ${hue} ${i === 0 ? 55 : 30}%, transparent)`;
      context.fillRect(x0, stripY, Math.max(1.5 * dpr, x1 - x0 - dpr), stripH);
    }

    context.textAlign = 'right';
    context.fillStyle = `color-mix(in oklch, ${ink} 60%, transparent)`;
    context.fillText(fmtDuration(total), padL + plotW, stripY + stripH + 12 * dpr);
    context.textAlign = 'left';
    context.fillStyle = `color-mix(in oklch, ${ink} 45%, transparent)`;
    context.fillText(
      `${times} copies${gap > 0 ? ` with ${gap.toFixed(1)} s between` : ' back to back'}`,
      padL,
      stripY + stripH + 12 * dpr
    );

    // ---- The join itself. ----
    const waveTop = stripY + stripH + 26 * dpr;
    const waveH = height - waveTop - 18 * dpr;
    if (waveH < 24 * dpr) return;
    const mid = waveTop + waveH / 2;

    const side = Math.min(SEAM_WINDOW, buffer.duration / 2);
    const span = side * 2 + gap;
    const jx = (seconds: number) => padL + (seconds / span) * plotW;

    /** Min/max envelope for a sample range, drawn into a pixel range. */
    const envelope = (
      fromSample: number,
      toSample: number,
      x0: number,
      x1: number,
      colour: string
    ): void => {
      const columns = Math.max(1, Math.round(x1 - x0));
      const perColumn = (toSample - fromSample) / columns;
      context.fillStyle = colour;
      for (let column = 0; column < columns; column += 1) {
        const start = Math.max(0, Math.round(fromSample + column * perColumn));
        const end = Math.min(buffer.length, Math.round(fromSample + (column + 1) * perColumn));
        let low = 0;
        let high = 0;
        for (let c = 0; c < buffer.numberOfChannels; c += 1) {
          const data = buffer.getChannelData(c);
          for (let i = start; i < end; i += 1) {
            const value = data[i]!;
            if (value < low) low = value;
            if (value > high) high = value;
          }
        }
        const yTop = mid - (high * waveH) / 2;
        const yBottom = mid - (low * waveH) / 2;
        context.fillRect(x0 + column, yTop, 1, Math.max(dpr, yBottom - yTop));
      }
    };

    context.strokeStyle = `color-mix(in oklch, ${ink} 12%, transparent)`;
    context.lineWidth = dpr;
    context.beginPath();
    context.moveTo(padL, mid);
    context.lineTo(padL + plotW, mid);
    context.stroke();

    if (gap > 0) {
      context.fillStyle = `color-mix(in oklch, ${ink} 7%, transparent)`;
      context.fillRect(jx(side), waveTop, jx(side + gap) - jx(side), waveH);
    }

    const rate = buffer.sampleRate;
    envelope(
      buffer.length - Math.round(side * rate),
      buffer.length,
      jx(0),
      jx(side),
      `color-mix(in oklch, ${ink} 55%, transparent)`
    );
    envelope(
      0,
      Math.round(side * rate),
      jx(side + gap),
      jx(span),
      hue
    );

    // The join. With no gap it is a single line; with one it is the two edges of
    // the silence, which is what the gap control is actually doing.
    context.strokeStyle = `color-mix(in oklch, ${ink} 50%, transparent)`;
    context.lineWidth = 1.5 * dpr;
    context.setLineDash([4 * dpr, 3 * dpr]);
    context.beginPath();
    context.moveTo(jx(side), waveTop);
    context.lineTo(jx(side), waveTop + waveH);
    if (gap > 0) {
      context.moveTo(jx(side + gap), waveTop);
      context.lineTo(jx(side + gap), waveTop + waveH);
    }
    context.stroke();
    context.setLineDash([]);

    context.fillStyle = `color-mix(in oklch, ${ink} 45%, transparent)`;
    context.textAlign = 'left';
    context.fillText('end of the clip', padL, height - 8 * dpr);
    context.textAlign = 'right';
    context.fillStyle = hue;
    context.fillText('start of the next copy', padL + plotW, height - 8 * dpr);
  }

  const tool = createTool({
    suffix: 'looped',
    defaultFormat: 'mp3',
    agent: {
      name: 'set_loop',
      description:
        'Set how many times the clip repeats and the silence between repeats in seconds. The gap sits between repeats only, so the file still ends on audio. The seam drawing, the total length next to the heading and the memory warning update at once; nothing is saved.',
      params: [
        {
          key: 'repeats',
          control: 'times',
          description:
            'Number of repeats, 2 to 50. Total length is repeats times the clip length, plus one gap fewer than that.',
          type: 'number',
          min: 2,
          max: 50,
        },
        {
          key: 'gapSec',
          control: 'gap',
          description: 'Silence between repeats in seconds, 0 to 5. 0 joins the copies back to back.',
          type: 'number',
          min: 0,
          max: 5,
        },
      ],
    },

    onReady(ctx, runtime) {
      const root = runtime.root;
      const totalOut = root.querySelector<HTMLElement>('[data-total]');
      const heavy = root.querySelector<HTMLElement>('[data-heavy]');
      const heavyText = root.querySelector<HTMLElement>('[data-heavy-text]');
      const source = ctx.buffer;
      const seamPanel = root.querySelector<HTMLElement>('[data-seam-panel]');
      const seamCanvas = root.querySelector<HTMLCanvasElement>('[data-seam]');
      const seamCaption = root.querySelector<HTMLElement>('[data-seam-caption]');

      // Measured once: these are properties of the clip, not of the settings.
      const rate = source.sampleRate;
      const edge = Math.round(EDGE_WINDOW * rate);
      const tailLevel = rmsBetween(source, source.length - edge, source.length);
      const headLevel = rmsBetween(source, 0, edge);
      const levelGap =
        tailLevel > 0 && headLevel > 0
          ? Math.abs(20 * Math.log10(headLevel / tailLevel))
          : Infinity;
      // The discontinuity a butt join would create, as a fraction of full scale.
      const step = Math.abs(sampleAt(source, 0) - sampleAt(source, source.length - 1));
      // A hard cut into silence ticks for the same reason, so the very last few
      // milliseconds matter when a gap is in play.
      const stopLevel = peakBetween(
        source,
        source.length - Math.round(0.005 * rate),
        source.length
      );

      const update = (): void => {
        const times = Math.max(2, Math.round(runtime.value('times', 2)));
        const gap = runtime.value('gap', 0);
        // The gap sits between repeats, so there are times - 1 of them.
        const total = times * source.duration + gap * (times - 1);

        if (seamPanel && seamCanvas) drawSeam(seamPanel, seamCanvas, source, times, gap);

        if (seamCaption) {
          if (gap > 0) {
            seamCaption.textContent =
              stopLevel > 0.05
                ? `The clip is still playing at ${Math.round(stopLevel * 100)}% of full scale when it stops, so cutting straight into ${gap.toFixed(1)} s of silence will tick. A short fade on the end fixes it.`
                : `Silence between the repeats, so the join cannot click. The clip already stops quietly, which is what makes that work.`;
          } else if (step > 0.03) {
            seamCaption.textContent =
              `The two edges are ${Math.round(step * 100)}% of full scale apart, so every ` +
              'repeat starts with a step in the waveform, and a step is a click. Trim the ' +
              'clip so both ends land on a zero crossing, or leave a gap.';
          } else if (levelGap > 4) {
            seamCaption.textContent =
              `The clip ends about ${levelGap.toFixed(0)} dB ${headLevel > tailLevel ? 'quieter than' : 'louder than'} it starts, so each repeat restarts with an audible jump. The join itself is clean; it is the levels that do not match.`;
          } else {
            seamCaption.textContent =
              `The edges meet within ${Number.isFinite(levelGap) ? levelGap.toFixed(1) : '0'} dB of each other and there is no step at the join, so this will loop without a click.`;
          }
        }

        if (totalOut) {
          totalOut.textContent = `${times} repeats · ${fmtDuration(total)} in total`;
        }

        if (heavy && heavyText) {
          const bytes = total * source.sampleRate * source.numberOfChannels * 4;
          const tooBig = total > 1800 || bytes > 700_000_000;
          heavyText.textContent = tooBig
            ? `${fmtDuration(total)} of audio needs about ${filesize(bytes)} of memory while it is built. ` +
              'That is enough to fail on a phone and to be slow on a laptop, try fewer repeats.'
            : '';
          heavy.hidden = !tooBig;
        }
      };

      const bindSlider = (name: string, format: (value: number) => string): void => {
        const slider = root.querySelector<HTMLInputElement>(`[data-control="${name}"]`);
        const num = root.querySelector<HTMLInputElement>(`[data-control="${name}-num"]`);
        const out = root.querySelector<HTMLElement>(`[data-out="${name}"]`);
        if (!slider) return;

        const paint = (): void => {
          const min = Number(slider.min);
          const max = Number(slider.max);
          const span = max - min || 1;
          slider.style.setProperty('--pct', `${((Number(slider.value) - min) / span) * 100}%`);
          if (out) out.textContent = format(Number(slider.value));
        };

        slider.addEventListener('input', () => {
          if (num) num.value = slider.value;
          paint();
          update();
        });

        num?.addEventListener('input', () => {
          slider.value = num.value;
          paint();
          update();
        });

        num?.addEventListener('change', () => {
          if (num) num.value = slider.value;
        });

        paint();
      };

      bindSlider('times', (value) => String(Math.round(value)));
      bindSlider('gap', (value) => `${value.toFixed(1)} s`);

      // The canvas has no width until the workspace is on screen.
      requestAnimationFrame(update);
      if (seamPanel) new ResizeObserver(update).observe(seamPanel);

      update();
    },

    process(ctx) {
      const times = Math.max(2, Math.round(tool?.value('times', 2) ?? 2));
      const gap = tool?.value('gap', 0) ?? 0;
      const looped = loop(ctx.buffer, times, gap);
      if (gap <= 0) return looped;
      // loop() pads every repeat, including the last. Drop the trailing silence
      // so the file ends on audio.
      return slice(looped, 0, Math.max(0.01, looped.duration - gap));
    },
  });
</script>
