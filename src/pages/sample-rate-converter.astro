---
import ToolPage from '../layouts/ToolPage.astro';
import ToolShell from '../components/ToolShell.astro';
import { getTool } from '../data/tools';

const tool = getTool('sample-rate-converter');

const steps = [
  'Drop your audio file onto the page. Its current sample rate is read from the file header and shown below.',
  'Pick the rate the destination system needs. 16 kHz for speech models, 44.1 kHz for CD and music, 48 kHz for anything going into video.',
  'Check the warnings. Choosing a rate higher than the original cannot add detail, and the page says so rather than letting you assume otherwise.',
  'Export as WAV or FLAC to keep the rate exactly as chosen. MP3 supports only a fixed list of rates and will move you to the nearest one.',
];

const faq = [
  {
    q: 'Does converting to a higher sample rate improve quality?',
    a: 'No. Resampling upward interpolates between samples that already exist; it invents plausible values, it does not recover anything. A 22 kHz recording converted to 96 kHz still contains nothing above 11 kHz, because nothing above 11 kHz was ever captured. The only reason to upsample is that a piece of software or hardware refuses to accept the lower rate.',
  },
  {
    q: 'What rate do speech recognition models want?',
    a: '16 kHz mono, almost universally. Whisper and most other speech models resample everything to 16 kHz internally as their first step, so handing them a 48 kHz stereo file just makes them do the work. Converting first makes the file three to six times smaller with no effect on the transcription.',
  },
  {
    q: 'Why is 44.1 kHz such an odd number?',
    a: 'It comes from videotape. Before dedicated digital audio recorders existed, engineers stored digital audio as fake video on U-matic tape using a PCM adaptor. Fitting three samples per usable line worked out to 245 lines at 60 fields per second on NTSC and 294 lines at 50 fields on PAL. Both of which multiply out to exactly 44,100. The CD standard inherited it in 1980 and it never went away.',
  },
  {
    q: 'What is aliasing, and does this tool avoid it?',
    a: 'When you lower the sample rate, frequencies above the new ceiling have nowhere to go and fold back down into the audible range as inharmonic whistles and grit. Proper converters run a steep low-pass filter first to remove them. This tool uses linear interpolation without that filter, which is fine for speech and most spoken-word material, but bright cymbal-heavy music taken down to 22.05 kHz or below can show artifacts. For mastering-grade work, use a DAW or SoX.',
  },
  {
    q: 'Does changing the sample rate change the pitch or the length?',
    a: 'Not here. Resampling recalculates the sample values so the audio occupies the same amount of time at the new rate. What people are usually thinking of is reinterpreting a file at a different rate without recalculating it, which does shift both pitch and length. That is the speed changer, and it is a separate tool.',
  },
  {
    q: 'I chose 96 kHz but the MP3 came out at 48 kHz. Why?',
    a: 'MP3 permits only nine sample rates: 8, 11.025, 12, 16, 22.05, 24, 32, 44.1 and 48 kHz. Anything else is resampled to the nearest permitted rate during encoding, and 96 kHz becomes 48 kHz. Export as WAV or FLAC if you need the rate preserved exactly; both accept any rate.',
  },
  {
    q: 'What do game engines and telephony systems expect?',
    a: 'Unity and Godot are happy with 44.1 or 48 kHz and will often downsample short effects themselves to save memory. Asterisk and most VoIP systems want 8 kHz for narrowband codecs or 16 kHz for wideband. Embedded devices and microcontroller audio libraries frequently insist on 22.05 kHz or 16 kHz mono, and will simply refuse anything else.',
  },
];
---

<ToolPage slug={tool.slug} steps={steps} faq={faq}>
  <ToolShell tool={tool} action="Convert and download">
    <div class="controls">
      <div class="controls__head">
        <span class="controls__title">Sample rate</span>
        <span class="hint" data-source-rate>Read from the file when it loads.</span>
      </div>

      {/*
        The file's own spectrum with the new ceiling drawn across it.

        Nyquist is the one rule that decides everything on this page, and it is
        abstract until you can see what your particular file has sitting above the
        line. Because this converter interpolates rather than filtering first, that
        content does not disappear — it mirrors back down into the audible range,
        so the ghost curve shows exactly where it will land. On a voice note there
        is nothing up there and the picture says so; on a bright mix going to
        22 kHz it is unmistakable, which is the case the prose below is warning
        about.
      */}
      <div class="spectrum controls__full" data-spectrum-panel>
        <canvas class="spectrum__canvas" data-spectrum aria-hidden="true"></canvas>
        <p class="spectrum__caption" data-spectrum-caption>Reading the spectrum…</p>
      </div>

      <div class="field">
        <label class="label" for="target-rate">Convert to</label>
        <select class="select" id="target-rate" data-control="rate">
          <option value="8000">8 kHz, telephone, narrowband VoIP</option>
          <option value="16000">16 kHz, speech models, wideband voice</option>
          <option value="22050">22.05 kHz, half of CD, embedded audio</option>
          <option value="32000">32 kHz, broadcast and DAT long-play</option>
          <option value="44100" selected>44.1 kHz. CD and music standard</option>
          <option value="48000">48 kHz, video, film and pro audio</option>
          <option value="96000">96 kHz, high-resolution production</option>
        </select>
      </div>

      <div class="field">
        <span class="label">Highest frequency it can hold</span>
        <p class="hint" data-nyquist>
          Half the sample rate, which is 22.05 kHz at 44.1 kHz.
        </p>
      </div>

      <div class="controls__full" data-notes hidden>
        <div class="note note--warn" data-upsample-note hidden>
          <div class="note__body">
            <div class="note__title">This is upsampling</div>
            <div data-upsample-text></div>
          </div>
        </div>

        <div class="note note--info" data-mp3-note hidden>
          <div class="note__body">
            <div class="note__title">MP3 cannot store this rate</div>
            <div data-mp3-text></div>
          </div>
        </div>
      </div>
    </div>
  </ToolShell>

  <Fragment slot="about">
    <h2>What the number actually means</h2>
    <p>
      A digital recording is a list of amplitude measurements taken at fixed
      intervals. The sample rate is how many of those measurements happen per
      second, and the Nyquist–Shannon theorem sets the consequence: the highest
      frequency a recording can represent is exactly half its sample rate. At
      44.1 kHz the ceiling is 22.05 kHz, comfortably above the roughly 20 kHz
      limit of good young hearing. At 8 kHz the ceiling is 4 kHz, which is why a
      phone call renders "S" and "F" almost identically, the energy that
      distinguishes those consonants lives above 4 kHz and is simply not there.
    </p>
    <p>
      Everything else about the rate follows from that. Doubling it does not make
      the audio twice as good; it moves a ceiling that was already above your
      hearing further above it, while doubling the storage and the processing
      cost. Where higher rates genuinely help is during production, because
      effects that generate new harmonics, distortion, saturation, aggressive
      compression. Have somewhere to put them before they fold back down.
    </p>

    <h2>Why the standard rates are the numbers they are</h2>
    <p>
      44.1 kHz is an artefact of 1970s video hardware. There were no digital
      audio recorders, so engineers used a PCM adaptor to write digital audio
      onto U-matic videotape as though it were a picture. Three samples per
      usable scan line gave 44,100 samples per second on both NTSC and PAL
      timing, and when the Compact Disc standard was written in 1980 it adopted
      the rate the existing masters were already recorded at.
    </p>
    <p>
      48 kHz came from professional video and film, where it divides cleanly
      against frame rates and leaves slightly more room for anti-aliasing
      filters; it remains the default in every video editor. 32 kHz served
      broadcast and the long-play mode of DAT. 22.05 kHz, exactly half of 44.1,
      was the workhorse of 1990s multimedia and still turns up in embedded
      systems. 16 kHz is the wideband speech rate, adopted by AMR-WB and now by
      practically every speech recognition model. And 8 kHz is the telephone
      network, unchanged since digital trunking arrived in the 1960s.
    </p>

    <h2>What downsampling costs, and what this tool does not do</h2>
    <p>
      Lowering the rate is not free. Any content above the new ceiling has to be
      removed first, and if it is not, it does not vanish, it folds back down
      into the audible range as inharmonic tones. A shimmering cymbal becomes a
      metallic warble; sibilance becomes grit. Proper sample rate converters run
      a steep low-pass filter before discarding samples, precisely to prevent
      this.
    </p>
    <p>
      This tool resamples by linear interpolation and does not apply that filter.
      For speech, voice notes, lectures, podcasts and anything destined for a
      transcription model, the difference is inaudible and the convenience is
      worth it. For bright, dense music going to 22.05 kHz or below, it is not:
      use a DAW, SoX or a dedicated converter with a proper filter. Saying so is
      more useful than pretending otherwise, and it is the one case on this page
      where a desktop tool is genuinely the better answer.
    </p>
  </Fragment>
</ToolPage>

<style>
  .spectrum {
    padding: var(--s4);
    border-radius: var(--r-md);
    background: var(--stage-2, var(--surface));
    display: flex;
    flex-direction: column;
    gap: var(--s3);
  }

  .spectrum__canvas {
    width: 100%;
    height: 190px;
    display: block;
  }

  .spectrum__caption {
    margin: 0;
    font-size: var(--t-small);
    color: var(--stage-ink-2);
    max-width: var(--prose);
  }

  @media (max-width: 560px) {
    .spectrum__canvas {
      height: 160px;
    }
  }
</style>

<script>
  import { createTool } from '../lib/tool';
  import { resampleLinear } from '../lib/audio/dsp';
  import { nearestMp3Rate } from '../lib/audio/encode-mp3';
  import { fft } from '../lib/audio/fft';
  import { hannPeriodic } from '../lib/audio/stft';
  import { panelColors, panelContext } from '../lib/canvas';

  let sourceRate = 0;

  /** Averaged magnitude spectrum of the loaded file, and the rate it was taken at. */
  let spectrum: Float64Array | null = null;

  const FFT_SIZE = 4096;
  /**
   * How many windows to average.
   *
   * Enough to be representative of the whole file rather than of its first
   * second, few enough that a ninety-minute recording still analyses instantly.
   * Sixty-four windows spread end to end is about a quarter of a second of audio
   * sampled from across the entire duration.
   */
  const FFT_FRAMES = 64;

  /**
   * The file's long-term average spectrum.
   *
   * Averaged across windows taken from the whole file, because what matters here
   * is whether the recording contains high-frequency content at all, not what it
   * was doing at any one moment. Returns null when the file is shorter than a
   * single window.
   */
  function averageSpectrum(buffer: AudioBuffer): Float64Array | null {
    const usable = buffer.length - FFT_SIZE;
    if (usable < 0) return null;

    const half = FFT_SIZE >> 1;
    const window = hannPeriodic(FFT_SIZE);
    const frame = new Float64Array(2 * FFT_SIZE);
    const spec = new Float64Array(2 * FFT_SIZE);
    const total = new Float64Array(half);

    const channels = buffer.numberOfChannels;
    const data: Float32Array[] = [];
    for (let c = 0; c < channels; c += 1) data.push(buffer.getChannelData(c));

    const count = Math.max(1, Math.min(FFT_FRAMES, Math.floor(buffer.length / FFT_SIZE)));
    for (let k = 0; k < count; k += 1) {
      const start = count === 1 ? 0 : Math.floor((usable * k) / (count - 1));
      for (let i = 0; i < FFT_SIZE; i += 1) {
        let sum = 0;
        for (let c = 0; c < channels; c += 1) sum += data[c]![start + i]!;
        frame[2 * i] = (sum / channels) * window[i]!;
        frame[2 * i + 1] = 0;
      }
      fft(frame, spec, FFT_SIZE);
      for (let bin = 0; bin < half; bin += 1) {
        const real = spec[2 * bin]!;
        const imag = spec[2 * bin + 1]!;
        total[bin] = total[bin]! + Math.sqrt(real * real + imag * imag);
      }
    }

    for (let bin = 0; bin < half; bin += 1) total[bin] = total[bin]! / count;
    return total;
  }

  /** Share of the file's total magnitude sitting above a frequency, 0..1. */
  function shareAbove(spec: Float64Array, hz: number): number {
    const binHz = sourceRate / FFT_SIZE;
    let above = 0;
    let all = 0;
    for (let bin = 1; bin < spec.length; bin += 1) {
      const value = spec[bin]!;
      all += value;
      if (bin * binHz > hz) above += value;
    }
    return all > 0 ? above / all : 0;
  }

  /**
   * Rates are shown to three decimals when they need them: 22.05 and 11.025 are
   * real, standard numbers that a single-decimal format would round away.
   */
  function khz(hz: number): string {
    const value = hz / 1000;
    return `${Number.isInteger(value) ? value : Number(value.toFixed(3))} kHz`;
  }

  const FLOOR_DB = -96;

  function drawSpectrum(
    panel: HTMLElement,
    canvas: HTMLCanvasElement,
    spec: Float64Array,
    rate: number
  ): void {
    const cssWidth = canvas.clientWidth;
    const cssHeight = canvas.clientHeight;
    if (cssWidth < 1 || cssHeight < 1) return;

    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const width = Math.round(cssWidth * dpr);
    const height = Math.round(cssHeight * dpr);
    if (canvas.width !== width || canvas.height !== height) {
      canvas.width = width;
      canvas.height = height;
    }

    const context = panelContext(canvas);
    if (!context) return;
    context.clearRect(0, 0, width, height);

    const { ink, hue, danger: raw } = panelColors(panel);
    const alarm = `color-mix(in oklch, ${raw} 62%, white)`;

    const padL = 34 * dpr;
    const padR = 12 * dpr;
    const padT = 20 * dpr;
    const padB = 24 * dpr;
    const plotW = width - padL - padR;
    const plotH = height - padT - padB;

    const nyquist = rate / 2;
    const sourceNyquist = sourceRate / 2;
    // Room for both ceilings, so upsampling shows the empty band it is adding.
    const fMax = Math.max(nyquist, sourceNyquist);
    const fMin = 20;

    const x = (hz: number) =>
      padL + (Math.log(Math.max(fMin, hz) / fMin) / Math.log(fMax / fMin)) * plotW;
    const y = (dB: number) =>
      padT + plotH - ((Math.max(FLOOR_DB, Math.min(0, dB)) - FLOOR_DB) / -FLOOR_DB) * plotH;

    const binHz = sourceRate / FFT_SIZE;
    let peak = 0;
    for (let bin = 1; bin < spec.length; bin += 1) peak = Math.max(peak, spec[bin]!);
    const level = (hz: number): number => {
      if (peak <= 0 || hz >= sourceNyquist) return FLOOR_DB;
      const bin = Math.round(hz / binHz);
      const value = spec[bin] ?? 0;
      return value > 0 ? 20 * Math.log10(value / peak) : FLOOR_DB;
    };

    /**
     * Column-wise maximum, so a narrow peak survives being squeezed onto a log
     * axis — with interpolation underneath it.
     *
     * At the bottom of a log axis one bin is several pixels wide, and taking the
     * nearest bin there draws a staircase that looks like structure the file does
     * not have. Interpolating between neighbouring bins removes the steps without
     * softening any peak, because the maximum still wins wherever a column spans
     * more than one bin.
     */
    const columnLevel = (px: number): number => {
      const f1 = fMin * (fMax / fMin) ** ((px - padL) / plotW);
      const f2 = fMin * (fMax / fMin) ** ((px + 1 - padL) / plotW);
      let value: number;
      if (f2 - f1 >= binHz) {
        const from = Math.max(1, Math.floor(f1 / binHz));
        const to = Math.min(spec.length - 1, Math.max(from, Math.ceil(f2 / binHz)));
        value = 0;
        for (let bin = from; bin <= to; bin += 1) value = Math.max(value, spec[bin]!);
      } else {
        const exact = (f1 + f2) / 2 / binHz;
        const low = Math.max(1, Math.min(spec.length - 2, Math.floor(exact)));
        const fraction = Math.max(0, Math.min(1, exact - low));
        value = spec[low]! * (1 - fraction) + spec[low + 1]! * fraction;
      }

      return value > 0 && peak > 0 ? 20 * Math.log10(value / peak) : FLOOR_DB;
    };

    context.font = `${10 * dpr}px system-ui, sans-serif`;
    context.textBaseline = 'middle';

    for (const dB of [-20, -40, -60, -80]) {
      context.strokeStyle = `color-mix(in oklch, ${ink} 8%, transparent)`;
      context.lineWidth = dpr;
      context.beginPath();
      context.moveTo(padL, y(dB));
      context.lineTo(padL + plotW, y(dB));
      context.stroke();
      context.fillStyle = `color-mix(in oklch, ${ink} 38%, transparent)`;
      context.textAlign = 'right';
      context.fillText(String(dB), padL - 5 * dpr, y(dB));
    }

    for (const hz of [50, 100, 500, 1000, 5000, 10000, 20000]) {
      if (hz > fMax) continue;
      context.strokeStyle = `color-mix(in oklch, ${ink} 7%, transparent)`;
      context.beginPath();
      context.moveTo(x(hz), padT);
      context.lineTo(x(hz), padT + plotH);
      context.stroke();
      context.fillStyle = `color-mix(in oklch, ${ink} 40%, transparent)`;
      context.textAlign = 'center';
      context.fillText(hz >= 1000 ? `${hz / 1000}k` : String(hz), x(hz), height - 9 * dpr);
    }

    const losing = nyquist < sourceNyquist;

    // The band the new rate cannot hold.
    if (losing) {
      context.fillStyle = `color-mix(in oklch, ${alarm} 12%, transparent)`;
      context.fillRect(x(nyquist), padT, x(fMax) - x(nyquist), plotH);
    }

    // The spectrum itself, filled to the floor.
    context.beginPath();
    context.moveTo(padL, padT + plotH);
    for (let px = padL; px <= padL + plotW; px += 1) context.lineTo(px, y(columnLevel(px)));
    context.lineTo(padL + plotW, padT + plotH);
    context.closePath();
    context.fillStyle = `color-mix(in oklch, ${hue} 24%, transparent)`;
    context.fill();

    context.beginPath();
    for (let px = padL; px <= padL + plotW; px += 1) {
      const py = y(columnLevel(px));
      if (px === padL) context.moveTo(px, py);
      else context.lineTo(px, py);
    }
    context.strokeStyle = hue;
    context.lineWidth = 1.75 * dpr;
    context.lineJoin = 'round';
    context.stroke();

    /*
      Where the discarded band ends up.

      This converter interpolates rather than filtering first, so content above
      the new ceiling is not removed — it mirrors about the ceiling and lands back
      inside the audible range as inharmonic tones. Drawing the reflection is the
      honest version of the warning in the prose: on speech the ghost sits on the
      floor and nothing happens, on a bright mix it rides up over the music.
    */
    if (losing) {
      context.beginPath();
      let started = false;
      for (let px = padL; px <= x(nyquist); px += 1) {
        const hz = fMin * (fMax / fMin) ** ((px - padL) / plotW);
        const folded = 2 * nyquist - hz;
        if (folded > sourceNyquist) continue;
        const py = y(level(folded));
        if (!started) {
          context.moveTo(px, py);
          started = true;
        } else {
          context.lineTo(px, py);
        }
      }
      if (started) {
        context.strokeStyle = alarm;
        context.lineWidth = 1.5 * dpr;
        context.setLineDash([4 * dpr, 3 * dpr]);
        context.stroke();
        context.setLineDash([]);
      }
    }

    // The ceiling.
    context.strokeStyle = losing ? alarm : `color-mix(in oklch, ${ink} 65%, transparent)`;
    context.lineWidth = 2 * dpr;
    context.beginPath();
    context.moveTo(x(nyquist), padT);
    context.lineTo(x(nyquist), padT + plotH);
    context.stroke();

    context.font = `600 ${10 * dpr}px system-ui, sans-serif`;
    context.fillStyle = losing ? alarm : `color-mix(in oklch, ${ink} 65%, transparent)`;
    const label = `${Number((nyquist / 1000).toFixed(3))} kHz ceiling`;
    const room = x(nyquist) - padL > plotW * 0.55;
    context.textAlign = room ? 'right' : 'left';
    context.fillText(label, x(nyquist) + (room ? -6 : 6) * dpr, padT - 9 * dpr);
  }

  const tool = createTool({
    suffix: 'resampled',
    defaultFormat: 'wav',
    formats: ['wav', 'flac', 'mp3', 'm4a', 'ogg'],

    agent: {
      name: 'set_sample_rate',
      description:
        'Choose the sample rate the file is converted to, in hertz, from the fixed list the page offers. The spectrum drawing, the Nyquist ceiling note and the upsampling and MP3 warnings update at once. Converting up cannot add detail that was never recorded. Nothing is rendered or saved until the person downloads or export_download is called.',
      params: [
        {
          key: 'sampleRateHz',
          control: 'rate',
          description:
            'Target sample rate in hertz: 8000 (telephone), 16000 (speech models), 22050 (embedded audio), 32000 (broadcast), 44100 (CD and music), 48000 (video and pro audio) or 96000 (high-resolution production). Check inspect_audio for the rate the file has now.',
          type: 'string',
          enum: ['8000', '16000', '22050', '32000', '44100', '48000', '96000'],
        },
      ],
    },

    onReady(ctx, runtime) {
      sourceRate = ctx.buffer.sampleRate;
      spectrum = averageSpectrum(ctx.buffer);

      const info = runtime.root.querySelector<HTMLElement>('[data-source-rate]');
      if (info) {
        info.textContent = `This file is ${khz(sourceRate)}.`;
      }

      // Default to leaving the rate alone; changing it should be a decision.
      const select = runtime.root.querySelector<HTMLSelectElement>('[data-control="rate"]');
      if (select) {
        const match = Array.from(select.options).find(
          (option) => Number(option.value) === sourceRate
        );
        if (match) select.value = match.value;
      }

      // The canvas has no width until the workspace is on screen.
      requestAnimationFrame(sync);
      if (specPanel) new ResizeObserver(sync).observe(specPanel);

      sync();
    },

    process(ctx) {
      const rate = targetRate();
      return rate === ctx.buffer.sampleRate ? ctx.buffer : resampleLinear(ctx.buffer, rate);
    },
  });

  const root = tool?.root ?? null;
  const rateSel = root?.querySelector<HTMLSelectElement>('[data-control="rate"]') ?? null;
  const formatSel = root?.querySelector<HTMLSelectElement>('[data-format]') ?? null;
  const specPanel = root?.querySelector<HTMLElement>('[data-spectrum-panel]') ?? null;
  const specCanvas = root?.querySelector<HTMLCanvasElement>('[data-spectrum]') ?? null;
  const specCaption = root?.querySelector<HTMLElement>('[data-spectrum-caption]') ?? null;

  function targetRate(): number {
    const value = Number(rateSel?.value);
    return Number.isFinite(value) && value > 0 ? value : 44100;
  }

  function sync(): void {
    if (!root) return;
    const rate = targetRate();

    if (specPanel && specCanvas && spectrum && sourceRate > 0) {
      drawSpectrum(specPanel, specCanvas, spectrum, rate);

      if (specCaption) {
        const ceiling = rate / 2;
        if (ceiling >= sourceRate / 2) {
          specCaption.textContent =
            rate > sourceRate
              ? `This file holds nothing above ${khz(sourceRate / 2)}, so the extra room ` +
                `${khz(ceiling)} provides stays empty. Nothing is lost and nothing is gained.`
              : 'The ceiling is not moving, so the spectrum survives intact.';
        } else {
          const share = shareAbove(spectrum, ceiling);
          const percent = share < 0.005 ? '<0.5' : (share * 100).toFixed(share < 0.1 ? 1 : 0);
          specCaption.textContent =
            `${percent}% of this file sits above ${khz(ceiling)}. This converter ` +
            'interpolates rather than filtering first, so that content mirrors back down ' +
            'into the audible range instead of disappearing: the dashed line is where it ' +
            `lands. ${
              share < 0.01
                ? 'At this level it is inaudible, which is why speech converts cleanly.'
                : 'That is enough to hear, so use a converter with a proper low-pass filter ' +
                  'if the result matters.'
            }`;
        }
      }
    }

    const nyquist = root.querySelector<HTMLElement>('[data-nyquist]');
    if (nyquist) {
      nyquist.textContent = `Half the sample rate, which is ${khz(
        rate / 2
      )} at ${khz(rate)}.`;
    }

    const upNote = root.querySelector<HTMLElement>('[data-upsample-note]');
    const upText = root.querySelector<HTMLElement>('[data-upsample-text]');
    if (upNote && upText) {
      const upsampling = sourceRate > 0 && rate > sourceRate;
      upNote.hidden = !upsampling;
      if (upsampling) {
        upText.textContent = `The file was recorded at ${khz(
          sourceRate
        )}, so it contains nothing above ${khz(
          sourceRate / 2
        )}. Converting up to ${khz(
          rate
        )} interpolates new samples between the existing ones. It makes the file larger and cannot add detail that was never recorded. Do this only because something downstream demands the higher rate.`;
      }
    }

    const mp3Note = root.querySelector<HTMLElement>('[data-mp3-note]');
    const mp3Text = root.querySelector<HTMLElement>('[data-mp3-text]');
    if (mp3Note && mp3Text) {
      const nearest = nearestMp3Rate(rate);
      const mismatch = formatSel?.value === 'mp3' && nearest !== rate;
      mp3Note.hidden = !mismatch;
      if (mismatch) {
        mp3Text.textContent = `MP3 permits only a fixed set of sample rates, and ${khz(
          rate
        )} is not one of them. The encoder will resample your file again, to ${khz(
          nearest
        )}. Choose WAV or FLAC in the export bar to keep the rate you picked.`;
      }
    }
  }

  rateSel?.addEventListener('change', sync);
  formatSel?.addEventListener('change', sync);
  sync();
</script>
