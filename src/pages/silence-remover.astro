---
import ToolPage from '../layouts/ToolPage.astro';
import ToolShell from '../components/ToolShell.astro';
import { getTool } from '../data/tools';

const tool = getTool('silence-remover');

const steps = [
  'Drop the recording onto the page. It is scanned where it sits, so an hour-long interview costs you the decode and nothing else.',
  'Set the threshold. The level below which audio counts as silence. The summary underneath immediately tells you how many gaps were found at that setting.',
  'Raise the minimum gap length until the tool stops cutting the natural beats between words, and raise the padding until speech stops sounding clipped at the joins.',
  'When the summary says the right thing, pick a format and download. The audio that survives is untouched, only the gaps are gone.',
];

const faq = [
  {
    q: 'What does the threshold number actually mean?',
    a: 'It is dBFS: decibels relative to full scale, where 0 is the loudest a digital file can be and everything real sits below it. Your recording has a noise floor (the level of the room and the microphone when nobody is talking) and the threshold has to sit above it. A quiet indoor room floors out around -50 dBFS, a phone in a cafe closer to -35.',
  },
  {
    q: 'It is cutting the beginning off words. How do I stop that?',
    a: 'Raise the padding. Consonants like t, k and p start with almost no energy before the burst arrives, so a cut placed at the exact moment the level crosses the threshold lands inside the word. Padding of 0.08 seconds is enough for most voices; 0.15 is safer for fast speakers and sibilant microphones.',
  },
  {
    q: 'How is this different from a noise gate?',
    a: 'A gate turns the level down during quiet passages but leaves the time in place, so a two-second pause stays two seconds long and merely becomes more silent. This deletes the pause entirely, so the file gets shorter. If you want the dead air quieter rather than gone, a gate is what you want and this is not it.',
  },
  {
    q: 'Nothing was removed, even though there are obvious pauses.',
    a: 'Two settings have to agree before a stretch is cut: it must be quieter than the threshold and it must last at least the minimum gap. If your pauses are one second and the minimum is two, nothing qualifies. If your room tone is -40 and the threshold is -50, nothing qualifies either. The summary tells you which of the two is failing, because it reports what was found before padding is applied.',
  },
  {
    q: 'Will it work on music?',
    a: 'Rarely, and usually not in a way you want. Music has a reverb tail, a bass note ringing out, or a sustained pad that keeps the level above any sensible threshold, so nothing is detected. Where it does trigger (between movements, or in a sparse acoustic recording) it will happily remove the rest the composer wrote in. Use the trimmer for music.',
  },
  {
    q: 'Does removing silence change the pitch or speed of what is left?',
    a: 'No. Nothing is time-stretched or resampled. The surviving audio is copied out sample for sample and the pieces are butted together with a five-millisecond crossfade, which is short enough to be inaudible and long enough to stop the joins from clicking.',
  },
  {
    q: 'Can it get rid of background hiss?',
    a: 'No. Hiss is not silence, it is a continuous signal, and this tool only deletes time. What it does do is remove the passages where the hiss is all you can hear, which makes a noisy recording feel cleaner without touching the noise itself. For actual hiss reduction you want a noise reduction pass, or a high-pass filter if the problem is low rumble.',
  },
];
---

<ToolPage slug={tool.slug} steps={steps} faq={faq}>
  <ToolShell tool={tool} action="Download trimmed audio">
    <div class="controls">
      <div class="controls__head">
        <span class="controls__title">Detection</span>
        <span class="hint">A stretch is cut only if it is quiet enough and long enough.</span>
      </div>

      {/*
        The level the threshold is actually compared against.

        "−45 dB" is a number with nothing to read it against, which is why
        picking it has always been guesswork — a phone recording in a quiet room
        floors at −60, the same room with a fan floors at −38, and the right
        setting is a property of the file rather than of the tool. This plots the
        exact quantity the detector measures, in the same 20 ms RMS windows, with
        the threshold drawn across it. All three sliders become visible at once:
        the line is the threshold, the dips it clears but that stay unshaded are
        the ones too short to qualify, and the gap between a shaded band and the
        dip around it is the padding being kept.
      */}
      <div class="floor controls__full" data-floor-panel>
        <canvas class="floor__canvas" data-floor aria-hidden="true"></canvas>
      </div>

      <div class="field">
        <label class="label" for="sr-threshold">
          Counts as silence below
          <span class="label__value" data-out="threshold">-45 dB</span>
        </label>
        <div class="slider-row">
          <input
            class="slider"
            id="sr-threshold"
            data-control="threshold"
            type="range"
            min="-70"
            max="-20"
            step="1"
            value="-45"
          />
          <input
            class="num"
            data-control="threshold-num"
            type="number"
            min="-70"
            max="-20"
            step="1"
            value="-45"
            aria-label="Silence threshold in decibels relative to full scale"
          />
        </div>
      </div>

      <div class="field">
        <label class="label" for="sr-min">
          Minimum gap length
          <span class="label__value" data-out="min">0.40 s</span>
        </label>
        <div class="slider-row">
          <input
            class="slider"
            id="sr-min"
            data-control="min"
            type="range"
            min="0.1"
            max="3"
            step="0.05"
            value="0.4"
          />
          <input
            class="num"
            data-control="min-num"
            type="number"
            min="0.1"
            max="3"
            step="0.05"
            value="0.4"
            aria-label="Minimum gap length in seconds"
          />
        </div>
      </div>

      <div class="field">
        <label class="label" for="sr-pad">
          Padding kept each side
          <span class="label__value" data-out="pad">0.08 s</span>
        </label>
        <div class="slider-row">
          <input
            class="slider"
            id="sr-pad"
            data-control="pad"
            type="range"
            min="0"
            max="0.5"
            step="0.01"
            value="0.08"
          />
          <input
            class="num"
            data-control="pad-num"
            type="number"
            min="0"
            max="0.5"
            step="0.01"
            value="0.08"
            aria-label="Padding kept on each side of a gap, in seconds"
          />
        </div>
      </div>

      <div class="note note--info controls__full" data-report hidden>
        <div class="note__body" data-report-text></div>
      </div>
    </div>
  </ToolShell>

  <Fragment slot="about">
    <h2>What the tool calls silence</h2>
    <p>
      Silence in a recording is almost never silence. Even a treated room has a
      noise floor. The microphone's self-noise, the air handling, traffic through a
      wall. So the passage you think of as "nothing" still carries a signal. That is
      why the control is a threshold rather than a switch. The file is measured in
      20-millisecond windows, each window's RMS level is compared against your
      number, and anything below it is a candidate for removal.
    </p>
    <p>
      Twenty milliseconds is a deliberate choice. Shorter windows would trip on the
      moments a normal waveform passes through zero, which happens hundreds of times
      a second in ordinary speech. Longer windows would smear over a real breath and
      miss it. At 20 ms the measurement tracks the envelope of the sound rather than
      its individual cycles, which is what a listener hears anyway.
    </p>
    <p>
      The second condition (minimum gap length) is what separates a pause from a
      rhythm. Ordinary speech contains dozens of sub-200-millisecond silences per
      minute, between words and inside stop consonants, and removing them makes a
      person sound like they are being played back wrong. Setting the minimum around
      0.4 seconds ignores the rhythm of speech and catches only the pauses a listener
      would also notice.
    </p>

    <h2>Why padding matters more than it looks</h2>
    <p>
      When a stretch is removed, the cut is pulled inward by the padding amount at
      both ends, so some of the quiet stays. This is not politeness; it is a fix for
      a specific artefact. Plosives and fricatives (p, t, k, s) begin with a very
      low-energy approach before the burst, and a cut placed exactly where the level
      crosses the threshold slices into that approach. The result sounds like the
      speaker is being interrupted by their own recording.
    </p>
    <p>
      Padding also protects the natural cadence of speech. Removing every millisecond
      of dead air produces a person who never breathes, which listeners find
      exhausting long before they can say why. Leaving 80 to 150 milliseconds either
      side keeps the impression of a pause while removing its length.
    </p>

    <h2>When not to use this</h2>
    <p>
      Anything where the silence is the content. Music uses rests structurally, and a
      tool that cannot tell a rest from dead air will flatten a piece. Recordings
      intended as evidence or as a record of a meeting should not have time removed
      at all. The edit is invisible in the result, which is exactly the problem.
    </p>
    <p>
      And if the goal is a shorter file rather than a tighter one, this is an
      inefficient way to get there. Removing 90 seconds of silence from a 40-minute
      episode saves about 3 percent of the file. Dropping the bitrate or converting
      to a more efficient format saves far more, and does not change the edit.
    </p>
  </Fragment>
</ToolPage>

<style>
  .floor {
    padding: var(--s4);
    border-radius: var(--r-md);
    background: var(--stage-2, var(--surface));
  }

  .floor__canvas {
    width: 100%;
    height: 176px;
    display: block;
  }

  @media (max-width: 560px) {
    .floor__canvas {
      height: 152px;
    }
  }
</style>

<script>
  import { createTool } from '../lib/tool';
  import { findSilence, removeSilence } from '../lib/audio/dsp';
  import { duration as fmtDuration } from '../lib/format';
  import { panelColors, panelContext } from '../lib/canvas';

  /**
   * The file's level over time, in the same windows the detector uses.
   *
   * findSilence walks 20 ms RMS windows and compares each against the threshold,
   * so plotting anything else — a peak envelope, the drawn waveform — would show
   * a quantity the slider is not being compared to, and the line would sit in the
   * wrong place relative to the dips. This is the detector's own measurement.
   */
  const WINDOW_SECONDS = 0.02;
  const FLOOR_DB = -80;

  let envelope: Float32Array | null = null;

  function measureEnvelope(buffer: AudioBuffer): Float32Array {
    const rate = buffer.sampleRate;
    const window = Math.max(1, Math.floor(rate * WINDOW_SECONDS));
    const windows = Math.ceil(buffer.length / window);
    const out = new Float32Array(windows);
    const channels = buffer.numberOfChannels;
    const data: Float32Array[] = [];
    for (let c = 0; c < channels; c += 1) data.push(buffer.getChannelData(c));

    for (let w = 0; w < windows; w += 1) {
      const from = w * window;
      const to = Math.min(from + window, buffer.length);
      let sum = 0;
      let count = 0;
      for (let c = 0; c < channels; c += 1) {
        const channel = data[c]!;
        for (let i = from; i < to; i += 1) sum += channel[i]! * channel[i]!;
        count += to - from;
      }
      const rms = count === 0 ? 0 : Math.sqrt(sum / count);
      out[w] = rms > 0 ? Math.max(FLOOR_DB, 20 * Math.log10(rms)) : FLOOR_DB;
    }
    return out;
  }

  function drawFloor(
    panel: HTMLElement,
    canvas: HTMLCanvasElement,
    levels: Float32Array,
    seconds: number,
    threshold: number,
    cuts: { start: number; end: number }[]
  ): void {
    const cssWidth = canvas.clientWidth;
    const cssHeight = canvas.clientHeight;
    if (cssWidth < 1 || cssHeight < 1) return;

    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const width = Math.round(cssWidth * dpr);
    const height = Math.round(cssHeight * dpr);
    if (canvas.width !== width || canvas.height !== height) {
      canvas.width = width;
      canvas.height = height;
    }

    const context = panelContext(canvas);
    if (!context) return;
    context.clearRect(0, 0, width, height);

    const { ink, hue } = panelColors(panel);

    const padL = 34 * dpr;
    const padR = 12 * dpr;
    const padT = 12 * dpr;
    const padB = 22 * dpr;
    const plotW = width - padL - padR;
    const plotH = height - padT - padB;

    const x = (time: number) => padL + (time / Math.max(0.001, seconds)) * plotW;
    const y = (dB: number) =>
      padT + plotH - ((Math.max(FLOOR_DB, Math.min(0, dB)) - FLOOR_DB) / -FLOOR_DB) * plotH;

    context.font = `${10 * dpr}px system-ui, sans-serif`;
    context.textBaseline = 'middle';

    for (const dB of [-20, -40, -60]) {
      context.strokeStyle = `color-mix(in oklch, ${ink} 8%, transparent)`;
      context.lineWidth = dpr;
      context.beginPath();
      context.moveTo(padL, y(dB));
      context.lineTo(padL + plotW, y(dB));
      context.stroke();
      context.fillStyle = `color-mix(in oklch, ${ink} 38%, transparent)`;
      context.textAlign = 'right';
      context.fillText(String(dB), padL - 5 * dpr, y(dB));
    }

    // What actually gets removed, drawn behind the level so the level stays
    // readable across it.
    for (const cut of cuts) {
      const from = x(cut.start);
      const to = x(cut.end);
      context.fillStyle = `color-mix(in oklch, ${hue} 26%, transparent)`;
      context.fillRect(from, padT, Math.max(dpr, to - from), plotH);
    }

    /*
      One column per pixel, drawn as the band between the quietest and loudest
      window in it.

      The minimum is the part that matters — a column is only a candidate for
      cutting if some window inside it fell under the line — so collapsing to an
      average would hide exactly the thing being decided.
    */
    const columns = Math.max(1, Math.round(plotW));
    const perColumn = levels.length / columns;
    const body = `color-mix(in oklch, ${ink} 16%, transparent)`;
    const band = `color-mix(in oklch, ${ink} 55%, transparent)`;
    for (let column = 0; column < columns; column += 1) {
      const from = Math.floor(column * perColumn);
      const to = Math.max(from + 1, Math.floor((column + 1) * perColumn));
      let low = 0;
      let high = FLOOR_DB;
      for (let i = from; i < to && i < levels.length; i += 1) {
        const value = levels[i]!;
        if (value < low) low = value;
        if (value > high) high = value;
      }
      const px = padL + column;

      // Filled to the floor so the plot has a body to read against the line,
      // then the min-to-max band on top. Rectangles rather than line segments:
      // a column of steady material has min equal to max, and a zero-length
      // stroke draws nothing at all.
      context.fillStyle = body;
      context.fillRect(px, y(high), 1, padT + plotH - y(high));
      context.fillStyle = band;
      context.fillRect(px, y(high), 1, Math.max(dpr, y(low) - y(high)));
    }

    // The threshold, which is the whole point of the picture.
    context.strokeStyle = hue;
    context.lineWidth = 2 * dpr;
    context.beginPath();
    context.moveTo(padL, y(threshold));
    context.lineTo(padL + plotW, y(threshold));
    context.stroke();

    context.font = `600 ${10 * dpr}px system-ui, sans-serif`;
    context.fillStyle = hue;
    context.textAlign = 'left';
    context.fillText(
      `${threshold} dB — anything under this line is a candidate`,
      padL + 6 * dpr,
      y(threshold) - 9 * dpr
    );

    context.font = `${10 * dpr}px system-ui, sans-serif`;
    context.fillStyle = `color-mix(in oklch, ${ink} 40%, transparent)`;
    context.textAlign = 'right';
    context.fillText(fmtDuration(seconds), padL + plotW, height - 8 * dpr);
    context.textAlign = 'left';
    context.fillText('0:00', padL, height - 8 * dpr);
  }

  const tool = createTool({
    suffix: 'tightened',
    defaultFormat: 'mp3',

    onReady(ctx, runtime) {
      const root = runtime.root;
      const report = root.querySelector<HTMLElement>('[data-report]');
      const reportText = root.querySelector<HTMLElement>('[data-report-text]');
      const floorPanel = root.querySelector<HTMLElement>('[data-floor-panel]');
      const floorCanvas = root.querySelector<HTMLCanvasElement>('[data-floor]');

      // One pass over the file, kept for the life of the page — the sliders move
      // the line, not the level underneath it.
      envelope = measureEnvelope(ctx.buffer);

      const paintFloor = (cuts: { start: number; end: number }[]): void => {
        if (!floorPanel || !floorCanvas || !envelope) return;
        drawFloor(
          floorPanel,
          floorCanvas,
          envelope,
          ctx.buffer.duration,
          runtime.value('threshold', -45),
          cuts
        );
      };

      /**
       * Mirrors the arithmetic removeSilence performs, so the estimate can be
       * shown on every slider move without allocating a whole new buffer.
       */
      const measure = (): void => {
        if (!report || !reportText) return;

        const threshold = runtime.value('threshold', -45);
        const minSec = runtime.value('min', 0.4);
        const padSec = runtime.value('pad', 0.08);
        const total = ctx.buffer.duration;
        const regions = findSilence(ctx.buffer, threshold, minSec);

        if (regions.length === 0) {
          runtime.setHighlights([]);
          paintFloor([]);
          reportText.textContent =
            `No stretch is both quieter than ${threshold} dB and longer than ${minSec.toFixed(2)} s. ` +
            'Move the threshold up toward -20 dB, or shorten the minimum gap.';
          report.hidden = false;
          return;
        }

        // Show the exact spans on the waveform, inset by the padding that is
        // kept, so the slider stops being a guess — you can see what goes.
        runtime.setHighlights(
          regions
            .map((region) => ({
              start: Math.max(0, region.start + padSec),
              end: Math.min(total, region.end - padSec),
            }))
            .filter((region) => region.end > region.start)
        );

        let removed = 0;
        let cursor = 0;
        const cuts: { start: number; end: number }[] = [];
        for (const region of regions) {
          const start = Math.max(cursor, region.start + padSec);
          const end = Math.min(total, region.end - padSec);
          if (end <= start) continue;
          removed += end - start;
          cursor = end;
          cuts.push({ start, end });
        }
        const cut = cuts.length;
        paintFloor(cuts);

        if (cut === 0) {
          reportText.textContent =
            `${regions.length} gap${regions.length === 1 ? '' : 's'} found, but the padding is wide ` +
            'enough to keep all of them. Lower the padding to start removing time.';
          report.hidden = false;
          return;
        }

        const share = Math.round((removed / total) * 100);
        reportText.textContent =
          `Highlighted on the waveform: ${regions.length} gap${regions.length === 1 ? '' : 's'} found. ` +
          `About ${fmtDuration(removed)} comes out (${share}% of the file) ` +
          `leaving ${fmtDuration(total - removed)} of ${fmtDuration(total)}.`;
        report.hidden = false;
      };

      // The scan reads every sample, so it must not run on every drag frame.
      let timer = 0;
      const schedule = (): void => {
        window.clearTimeout(timer);
        timer = window.setTimeout(measure, 160);
      };

      const bindSlider = (name: string, format: (value: number) => string): void => {
        const slider = root.querySelector<HTMLInputElement>(`[data-control="${name}"]`);
        const num = root.querySelector<HTMLInputElement>(`[data-control="${name}-num"]`);
        const out = root.querySelector<HTMLElement>(`[data-out="${name}"]`);
        if (!slider) return;

        const paint = (): void => {
          const min = Number(slider.min);
          const max = Number(slider.max);
          const span = max - min || 1;
          slider.style.setProperty('--pct', `${((Number(slider.value) - min) / span) * 100}%`);
          if (out) out.textContent = format(Number(slider.value));
        };

        slider.addEventListener('input', () => {
          if (num) num.value = slider.value;
          paint();
          schedule();
        });

        num?.addEventListener('input', () => {
          slider.value = num.value;
          paint();
          schedule();
        });

        num?.addEventListener('change', () => {
          if (num) num.value = slider.value;
        });

        paint();
      };

      bindSlider('threshold', (value) => `${value} dB`);
      bindSlider('min', (value) => `${value.toFixed(2)} s`);
      bindSlider('pad', (value) => `${value.toFixed(2)} s`);

      // The canvas has no width until the workspace is on screen.
      requestAnimationFrame(measure);
      if (floorPanel) new ResizeObserver(measure).observe(floorPanel);

      measure();
    },

    process(ctx) {
      return removeSilence(
        ctx.buffer,
        tool?.value('threshold', -45) ?? -45,
        tool?.value('min', 0.4) ?? 0.4,
        tool?.value('pad', 0.08) ?? 0.08
      );
    },
  });
</script>
