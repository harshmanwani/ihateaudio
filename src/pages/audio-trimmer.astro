---
import ToolPage from '../layouts/ToolPage.astro';
import ToolShell from '../components/ToolShell.astro';
import { getTool } from '../data/tools';

const tool = getTool('audio-trimmer');

const steps = [
  'Drop your audio file onto the page, or click to browse for it. Nothing is uploaded. The file is read directly by your browser.',
  'Drag the two handles on the waveform to select the part you want to keep. You can also type exact timecodes below the waveform.',
  'Press play to hear just the selection, and adjust until it sounds right. Loop it if you want to check the boundaries.',
  'Choose whether to keep the selection or cut it out, pick an output format, and click Download.',
];

const faq = [
  {
    q: 'Is there a file size limit?',
    a: 'There is no limit we impose, because the file is never sent anywhere. The real limit is your device\'s memory: roughly 40 minutes of audio on a phone, and several hours on a desktop. If a file is too large, the tool says so before it tries, rather than crashing the tab.',
  },
  {
    q: 'Does trimming an MP3 reduce its quality?',
    a: 'Slightly, if you export back to MP3, because the audio is decoded and re-encoded. At 192 kbps or above the difference is inaudible in practice. If you want to avoid it entirely, export as WAV or FLAC. Both are lossless from this point onward.',
  },
  {
    q: 'Can I cut a section out of the middle?',
    a: 'Yes. Select the part you want gone and switch the mode to "Remove selection". Everything outside the selection is joined back together, with a very short crossfade at the join so you do not hear a click.',
  },
  {
    q: 'How precise can I be?',
    a: 'The timecode fields accept hundredths of a second, and the arrow keys nudge a selection handle by 0.05 seconds at a time (hold Shift for one-second jumps). That is far finer than the ear can detect at a cut point.',
  },
  {
    q: 'Why is this faster than other online audio cutters?',
    a: 'Most of them upload your file to a server, process it there, and send it back. So you wait for two transfers plus a queue. This one does the work in your browser, so the only limit is how fast your own machine is. For a typical song, trimming takes well under a second.',
  },
  {
    q: 'What formats can I open?',
    a: 'Anything your browser can decode, which covers MP3, WAV, M4A, AAC, OGG, Opus, FLAC and WebM. Formats browsers cannot read natively (WMA, AIFF, AMR) should go through the audio converter first, which loads a fuller decoder on demand.',
  },
];
---

<ToolPage slug={tool.slug} steps={steps} faq={faq}>
  <ToolShell tool={tool} selection action="Download">
    <div class="controls">
      <div class="controls__head">
        <span class="controls__title">Selection</span>
        <span class="hint">Drag the handles, or type exact times.</span>
      </div>

      <div class="field">
        <label class="label" for="trim-start">Start</label>
        <input
          class="input tnum"
          id="trim-start"
          data-control="start"
          type="text"
          inputmode="decimal"
          placeholder="0:00.00"
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <div class="field">
        <label class="label" for="trim-end">End</label>
        <input
          class="input tnum"
          id="trim-end"
          data-control="end"
          type="text"
          inputmode="decimal"
          placeholder="0:00.00"
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <div class="field">
        <span class="label" id="trim-mode-label">What to do with it</span>
        <div class="seg" role="group" aria-labelledby="trim-mode-label">
          <button type="button" class="seg__btn" data-mode="keep" aria-pressed="true">
            Keep selection
          </button>
          <button type="button" class="seg__btn" data-mode="cut" aria-pressed="false">
            Remove selection
          </button>
        </div>
      </div>

      <div class="field">
        <span class="label">Extras</span>
        <label class="switch">
          <input type="checkbox" data-control="fade" />
          <span>Fade the edges (20 ms)</span>
        </label>
      </div>
    </div>
  </ToolShell>

  <Fragment slot="about">
    <h2>Cutting audio without uploading it</h2>
    <p>
      Every other free audio cutter works the same way: you hand your file to a
      server, it does the work, and you download the result. That means waiting
      through two transfers, trusting someone else with a recording that might be
      a private voice note or unreleased music, and usually hitting a size cap
      that exists to keep their bandwidth bill down.
    </p>
    <p>
      None of that is necessary. Browsers have had a complete audio engine built
      in for over a decade. The same one that powers web games and video calls.
      This tool decodes your file with it, draws the waveform from the actual
      samples, and writes the trimmed result back out. Your file is read from
      disk into the tab's memory and never travels anywhere. You can verify that
      by opening your browser's network tab while you use it, or by
      disconnecting from the internet entirely: the page keeps working.
    </p>

    <h2>Choosing where to cut</h2>
    <p>
      Cuts sound cleanest at a <strong>zero crossing</strong>, a point where the
      waveform passes through the centre line. Cutting mid-wave leaves an abrupt
      jump in the signal, which your ear hears as a click. If you hear one at
      either end of your cut, turn on <em>Fade the edges</em>: a 20-millisecond
      fade is far too short to be audible as a fade, but it is more than long
      enough to eliminate the click.
    </p>
    <p>
      For speech, leave a little air on each side rather than cutting tight
      against the first and last word. Around 100 milliseconds of room tone
      before someone starts speaking sounds natural; a hard cut straight into a
      consonant sounds abrupt, even when the edit itself is technically clean.
    </p>

    <h2>Keeping the quality you started with</h2>
    <p>
      MP3 is a lossy format, so decoding and re-encoding one loses a small amount
      of quality. A generation loss, like photocopying a photocopy. One pass at
      192 kbps or higher is inaudible to almost everyone, and a single trim is
      one pass. It only becomes a real problem if you run the same file through
      many lossy edits in sequence.
    </p>
    <p>
      If you plan to keep editing, export as WAV or FLAC between steps. Both are
      lossless, so you can trim, normalize, add fades and convert without
      compounding any loss, then encode to MP3 once at the very end. WAV is
      instant here; FLAC is about half the size for identical quality.
    </p>
  </Fragment>
</ToolPage>

<script>
  import { createTool } from '../lib/tool';
  import { slice, cutOut, applyFade } from '../lib/audio/dsp';
  import { timecode, parseTimecode } from '../lib/format';

  let mode: 'keep' | 'cut' = 'keep';

  const tool = createTool({
    suffix: 'trimmed',
    selection: true,
    defaultFormat: 'mp3',

    agent: {
      name: 'set_trim',
      description:
        'Trim, cut or clip the loaded audio: set the start and end of the selection in seconds, whether to keep that selection or cut it out and join the rest, and whether to fade the new edges. Example: the first 30 seconds is startSec 0, endSec 30, mode keep. Moves the visible controls only; nothing is saved until export_download is called.',
      params: [
        {
          key: 'startSec',
          description: 'Selection start, in seconds from the start of the file.',
          type: 'number',
          min: 0,
          apply: (value, runtime) =>
            runtime.setSelection({ start: Number(value), end: runtime.getSelection().end }),
        },
        {
          key: 'endSec',
          description: 'Selection end, in seconds from the start of the file.',
          type: 'number',
          min: 0,
          apply: (value, runtime) =>
            runtime.setSelection({ start: runtime.getSelection().start, end: Number(value) }),
        },
        {
          key: 'mode',
          description: '"keep" exports only the selection; "cut" removes it and joins the rest.',
          type: 'string',
          enum: ['keep', 'cut'],
          apply: (value, runtime) =>
            runtime.root.querySelector<HTMLButtonElement>(`[data-mode="${value}"]`)?.click(),
        },
        {
          key: 'fade',
          description: 'Fade the new edges for 20 ms so a cut never clicks.',
          type: 'boolean',
        },
      ],
    },

    onReady(ctx, runtime) {
      const root = runtime.root;
      const startInput = root.querySelector<HTMLInputElement>('[data-control="start"]');
      const endInput = root.querySelector<HTMLInputElement>('[data-control="end"]');

      // Keep the text fields in step with the handles.
      const sync = (): void => {
        const selection = runtime.getSelection();
        if (startInput && document.activeElement !== startInput) {
          startInput.value = timecode(selection.start);
        }
        if (endInput && document.activeElement !== endInput) {
          endInput.value = timecode(selection.end);
        }
      };

      root.addEventListener('selectionchange', sync);
      sync();

      // And the handles in step with the text fields.
      const commit = (): void => {
        const start = parseTimecode(startInput?.value ?? '');
        const end = parseTimecode(endInput?.value ?? '');
        const current = runtime.getSelection();
        runtime.setSelection({
          start: start ?? current.start,
          end: end ?? current.end,
        });
        sync();
      };

      for (const input of [startInput, endInput]) {
        input?.addEventListener('change', commit);
        input?.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') {
            event.preventDefault();
            commit();
          }
        });
      }

      root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((button) => {
        button.addEventListener('click', () => {
          mode = button.dataset.mode === 'cut' ? 'cut' : 'keep';
          root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((other) => {
            other.setAttribute('aria-pressed', String(other === button));
          });
        });
      });
    },

    process(ctx) {
      const { buffer, selection } = ctx;
      const result =
        mode === 'cut'
          ? cutOut(buffer, selection.start, selection.end)
          : slice(buffer, selection.start, selection.end);

      // 20ms is below the threshold of hearing it as a fade, and above the
      // threshold of hearing the click it prevents.
      return tool?.flag('fade') ? applyFade(result, 0.02, 0.02, 'linear') : result;
    },
  });
</script>
