---
import ToolPage from '../layouts/ToolPage.astro';
import ToolShell from '../components/ToolShell.astro';
import { getTool } from '../data/tools';

const tool = getTool('stereo-to-mono');

const steps = [
  'Drop the file onto the page. The tool reads how many channels it really contains and switches off the conversions that would not make sense for it.',
  'Pick a direction: fold stereo down to mono, duplicate mono into a stereo pair, or split a stereo file into two separate single-channel files.',
  'Play it back before you commit. A downmix occasionally reveals phase cancellation that was completely inaudible in stereo, and the transport plays the converted version.',
  'Choose a format and download. Splitting produces two files, each listed underneath with its own download button.',
];

const faq = [
  {
    q: 'Does converting to mono halve the file size?',
    a: 'For uncompressed formats like WAV, yes, almost exactly. Half the channels, half the samples. For MP3, AAC and Opus the saving is smaller, usually 30 to 45 percent, because those encoders already exploit the similarity between the two channels. The bigger win is quality: a mono file at a given bitrate spends the entire bitrate on one channel.',
  },
  {
    q: 'Can I lose anything by downmixing?',
    a: 'Yes. Mono is the sum of the channels, so any sound present in both at opposite polarity cancels out. Wide synth pads, some reverb tails and anything processed by a stereo widener can drop in level or vanish entirely. Play the downmix before downloading. That is the only reliable test.',
  },
  {
    q: 'Why would I want mono at all?',
    a: 'A single voice recorded on one microphone has no stereo information worth keeping, and most podcast platforms prefer mono for that reason. It is also the safer choice for anything played back on one speaker (phones, most Bluetooth speakers, public address systems) since those devices sum to mono anyway, and doing it yourself means you hear the result first.',
  },
  {
    q: 'Does converting mono to stereo give me actual stereo sound?',
    a: 'No. It writes the same audio into two channels, so the file is stereo in structure and mono in content. That satisfies software and hardware that refuses single-channel input, but nothing about the sound changes. If you want an actual stereo image from a mono source, the stereo widener cannot help either. There is no side information to widen.',
  },
  {
    q: 'When is splitting the channels useful?',
    a: 'When the two channels were never a stereo image to begin with: a two-person interview recorded with one microphone per channel, a field recorder with a lavalier on the left input and a shotgun on the right, or a backing track with a guide vocal printed to one side. Splitting gives you each source as its own file to edit separately.',
  },
  {
    q: 'Can this separate the vocals from the instrumental?',
    a: 'No. Left and right are the only division a stereo file contains. There is no vocal channel inside it. The old trick of subtracting one channel from the other removes anything panned dead centre, which usually takes the bass and kick with the vocal and leaves an unusable result. That is a different kind of tool entirely.',
  },
  {
    q: 'What happens with a file that has more than two channels?',
    a: 'Folding to mono averages every channel together. Splitting gives you the first two, which in standard channel ordering are the front left and front right. Surround files are rare in the formats these tools export to, so if you have one, converting it to stereo in a proper editor first will give you more control over the downmix.',
  },
];
---

<ToolPage slug={tool.slug} steps={steps} faq={faq}>
  <ToolShell tool={tool} results action="Download">
    <div class="controls">
      <div class="controls__head">
        <span class="controls__title">Channels</span>
        <span class="hint">Preview plays the converted version.</span>
      </div>

      <div class="field controls__full">
        <span class="label" id="sm-mode-label">Conversion</span>
        <div class="seg" role="group" aria-labelledby="sm-mode-label">
          <button type="button" class="seg__btn" data-mode="mono" aria-pressed="true">
            Stereo to mono
          </button>
          <button type="button" class="seg__btn" data-mode="stereo" aria-pressed="false">
            Mono to stereo
          </button>
          <button type="button" class="seg__btn" data-mode="split" aria-pressed="false">
            Split the channels
          </button>
        </div>
      </div>

      {/*
        What folding down would actually cost this file.

        The page spends two paragraphs explaining that adding two channels can
        produce silence, and then leaves you to find out by listening. This
        measures it instead. The strip is phase correlation over the whole file,
        so a passage that will cancel is a dip you can point at; the bars are the
        share of each band's energy that lives in the difference between the
        channels, which is precisely the part a downmix throws away. A speech
        recording shows almost nothing. A widened pad shows most of its midrange
        about to disappear.
      */}
      <div class="mono controls__full" data-mono-panel hidden>
        <canvas class="mono__canvas" data-mono aria-hidden="true"></canvas>
        <p class="mono__caption" data-mono-caption></p>
      </div>

      <div class="controls__full">
        <div class="note note--info">
          <div class="note__body">
            <div class="note__title">This file</div>
            <div data-readout>Reading the channel layout…</div>
          </div>
        </div>
      </div>
    </div>
  </ToolShell>

  <Fragment slot="about">
    <h2>What a downmix actually does</h2>
    <p>
      Folding stereo to mono is addition. Every sample in the left channel is added to the
      matching sample in the right, and the result is halved so the overall level stays where
      it was. That sounds harmless, and most of the time it is, but addition has a failure
      mode. Wherever the two channels hold the same sound at opposite polarity, adding them
      produces silence.
    </p>
    <p>
      In practice this shows up as parts quietly disappearing. Wide synthesiser pads, anything
      that has been through a stereo widener, some reverb tails, and any effect that works by
      making left and right deliberately opposite all depend on that difference surviving.
      Collapse it and the part goes with it. Partial cancellation is more common than total:
      one microphone captured to two channels with a small timing offset between them will
      cancel at some frequencies and reinforce at others, which sounds hollow and
      comb-filtered rather than simply narrower. If a downmix sounds thin, that is why, and
      the fix is to keep one channel rather than average both. Which is what the split mode
      gives you.
    </p>

    <h2>When mono is the right answer</h2>
    <p>
      Speech, nearly always. A single voice recorded on one microphone has no stereo
      information to preserve, and storing it as two identical channels doubles the data for
      nothing at all. Most podcast platforms prefer mono for exactly that reason, and lossy
      encoders reward the choice: at a fixed bitrate, a mono file spends the entire budget on
      one channel and comes out audibly cleaner than the stereo version at the same setting.
    </p>
    <p>
      Mono is also the safer choice for anything destined for a single speaker, a phone, most
      Bluetooth speakers, a public address system, video that will autoplay in a feed. Those
      devices sum to mono themselves, without asking. Doing it deliberately in advance means
      you discover any cancellation while you can still do something about it, rather than
      after publishing.
    </p>

    <h2>Splitting is not separating</h2>
    <p>
      The split mode writes each channel out as its own file. That is genuinely useful when
      the two channels were never a stereo image in the first place: a two-person interview
      with one microphone per channel, a field recorder with a lavalier on the left input and
      a shotgun on the right, or a backing track with a guide vocal printed to one side. Each
      source becomes a file you can trim, level and clean up independently.
    </p>
    <p>
      It is not instrument separation. Left and right are the only division a stereo file
      contains; there is no drum channel or vocal channel hiding inside an ordinary music
      file, and no filter can invent one. The same limit applies in reverse. Duplicating a
      mono recording into two identical channels produces a file that is stereo in structure
      and mono in content. Which is exactly what some software and hardware demands, and
      nothing more than that.
    </p>
  </Fragment>
</ToolPage>

<style>
  .mono {
    padding: var(--s4);
    border-radius: var(--r-md);
    background: var(--stage-2, var(--surface));
    display: flex;
    flex-direction: column;
    gap: var(--s3);
  }

  .mono__canvas {
    width: 100%;
    height: 228px;
    display: block;
  }

  .mono__caption {
    margin: 0;
    font-size: var(--t-small);
    color: var(--stage-ink-2);
    max-width: var(--prose);
  }

  @media (max-width: 560px) {
    .mono__canvas {
      height: 204px;
    }
  }
</style>

<script>
  import { createTool } from '../lib/tool';
  import { setChannels, extractChannel } from '../lib/audio/dsp';
  import { baseName } from '../lib/format';
  import { fft } from '../lib/audio/fft';
  import { hannPeriodic } from '../lib/audio/stft';
  import type { NamedOutput } from '../lib/tool';
  import { panelColors, panelContext } from '../lib/canvas';

  type Mode = 'mono' | 'stereo' | 'split';

  let mode: Mode = 'mono';

  /** Octave band centres, the standard set, trimmed to what music occupies. */
  const BANDS = [63, 125, 250, 500, 1000, 2000, 4000, 8000, 16000];

  interface MonoReport {
    /** Phase correlation per block, −1 to 1, across the file. */
    correlation: Float32Array;
    /**
     * Share of each octave band's energy that lives in the side signal, 0..1.
     * Null where the band holds too little to give a meaningful ratio.
     */
    sideShare: (number | null)[];
    /** Overall correlation, energy-weighted across the file. */
    overall: number;
    /** Share of the whole file's energy that a downmix discards, 0..1. */
    lost: number;
  }

  const BLOCK_SECONDS = 0.05;
  const MAX_BLOCKS = 600;
  const FFT_SIZE = 4096;
  const FFT_FRAMES = 48;

  /**
   * What a downmix would do to this file, measured.
   *
   * Mid/side is the right frame for the question: L and R decompose exactly into
   * their sum and their difference, summing to mono keeps the first and discards
   * the second, so the side energy is not an estimate of the loss — it is the
   * loss. Correlation is reported alongside because it is the number people have
   * seen before, on the meter in every DAW.
   */
  function analyseMono(buffer: AudioBuffer): MonoReport {
    const left = buffer.getChannelData(0);
    const right = buffer.getChannelData(1);
    const rate = buffer.sampleRate;

    // --- Correlation over time. Bounded work: a long file is sampled, not walked.
    const blockSize = Math.max(1, Math.round(BLOCK_SECONDS * rate));
    const available = Math.max(1, Math.floor(buffer.length / blockSize));
    const blocks = Math.min(MAX_BLOCKS, available);
    const correlation = new Float32Array(blocks);
    let weighted = 0;
    let weight = 0;

    for (let b = 0; b < blocks; b += 1) {
      const start = Math.min(
        buffer.length - blockSize,
        Math.floor((b * (buffer.length - blockSize)) / Math.max(1, blocks - 1))
      );
      let sumLR = 0;
      let sumLL = 0;
      let sumRR = 0;
      for (let i = start; i < start + blockSize; i += 1) {
        const l = left[i]!;
        const r = right[i]!;
        sumLR += l * r;
        sumLL += l * l;
        sumRR += r * r;
      }
      const denominator = Math.sqrt(sumLL * sumRR);
      // A silent block has no phase relationship at all. Calling that 1 would
      // paint every gap between words as perfectly correlated, so it reads 0 and
      // carries no weight in the overall figure.
      const value = denominator > 1e-12 ? sumLR / denominator : 0;
      correlation[b] = value;
      const energy = sumLL + sumRR;
      weighted += value * energy;
      weight += energy;
    }

    // --- Where the difference lives, by band.
    const half = FFT_SIZE >> 1;
    const window = hannPeriodic(FFT_SIZE);
    const frame = new Float64Array(2 * FFT_SIZE);
    const spec = new Float64Array(2 * FFT_SIZE);
    const midEnergy = new Float64Array(half);
    const sideEnergy = new Float64Array(half);

    const usable = buffer.length - FFT_SIZE;
    const frames = usable < 0 ? 0 : Math.max(1, Math.min(FFT_FRAMES, Math.floor(buffer.length / FFT_SIZE)));

    for (let k = 0; k < frames; k += 1) {
      const start = frames === 1 ? 0 : Math.floor((usable * k) / (frames - 1));

      for (const which of ['mid', 'side'] as const) {
        for (let i = 0; i < FFT_SIZE; i += 1) {
          const l = left[start + i]!;
          const r = right[start + i]!;
          frame[2 * i] = (which === 'mid' ? (l + r) / 2 : (l - r) / 2) * window[i]!;
          frame[2 * i + 1] = 0;
        }
        fft(frame, spec, FFT_SIZE);
        const target = which === 'mid' ? midEnergy : sideEnergy;
        for (let bin = 0; bin < half; bin += 1) {
          const real = spec[2 * bin]!;
          const imag = spec[2 * bin + 1]!;
          target[bin] = target[bin]! + real * real + imag * imag;
        }
      }
    }

    const binHz = rate / FFT_SIZE;
    const bandEnergy = BANDS.map((centre) => {
      // One octave wide, which is how these bands are defined.
      const from = Math.max(1, Math.floor(centre / Math.SQRT2 / binHz));
      const to = Math.min(half - 1, Math.ceil((centre * Math.SQRT2) / binHz));
      let mid = 0;
      let side = 0;
      for (let bin = from; bin <= to; bin += 1) {
        mid += midEnergy[bin]!;
        side += sideEnergy[bin]!;
      }
      return { mid, side };
    });

    /*
      A band with nothing in it still has a ratio, and that ratio is noise.

      Left alone, a recording that stops at 8 kHz reports its empty top octaves as
      "half of this will be discarded", in the same alarming red as a real
      cancellation. Anything more than 40 dB below the loudest band is reported as
      no reading rather than as a number nobody should act on.
    */
    const loudestBand = Math.max(...bandEnergy.map((band) => band.mid + band.side));
    const sideShare = bandEnergy.map((band) => {
      const total = band.mid + band.side;
      if (total <= 0 || total < loudestBand / 10_000) return null;
      return band.side / total;
    });

    let totalMid = 0;
    let totalSide = 0;
    for (let bin = 1; bin < half; bin += 1) {
      totalMid += midEnergy[bin]!;
      totalSide += sideEnergy[bin]!;
    }

    return {
      correlation,
      sideShare,
      overall: weight > 0 ? weighted / weight : 0,
      lost: totalMid + totalSide > 0 ? totalSide / (totalMid + totalSide) : 0,
    };
  }

  function drawMono(
    panel: HTMLElement,
    canvas: HTMLCanvasElement,
    report: MonoReport
  ): void {
    const cssWidth = canvas.clientWidth;
    const cssHeight = canvas.clientHeight;
    if (cssWidth < 1 || cssHeight < 1) return;

    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const width = Math.round(cssWidth * dpr);
    const height = Math.round(cssHeight * dpr);
    if (canvas.width !== width || canvas.height !== height) {
      canvas.width = width;
      canvas.height = height;
    }

    const context = panelContext(canvas);
    if (!context) return;
    context.clearRect(0, 0, width, height);

    const { ink, hue, danger: raw } = panelColors(panel);
    const alarm = `color-mix(in oklch, ${raw} 62%, white)`;

    const padL = 40 * dpr;
    const padR = 12 * dpr;
    const plotW = width - padL - padR;

    context.font = `${10 * dpr}px system-ui, sans-serif`;
    context.textBaseline = 'middle';

    // ---- Correlation over time. ----
    const corrTop = 22 * dpr;
    const corrH = Math.round((height - corrTop - 34 * dpr) * 0.42);
    const zero = corrTop + corrH / 2;

    context.textAlign = 'left';
    context.fillStyle = `color-mix(in oklch, ${ink} 55%, transparent)`;
    context.fillText('Phase correlation over the file', padL, 10 * dpr);

    for (const value of [1, 0, -1]) {
      const y = zero - (value * corrH) / 2;
      context.strokeStyle = `color-mix(in oklch, ${ink} ${value === 0 ? 20 : 9}%, transparent)`;
      context.lineWidth = dpr;
      context.beginPath();
      context.moveTo(padL, y);
      context.lineTo(padL + plotW, y);
      context.stroke();
      context.fillStyle = `color-mix(in oklch, ${ink} 38%, transparent)`;
      context.textAlign = 'right';
      context.fillText(value > 0 ? '+1' : String(value), padL - 6 * dpr, y);
    }

    const columns = report.correlation.length;
    const columnW = plotW / Math.max(1, columns);
    for (let i = 0; i < columns; i += 1) {
      const value = report.correlation[i]!;
      const y = zero - (value * corrH) / 2;
      // Below zero the channels are working against each other, which is the one
      // state that actually removes audio. It gets its own colour.
      context.fillStyle =
        value < 0
          ? `color-mix(in oklch, ${alarm} 75%, transparent)`
          : `color-mix(in oklch, ${hue} 60%, transparent)`;
      context.fillRect(
        padL + i * columnW,
        Math.min(y, zero),
        Math.max(dpr, columnW),
        Math.max(dpr, Math.abs(zero - y))
      );
    }

    // ---- Where the difference lives. ----
    const barsTop = corrTop + corrH + 30 * dpr;
    const barsH = height - barsTop - 20 * dpr;
    if (barsH < 24 * dpr) return;

    context.textAlign = 'left';
    context.fillStyle = `color-mix(in oklch, ${ink} 55%, transparent)`;
    context.fillText('Share of each band that a downmix discards', padL, barsTop - 14 * dpr);

    const slot = plotW / BANDS.length;
    for (let i = 0; i < BANDS.length; i += 1) {
      const share = report.sideShare[i];
      const barW = slot * 0.62;
      const x = padL + i * slot + (slot - barW) / 2;

      context.fillStyle = `color-mix(in oklch, ${ink} 6%, transparent)`;
      context.fillRect(x, barsTop, barW, barsH);

      if (share === null || share === undefined) {
        // Nothing in this band, so no ratio worth drawing.
        context.textAlign = 'center';
        context.fillStyle = `color-mix(in oklch, ${ink} 22%, transparent)`;
        context.fillText('—', x + barW / 2, barsTop + barsH / 2);
      } else {
        const barH = Math.max(dpr, share * barsH);
        // Half the energy in the side signal is the point where a downmix stops
        // being a format change and starts being an edit.
        context.fillStyle =
          share > 0.5
            ? alarm
            : `color-mix(in oklch, ${hue} ${Math.round(45 + share * 90)}%, transparent)`;
        context.fillRect(x, barsTop + barsH - barH, barW, barH);
      }

      context.textAlign = 'center';
      context.fillStyle = `color-mix(in oklch, ${ink} 42%, transparent)`;
      const hz = BANDS[i]!;
      context.fillText(
        hz >= 1000 ? `${hz / 1000}k` : String(hz),
        x + barW / 2,
        height - 8 * dpr
      );
    }

    context.strokeStyle = `color-mix(in oklch, ${alarm} 45%, transparent)`;
    context.lineWidth = dpr;
    context.setLineDash([4 * dpr, 4 * dpr]);
    context.beginPath();
    context.moveTo(padL, barsTop + barsH / 2);
    context.lineTo(padL + plotW, barsTop + barsH / 2);
    context.stroke();
    context.setLineDash([]);

    context.textAlign = 'right';
    context.fillStyle = `color-mix(in oklch, ${ink} 38%, transparent)`;
    context.fillText('100%', padL - 6 * dpr, barsTop + 4 * dpr);
    context.fillText('50%', padL - 6 * dpr, barsTop + barsH / 2);
  }

  // No control values are read back inside process, so the runtime handle is
  // not needed here.
  createTool({
    suffix: 'mono',
    defaultFormat: 'mp3',

    agent: {
      name: 'set_channel_mode',
      description:
        'Choose the channel conversion: fold stereo down to mono, duplicate mono into a stereo pair, or split a stereo file into two separate single-channel files. Modes that do not fit the loaded file are disabled and the choice is ignored, so read channels from inspect_audio first: mono needs 2 or more channels, stereo needs exactly 1, split needs 2 or more. The downmix report and the preview update at once; nothing is saved.',
      params: [
        {
          key: 'mode',
          description:
            '"mono" folds every channel down to one; "stereo" writes a mono file into two identical channels; "split" exports the left and right channels as two files.',
          type: 'string',
          enum: ['mono', 'stereo', 'split'],
          apply: (value, runtime) =>
            runtime.root.querySelector<HTMLButtonElement>(`[data-mode="${value}"]`)?.click(),
        },
      ],
    },

    onReady(ctx, runtime) {
      const root = runtime.root;
      const channels = ctx.buffer.numberOfChannels;

      const readout = root.querySelector<HTMLElement>('[data-readout]');
      if (readout) {
        if (channels === 1) {
          readout.textContent =
            'This file is mono, one channel. It can be duplicated into a stereo pair, but ' +
            'that adds structure, not stereo information.';
        } else if (channels === 2) {
          readout.textContent =
            'This file is stereo, two channels. It can be folded down to mono, or split so ' +
            'that left and right become separate files.';
        } else {
          readout.textContent =
            `This file has ${channels} channels. Folding to mono averages all of them; ` +
            'splitting gives you the first two, which are front left and front right.';
        }
      }

      const monoPanel = root.querySelector<HTMLElement>('[data-mono-panel]');
      const monoCanvas = root.querySelector<HTMLCanvasElement>('[data-mono]');
      const monoCaption = root.querySelector<HTMLElement>('[data-mono-caption]');

      // Only worth measuring when there are two channels to compare. Reported for
      // every mode, because the cost of folding down is the thing that decides
      // between them.
      const report = channels >= 2 ? analyseMono(ctx.buffer) : null;

      const showReport = (): void => {
        if (!report || !monoPanel || !monoCanvas) return;
        monoPanel.hidden = false;
        drawMono(monoPanel, monoCanvas, report);

        if (!monoCaption) return;
        const percent = Math.round(report.lost * 100);
        const measured = report.sideShare.map((share) => share ?? -1);
        const worst = measured.indexOf(Math.max(...measured));
        const worstHz = BANDS[worst] ?? 1000;
        const worstLabel = worstHz >= 1000 ? `${worstHz / 1000} kHz` : `${worstHz} Hz`;

        const verdict =
          report.lost < 0.02
            ? 'The two channels are all but identical, so folding to mono changes nothing audible and halves the file.'
            : report.lost < 0.15
              ? `About ${percent}% of this file is difference between the channels. Folding down loses the width and little else.`
              : report.overall < 0
                ? `${percent}% of this file lives in the difference between the channels, and the correlation goes negative in places — those passages will partly cancel rather than merely narrow. The ${worstLabel} band is worst hit.`
                : `${percent}% of this file lives in the difference between the channels, most of it around ${worstLabel}. That part disappears in a downmix. Splitting keeps both, or keep one channel instead of averaging.`;

        monoCaption.textContent =
          mode === 'mono'
            ? verdict
            : `${verdict} Nothing is lost in this mode; the reading describes what folding down would cost.`;
      };

      const available: Record<Mode, boolean> = {
        mono: channels > 1,
        stereo: channels === 1,
        split: channels >= 2,
      };

      mode = channels === 1 ? 'stereo' : 'mono';

      const buttons = root.querySelectorAll<HTMLButtonElement>('[data-mode]');
      const select = (next: Mode): void => {
        mode = next;
        buttons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.mode === next));
        });
        showReport();
        runtime.refreshPreview();
      };

      buttons.forEach((button) => {
        const value = button.dataset.mode as Mode | undefined;
        const usable = value ? available[value] : false;

        button.disabled = !usable;
        button.setAttribute('aria-disabled', String(!usable));
        // .seg__btn sets its own colour, so :disabled alone would not read as
        // unavailable. Dim it directly rather than adding page-level CSS.
        button.style.opacity = usable ? '' : '0.4';
        button.style.cursor = usable ? '' : 'not-allowed';

        button.addEventListener('click', () => {
          if (!value || !available[value]) return;
          select(value);
        });
      });

      // The canvas has no width until the workspace is on screen.
      requestAnimationFrame(showReport);
      if (monoPanel && report) new ResizeObserver(showReport).observe(monoPanel);

      select(mode);
    },

    preview(ctx) {
      // Splitting produces two files, so there is nothing single to audition.
      if (mode === 'split') return ctx.buffer;
      return setChannels(ctx.buffer, mode === 'stereo' ? 2 : 1);
    },

    process(ctx) {
      const { buffer } = ctx;

      if (mode === 'split' && buffer.numberOfChannels >= 2) {
        // deliverMany appends the extension only when the name has no dot in
        // it, so a filename like "take.2.wav" would otherwise lose its suffix.
        const base = (baseName(ctx.files[0]?.name ?? 'audio') || 'audio').replace(/\./g, '-');
        const outputs: NamedOutput[] = [
          { name: `${base}-left`, buffer: extractChannel(buffer, 0) },
          { name: `${base}-right`, buffer: extractChannel(buffer, 1) },
        ];
        return outputs;
      }

      return mode === 'stereo'
        ? { buffer: setChannels(buffer, 2), suffix: 'stereo' }
        : { buffer: setChannels(buffer, 1), suffix: 'mono' };
    },
  });
</script>
