---
import ToolPage from '../layouts/ToolPage.astro';
import ToolShell from '../components/ToolShell.astro';
import { getTool } from '../data/tools';

const tool = getTool('stereo-to-mono');

const steps = [
  'Drop the file onto the page. The tool reads how many channels it really contains and switches off the conversions that would not make sense for it.',
  'Pick a direction: fold stereo down to mono, duplicate mono into a stereo pair, or split a stereo file into two separate single-channel files.',
  'Play it back before you commit. A downmix occasionally reveals phase cancellation that was completely inaudible in stereo, and the transport plays the converted version.',
  'Choose a format and download. Splitting produces two files, each listed underneath with its own download button.',
];

const faq = [
  {
    q: 'Does converting to mono halve the file size?',
    a: 'For uncompressed formats like WAV, yes, almost exactly — half the channels, half the samples. For MP3, AAC and Opus the saving is smaller, usually 30 to 45 percent, because those encoders already exploit the similarity between the two channels. The bigger win is quality: a mono file at a given bitrate spends the entire bitrate on one channel.',
  },
  {
    q: 'Can I lose anything by downmixing?',
    a: 'Yes. Mono is the sum of the channels, so any sound present in both at opposite polarity cancels out. Wide synth pads, some reverb tails and anything processed by a stereo widener can drop in level or vanish entirely. Play the downmix before downloading — that is the only reliable test.',
  },
  {
    q: 'Why would I want mono at all?',
    a: 'A single voice recorded on one microphone has no stereo information worth keeping, and most podcast platforms prefer mono for that reason. It is also the safer choice for anything played back on one speaker — phones, most Bluetooth speakers, public address systems — since those devices sum to mono anyway, and doing it yourself means you hear the result first.',
  },
  {
    q: 'Does converting mono to stereo give me actual stereo sound?',
    a: 'No. It writes the same audio into two channels, so the file is stereo in structure and mono in content. That satisfies software and hardware that refuses single-channel input, but nothing about the sound changes. If you want an actual stereo image from a mono source, the stereo widener cannot help either — there is no side information to widen.',
  },
  {
    q: 'When is splitting the channels useful?',
    a: 'When the two channels were never a stereo image to begin with: a two-person interview recorded with one microphone per channel, a field recorder with a lavalier on the left input and a shotgun on the right, or a backing track with a guide vocal printed to one side. Splitting gives you each source as its own file to edit separately.',
  },
  {
    q: 'Can this separate the vocals from the instrumental?',
    a: 'No. Left and right are the only division a stereo file contains — there is no vocal channel inside it. The old trick of subtracting one channel from the other removes anything panned dead centre, which usually takes the bass and kick with the vocal and leaves an unusable result. That is a different kind of tool entirely.',
  },
  {
    q: 'What happens with a file that has more than two channels?',
    a: 'Folding to mono averages every channel together. Splitting gives you the first two, which in standard channel ordering are the front left and front right. Surround files are rare in the formats these tools export to, so if you have one, converting it to stereo in a proper editor first will give you more control over the downmix.',
  },
];
---

<ToolPage slug={tool.slug} steps={steps} faq={faq}>
  <ToolShell tool={tool} results action="Download">
    <div class="controls">
      <div class="controls__head">
        <span class="controls__title">Channels</span>
        <span class="hint">Preview plays the converted version.</span>
      </div>

      <div class="field controls__full">
        <span class="label" id="sm-mode-label">Conversion</span>
        <div class="seg" role="group" aria-labelledby="sm-mode-label">
          <button type="button" class="seg__btn" data-mode="mono" aria-pressed="true">
            Stereo to mono
          </button>
          <button type="button" class="seg__btn" data-mode="stereo" aria-pressed="false">
            Mono to stereo
          </button>
          <button type="button" class="seg__btn" data-mode="split" aria-pressed="false">
            Split the channels
          </button>
        </div>
      </div>

      <div class="controls__full">
        <div class="note note--info">
          <div class="note__body">
            <div class="note__title">This file</div>
            <div data-readout>Reading the channel layout…</div>
          </div>
        </div>
      </div>
    </div>
  </ToolShell>

  <Fragment slot="about">
    <h2>What a downmix actually does</h2>
    <p>
      Folding stereo to mono is addition. Every sample in the left channel is added to the
      matching sample in the right, and the result is halved so the overall level stays where
      it was. That sounds harmless, and most of the time it is — but addition has a failure
      mode. Wherever the two channels hold the same sound at opposite polarity, adding them
      produces silence.
    </p>
    <p>
      In practice this shows up as parts quietly disappearing. Wide synthesiser pads, anything
      that has been through a stereo widener, some reverb tails, and any effect that works by
      making left and right deliberately opposite all depend on that difference surviving.
      Collapse it and the part goes with it. Partial cancellation is more common than total:
      one microphone captured to two channels with a small timing offset between them will
      cancel at some frequencies and reinforce at others, which sounds hollow and
      comb-filtered rather than simply narrower. If a downmix sounds thin, that is why, and
      the fix is to keep one channel rather than average both — which is what the split mode
      gives you.
    </p>

    <h2>When mono is the right answer</h2>
    <p>
      Speech, nearly always. A single voice recorded on one microphone has no stereo
      information to preserve, and storing it as two identical channels doubles the data for
      nothing at all. Most podcast platforms prefer mono for exactly that reason, and lossy
      encoders reward the choice: at a fixed bitrate, a mono file spends the entire budget on
      one channel and comes out audibly cleaner than the stereo version at the same setting.
    </p>
    <p>
      Mono is also the safer choice for anything destined for a single speaker — a phone, most
      Bluetooth speakers, a public address system, video that will autoplay in a feed. Those
      devices sum to mono themselves, without asking. Doing it deliberately in advance means
      you discover any cancellation while you can still do something about it, rather than
      after publishing.
    </p>

    <h2>Splitting is not separating</h2>
    <p>
      The split mode writes each channel out as its own file. That is genuinely useful when
      the two channels were never a stereo image in the first place: a two-person interview
      with one microphone per channel, a field recorder with a lavalier on the left input and
      a shotgun on the right, or a backing track with a guide vocal printed to one side. Each
      source becomes a file you can trim, level and clean up independently.
    </p>
    <p>
      It is not instrument separation. Left and right are the only division a stereo file
      contains; there is no drum channel or vocal channel hiding inside an ordinary music
      file, and no filter can invent one. The same limit applies in reverse. Duplicating a
      mono recording into two identical channels produces a file that is stereo in structure
      and mono in content — which is exactly what some software and hardware demands, and
      nothing more than that.
    </p>
  </Fragment>
</ToolPage>

<script>
  import { createTool } from '../lib/tool';
  import { setChannels, extractChannel } from '../lib/audio/dsp';
  import { baseName } from '../lib/format';
  import type { NamedOutput } from '../lib/tool';

  type Mode = 'mono' | 'stereo' | 'split';

  let mode: Mode = 'mono';

  // No control values are read back inside process, so the runtime handle is
  // not needed here.
  createTool({
    suffix: 'mono',
    defaultFormat: 'mp3',

    onReady(ctx, runtime) {
      const root = runtime.root;
      const channels = ctx.buffer.numberOfChannels;

      const readout = root.querySelector<HTMLElement>('[data-readout]');
      if (readout) {
        if (channels === 1) {
          readout.textContent =
            'This file is mono — one channel. It can be duplicated into a stereo pair, but ' +
            'that adds structure, not stereo information.';
        } else if (channels === 2) {
          readout.textContent =
            'This file is stereo — two channels. It can be folded down to mono, or split so ' +
            'that left and right become separate files.';
        } else {
          readout.textContent =
            `This file has ${channels} channels. Folding to mono averages all of them; ` +
            'splitting gives you the first two, which are front left and front right.';
        }
      }

      const available: Record<Mode, boolean> = {
        mono: channels > 1,
        stereo: channels === 1,
        split: channels >= 2,
      };

      mode = channels === 1 ? 'stereo' : 'mono';

      const buttons = root.querySelectorAll<HTMLButtonElement>('[data-mode]');
      const select = (next: Mode): void => {
        mode = next;
        buttons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.mode === next));
        });
        runtime.refreshPreview();
      };

      buttons.forEach((button) => {
        const value = button.dataset.mode as Mode | undefined;
        const usable = value ? available[value] : false;

        button.disabled = !usable;
        button.setAttribute('aria-disabled', String(!usable));
        // .seg__btn sets its own colour, so :disabled alone would not read as
        // unavailable. Dim it directly rather than adding page-level CSS.
        button.style.opacity = usable ? '' : '0.4';
        button.style.cursor = usable ? '' : 'not-allowed';

        button.addEventListener('click', () => {
          if (!value || !available[value]) return;
          select(value);
        });
      });

      select(mode);
    },

    preview(ctx) {
      // Splitting produces two files, so there is nothing single to audition.
      if (mode === 'split') return ctx.buffer;
      return setChannels(ctx.buffer, mode === 'stereo' ? 2 : 1);
    },

    process(ctx) {
      const { buffer } = ctx;

      if (mode === 'split' && buffer.numberOfChannels >= 2) {
        // deliverMany appends the extension only when the name has no dot in
        // it, so a filename like "take.2.wav" would otherwise lose its suffix.
        const base = (baseName(ctx.files[0]?.name ?? 'audio') || 'audio').replace(/\./g, '-');
        const outputs: NamedOutput[] = [
          { name: `${base}-left`, buffer: extractChannel(buffer, 0) },
          { name: `${base}-right`, buffer: extractChannel(buffer, 1) },
        ];
        return outputs;
      }

      return mode === 'stereo'
        ? { buffer: setChannels(buffer, 2), suffix: 'stereo' }
        : { buffer: setChannels(buffer, 1), suffix: 'mono' };
    },
  });
</script>
