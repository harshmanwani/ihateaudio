---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../consts';
import { CATEGORIES, TOOLS, toolsIn } from '../data/tools';

const homeFaq = [
  {
    q: 'Is this actually free, or is there a catch?',
    a: "Actually free. No trial that runs out, no \u201cpro\u201d tier hiding the good stuff, no watermark on your file, no daily limit, no account. You will not be asked for an email. There is genuinely nothing to upgrade to.",
  },
  {
    q: 'Does my file get uploaded somewhere?',
    a: 'Nope. Your browser reads the file straight off your device and does all the work there. You do not have to trust us on this either: open your network tab while you edit, or flip on airplane mode after the page loads. Everything keeps working, because there was never anything on the other end.',
  },
  {
    q: 'How big a file can I throw at it?',
    a: 'There is no limit we set, because there is no upload to cap. The real ceiling is your own device: roughly 40 minutes of audio at once on a phone, a few hours on a laptop. If your file is too big, the tool says so up front instead of dying halfway through.',
  },
  {
    q: 'Which formats work?',
    a: 'MP3, WAV, M4A, AAC, OGG, Opus, FLAC and WebM all open straight away. WMA, AIFF and other oddballs go through the converter, which grabs a fuller decoder the first time you need it. Video files work too if you just want the audio out of them.',
  },
  {
    q: 'Can I use this on my phone?',
    a: 'Yes, and it is built for it. Every control is thumb-sized, the waveform takes touch drags properly, and the ringtone makers assume you are on the phone you want the ringtone on. It also installs to your home screen if you want it there.',
  },
  {
    q: 'Does it work offline?',
    a: 'Once you have loaded a page, yes. Take it on a plane, use it on hotel wifi that barely works, whatever. The one exception is the format converter, which needs a single download the first time you ask for something unusual.',
  },
  {
    q: 'Why should I believe the no-upload thing?',
    a: 'Because you can check it in about thirty seconds and you do not need to take our word for anything. Open your browser tools, watch the network, and edit a file. Nothing leaves. Then pull your wifi and keep editing. No site that uploads your audio can do that.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Free browser audio tools',
    numberOfItems: TOOLS.length,
    itemListElement: TOOLS.map((tool, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: tool.name,
      url: new URL(`/${tool.slug}`, SITE.url).href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<Base
  title="ihateaudio: Free Audio Tools That Run in Your Browser"
  description={SITE.description}
  path="/"
  schema={schema}
>
  <div class="wrap">
    <section class="hero">
      <div>
        <h1>Audio editing is miserable. We make it less so.</h1>
        <p class="hero__sub">
          {TOOLS.length} tools that run right here in your browser. Drop a file
          in, get it back fixed. No uploads, no signup, no nonsense.
        </p>
      </div>
      <div class="toolsearch">
        <Icon name="magnifying-glass" size={18} />
        <input
          class="input"
          type="search"
          id="tool-search"
          placeholder={`Search ${TOOLS.length} tools…`}
          aria-label="Search tools"
          autocomplete="off"
        />
      </div>
    </section>

    <div class="filters" role="group" aria-label="Filter tools by category">
      <button type="button" class="pill" data-filter="all" aria-pressed="true">
        All
      </button>
      {
        CATEGORIES.map((category) => (
          <button
            type="button"
            class:list={['pill', category.id === 'ai' && 'pill--ai']}
            data-filter={category.id}
            data-cat={category.id}
            aria-pressed="false"
          >
            {
              /* The AI family gets a moving wave rather than a static dot. It is
                 the one group here that does something categorically different
                 from the rest, and five bars that actually move say that faster
                 than any label. Every other family keeps the quiet dot, which is
                 what stops this reading as decoration. */
              category.id === 'ai' ? (
                <span class="pill__wave" aria-hidden="true">
                  <i /><i /><i /><i /><i />
                </span>
              ) : (
                <span class="pill__dot" aria-hidden="true" />
              )
            }
            {category.name}
          </button>
        ))
      }
    </div>

    <p class="searchempty" data-search-empty hidden>
      Nothing there. Try “trim”, “mp4 to mp3”, “louder” or “ringtone”.
    </p>

    {
      CATEGORIES.map((category) => (
        <section class="cat" data-category={category.id}>
          <div class="cat__head">
            <h2>{category.name}</h2>
            <span class="cat__count">{toolsIn(category.id).length} tools</span>
          </div>
          <p class="cat__desc">{category.blurb}</p>
          <div class="grid">
            {toolsIn(category.id).map((tool) => (
              <a
                class="tile"
                href={`/${tool.slug}`}
                data-tile
                data-cat={tool.category}
                data-search={`${tool.name} ${tool.short} ${tool.slug.replace(/-/g, ' ')} ${tool.keywords.join(' ')}`.toLowerCase()}
              >
                <span
                  class:list={['tile__chip', tool.icon3d && 'tile__chip--art']}
                  aria-hidden="true"
                >
                  {
                    tool.icon3d ? (
                      <img
                        src={`/icons3d/${tool.slug}.png`}
                        alt=""
                        width="56"
                        height="56"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <Icon name={tool.icon} weight="duotone" size={24} />
                    )
                  }
                </span>
                <span class="tile__text">
                  <span class="tile__name">{tool.name}</span>
                  <span class="tile__desc">{tool.short}</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <!-- The tone change: launcher above, trust below. -->
  <section class="trust" aria-labelledby="trust-heading">
    <div class="wrap">
      <h2 id="trust-heading">
        Your audio never leaves your laptop.
      </h2>
      <p class="trust__lede">
        Every tool here works inside your browser, on your own device. You do
        not have to take that on faith. It takes about thirty seconds to check,
        and we would rather you did.
      </p>

      <div class="trust__steps">
        <div class="trust__step">
          <div class="trust__glyph">
            <Icon name="upload-simple" weight="duotone" size={24} />
          </div>
          <h3>Drop your file in</h3>
          <p>
            It gets read straight off your disk. Nothing to transfer, no queue
            to wait in, no size cap. A two hour recording opens about as fast as
            your laptop can read it.
          </p>
        </div>
        <div class="trust__step">
          <div class="trust__glyph">
            <Icon name="sliders-horizontal" weight="duotone" size={24} />
          </div>
          <h3>Do the thing</h3>
          <p>
            Your browser has had a proper audio engine inside it for years, the
            same one running web games and video calls. We just gave it a
            decent set of buttons. Your device does the work, so nothing is
            waiting on a server somewhere.
          </p>
        </div>
        <div class="trust__step">
          <div class="trust__glyph">
            <Icon name="download-simple" weight="duotone" size={24} />
          </div>
          <h3>Take it and go</h3>
          <p>
            The finished file is written by the same page and lands in your
            downloads. Close the tab and every trace of your audio is gone with
            it. That is the whole lifecycle.
          </p>
        </div>
      </div>

      <div class="trust__facts">
        <div class="trust__fact">
          <strong>Zero uploads, checkable</strong>
          <span>
            Watch your network tab while you work. Not one request carries your
            file anywhere.
          </span>
        </div>
        <div class="trust__fact">
          <strong>Fine on airplane wifi</strong>
          <span>
            Load a tool, go offline, keep working. No upload site on earth can
            pull that off.
          </span>
        </div>
        <div class="trust__fact">
          <strong>Nothing to sign into</strong>
          <span>
            No accounts exist here at all, so there is no password, profile or
            mailing list to end up somewhere it should not.
          </span>
        </div>
        <div class="trust__fact">
          <strong>Built like someone cared</strong>
          <span>
            We spent an unreasonable number of hours on things like waveform
            accuracy so you would never have to think about them.{' '}
            <a href="/about">What went into it</a>{' '}and{' '}
            <a href="/privacy">what we do with your data</a>.
          </span>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap homefaq">
    <h2>Common questions</h2>
    <div class="faq">
      {
        homeFaq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <div>{item.a}</div>
          </details>
        ))
      }
    </div>
  </div>
</Base>

<script>
  const search = document.querySelector<HTMLInputElement>('#tool-search');
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('[data-tile]'));
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>('[data-category]')
  );
  const pills = Array.from(document.querySelectorAll<HTMLElement>('[data-filter]'));
  const empty = document.querySelector<HTMLElement>('[data-search-empty]');

  let activeCategory = 'all';

  // Token match: every word the user typed must appear somewhere in the
  // tile's haystack (name, description, slug, synonyms). This is what makes
  // "mp4 to mp3" or "remove background noise" land on the right tool.
  const matches = (haystack: string, query: string): boolean => {
    if (query === '') return true;
    return query
      .split(/\s+/)
      .filter(Boolean)
      .every((word) => haystack.includes(word));
  };

  const apply = (): void => {
    const query = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;

    for (const tile of tiles) {
      const inCategory =
        activeCategory === 'all' || tile.dataset.cat === activeCategory;
      const hit = inCategory && matches(tile.dataset.search ?? '', query);
      tile.hidden = !hit;
      if (hit) visible += 1;
    }

    for (const section of sections) {
      const any = section.querySelectorAll('[data-tile]:not([hidden])').length;
      section.hidden = any === 0;
    }

    if (empty) empty.hidden = visible > 0;
  };

  search?.addEventListener('input', apply);

  for (const pill of pills) {
    pill.addEventListener('click', () => {
      activeCategory = pill.dataset.filter ?? 'all';
      for (const other of pills) {
        other.setAttribute('aria-pressed', String(other === pill));
      }
      apply();
    });
  }
</script>
